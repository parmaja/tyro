--======================================================================
--  bounce_demo.tyro - a ball moving inside the window
--======================================================================
--  Demonstrates the engine-driven frame callbacks: the script returns, then
--  the engine calls update(dt) once and draw() once per drawing frame.
--======================================================================

window.show(640, 480)

x = 50
y = 100
dx = 3
dy = 2
r = 12

function update(dt)
  -- move the ball
  x = x + dx
  y = y + dy
  if x < r or x > canvas.width - r then dx = -dx end
  if y < r or y > canvas.height - r then dy = -dy end
end

function draw()
  -- clear the previous frame
  canvas.color = colors.black
  canvas.rectangle(0, 0, canvas.width, canvas.height, true)

  -- title
  canvas.color = colors.white
  canvas.text(10, 10, "Bounce Demo - ball moves every frame")

  -- draw it
  canvas.color = colors.white
  canvas.circle(x, y, r, true)
end