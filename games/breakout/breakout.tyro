--======================================================================
--  NEON BREAKER - Classic brick-busting arcade action for Tyro
--======================================================================
--  Bounce the plasma ball off your energy paddle and shatter every
--  neon brick above. Top rows are worth more points - keep the ball
--  alive, clear the board and face it again a little faster!
--
--  Features:
--  * Pixel-art brick/paddle/ball sprites (make_assets.py)
--  * Angle control: where the ball hits the paddle decides the bounce
--  * Speed ramps up with every cleared board, hi-score saving
--  * Mouse, keyboard and gamepad paddle control
--  * Juice: brick debris bursts, ball trail, combo call-outs, shake
--  * Two-voice MML chiptune loop with jingles (Sweep/Chime/Explode Zaps)
--
--  Controls:
--    MOUSE              Move the paddle
--    LEFT / RIGHT (A/D) Move the paddle
--    SPACE / UP / CLICK Launch the ball, start the game
--    P                  Pause / Resume
--    M                  Mute / Unmute audio
--    ESC                Exit to desktop
--    Gamepad: Left-Stick/D-Pad to steer, A to launch or start
--======================================================================

local D = require("breakout_data")

window.show(D.W, D.H)
local W, H = canvas.width, canvas.height

local WALL = D.WALL               -- side rail thickness for the ball bounds
local TOP = D.TOP                 -- the ball bounces under the HUD bar
local MAX_DT = 0.05               -- physics never jumps over a frame hiccup

-- -----------------------------------------------------------------------------
-- Audio helpers
-- -----------------------------------------------------------------------------
local muted = false

for _, f in ipairs({ "sfx/bounce.wav", "sfx/brick.wav", "sfx/break.wav" }) do
  pcall(function() sound.load(f) end)
end

local function sfx(wave, freq, ms)
  if muted then return end
  pcall(function() music.sound(wave, freq, ms) end)
end

local function play_wav(file, vol)
  if muted then return end
  pcall(function() sound.play(file, vol or 0.85) end)
end

-- Chiptune theme: music.mml has no stop, so the loop is re-armed by timer
-- only while the game is playing (same pattern as neonrunner).
local function play_theme()
  music_timer = D.MUSIC_LOOP
  if muted then return end
  pcall(function() music.mml(D.MML_LEAD, D.MML_BASS) end)
end

-- -----------------------------------------------------------------------------
-- Sprites
-- -----------------------------------------------------------------------------
local paddle_sp = Sprites.new("brk_paddle")
paddle_sp.load("img/paddle.png")
paddle_sp.layer = 30

local ball_sp = Sprites.new("brk_ball")
ball_sp.load("img/ball.png")
ball_sp.layer = 31

-- Brick wall: one tilemap is one cheap draw command per frame, so the whole
-- 84-brick board appears instantly (per-sprite loads cost a queue round trip).
local wall = tiles.new("brkwall")
wall.load("img/bricks.png", D.BRICK_W + D.BRICK_GAP, D.BRICK_H + D.BRICK_GAP)
local WALL_X = D.GRID_LEFT - 1
local WALL_Y = D.GRID_TOP - 1

-- -----------------------------------------------------------------------------
-- Game state
-- -----------------------------------------------------------------------------
local state = "attract"           -- attract | playing | paused | dead | gameover | clear
local score = 0
local lives = D.START_LIVES
local level = 1
local hi_score = D.load_high_score()

local paddle = { cx = W / 2, w = D.PADDLE_W }
local ball = { x = W / 2, y = H / 2, vx = 0, vy = 0, speed = D.BALL_SPEED, stuck = true }
local bricks = {}
local bricks_left = 0
local state_timer = 0

-- Juice: particles, ball trail, floating texts, rally combo and the music loop
local particles = {}
local trail = {}
local floats = {}
local combo = 0
local music_timer = 0
local best_beat = false
local MAX_PARTICLES = 180

-- Canvas colours matching the six brick rows (frame order of bricks.png)
local BRICK_COLORS = {
  colors.red, colors.orange, colors.yellow,
  colors.lime, colors.aqua, colors.purple,
}

-- Attract-mode decorations: a slow star field behind the playfield
local stars = {}
math.randomseed(20261103)
for i = 1, 70 do
  stars[i] = {
    x = math.random(0, W - 1),
    y = math.random(D.HUD_H, H - 1),
    r = math.random(1, 2),
    tw = math.random() * 6.283,
  }
end

-- -----------------------------------------------------------------------------
-- Juice effects: debris bursts, floating texts, ball trail
-- -----------------------------------------------------------------------------
local function burst(x, y, col, count, speed)
  for _ = 1, count do
    if #particles >= MAX_PARTICLES then return end
    local ang = math.rad(math.random(0, 359))
    local sp = speed * (0.35 + math.random() * 0.65)
    particles[#particles + 1] = {
      x = x, y = y,
      vx = math.cos(ang) * sp,
      vy = math.sin(ang) * sp - 50,
      size = math.random(2, 4),
      col = col,
      life = 0.45 + math.random() * 0.35,
      t = 0,
    }
  end
end

local function add_float(x, y, text, col)
  if #floats >= 12 then table.remove(floats, 1) end
  floats[#floats + 1] = { x = x, y = y, text = text, col = col, t = 0 }
end

local function update_fx(dt)
  for i = #particles, 1, -1 do
    local p = particles[i]
    p.t = p.t + dt
    if p.t >= p.life then
      table.remove(particles, i)
    else
      p.x = p.x + p.vx * dt
      p.y = p.y + p.vy * dt
      p.vy = p.vy + 520 * dt
    end
  end
  for i = #floats, 1, -1 do
    local f = floats[i]
    f.t = f.t + dt
    if f.t >= 1.0 then
      table.remove(floats, i)
    else
      f.y = f.y - 42 * dt
    end
  end
  for i = #trail, 1, -1 do
    trail[i].t = trail[i].t + dt
    if trail[i].t > 0.28 then table.remove(trail, i) end
  end
end

local function draw_fx()
  -- Ball trail: fading afterglow circles under the sprite
  canvas.color = colors.aqua
  for _, p in ipairs(trail) do
    local k = 1 - p.t / 0.28
    canvas.alpha = math.floor(k * 110)
    canvas.circle(p.x, p.y, 2 + 5 * k, true)
  end
  -- Brick debris
  for _, p in ipairs(particles) do
    canvas.alpha = math.floor((1 - p.t / p.life) * 230)
    canvas.color = p.col
    canvas.rectangle(p.x, p.y, p.size, p.size, true)
  end
  canvas.alpha = 255
  -- Floating texts
  for _, f in ipairs(floats) do
    canvas.alpha = math.floor((1 - f.t) * 255)
    canvas.color = f.col
    canvas.text(f.x - 14, f.y, f.text)
  end
  canvas.alpha = 255
end

-- -----------------------------------------------------------------------------
-- Level helpers
-- -----------------------------------------------------------------------------
local function rebuild_bricks()
  bricks = D.build_level(level)
  bricks_left = #bricks
  local rows = 0
  for _, b in ipairs(bricks) do
    if b.row + 1 > rows then rows = b.row + 1 end
  end
  wall.resize(D.COLS, rows)
  wall.fill(0)
  for _, b in ipairs(bricks) do
    wall.set(b.col, b.row, b.frame + 1)
  end
end

local function respawn_ball()
  ball.stuck = true
  ball.vx, ball.vy = 0, 0
  ball.x = paddle.cx
  ball.y = D.PADDLE_Y - D.BALL_R - 2
  trail = {}
  combo = 0
  ball_sp.show()
end

-- Sprites draw over the canvas, so the pause / game-over screens hide the field
local function set_field_visible(on)
  paddle_sp.visible = on
  ball_sp.visible = on
  wall.visible = on
end

local function start_game()
  set_field_visible(true)
  score = 0
  lives = D.START_LIVES
  level = 1
  ball.speed = D.BALL_SPEED
  best_beat = false
  particles = {}
  floats = {}
  rebuild_bricks()
  respawn_ball()
  state = "playing"
  sfx("Sweep", 300, 260)
  play_theme()
end

rebuild_bricks()

-- Attract demo: the ball already ricochets around the board behind the title
ball.stuck = false
ball.vx = D.BALL_SPEED * 0.6
ball.vy = -D.BALL_SPEED * 0.8

-- -----------------------------------------------------------------------------
-- Paddle input
-- -----------------------------------------------------------------------------
local mouse_follow = true
local last_mouse_x = -1

local function paddle_axis()
  local ax = 0
  if keyboard.down("left") or keyboard.down("a") then ax = ax - 1 end
  if keyboard.down("right") or keyboard.down("d") then ax = ax + 1 end
  if gamepad.available() then
    local gx = gamepad.axis("leftx")
    if math.abs(gx) > 0.25 then ax = ax + gx end
    if gamepad.down("dpad_left") then ax = ax - 1 end
    if gamepad.down("dpad_right") then ax = ax + 1 end
  end
  return D.clamp(ax, -1, 1)
end

local function launch_pressed()
  return keyboard.pressed("space") or keyboard.pressed("up") or keyboard.pressed("w")
      or mouse.pressed("left")
      or (gamepad.available() and (gamepad.pressed("a") or gamepad.pressed("start")))
end

local function update_paddle(dt)
  if mouse.x ~= last_mouse_x then
    last_mouse_x = mouse.x
    mouse_follow = true
  end
  local ax = paddle_axis()
  if ax ~= 0 then
    mouse_follow = false
    paddle.cx = paddle.cx + ax * D.PADDLE_SPEED * dt
  elseif mouse_follow then
    paddle.cx = mouse.x
  end
  local half = paddle.w / 2
  paddle.cx = D.clamp(paddle.cx, WALL + half, W - WALL - half)
  -- sprite x/y is the sprite CENTER (engine draw model), not the top-left
  paddle_sp.x = paddle.cx
  paddle_sp.y = D.PADDLE_Y + D.PADDLE_H / 2
end

-- -----------------------------------------------------------------------------
-- Ball physics
-- -----------------------------------------------------------------------------
local function lose_ball()
  lives = lives - 1
  burst(ball.x, ball.y, colors.white, 18, 240)
  burst(ball.x, ball.y, colors.orange, 10, 160)
  trail = {}
  play_wav("sfx/break.wav", 1.0)
  sfx("Explode", 200, 500)
  shake(500, 14)
  ball_sp.hide()
  if lives <= 0 then
    hi_score = D.save_high_score(score)
    state = "gameover"
    set_field_visible(false)
    pcall(function() music.mml("t110 l8 o4 g e c <c2") end)
  else
    state = "dead"
    state_timer = D.RESPAWN_DELAY
  end
end

-- One substep via the tested pure physics in breakout_data; only the
-- game-side reactions (sounds, wall tile, score, state) live here.
local function step_ball(sdt)
  local ev, b, broke = D.ball_step(ball, paddle, bricks, sdt, state == "attract")
  if ev == "lose" then
    lose_ball()
  elseif ev == "wall" then
    sfx("Tri", 190, 35)
  elseif ev == "top" then
    sfx("Tri", 230, 35)
  elseif ev == "floor" then
    sfx("Tri", 170, 35)
  elseif ev == "paddle" then
    play_wav("sfx/bounce.wav", 0.9)
    burst(ball.x, D.PADDLE_Y, colors.aqua, 5, 130)
    combo = 0 -- new rally
  elseif ev == "paddle_side" then
    play_wav("sfx/bounce.wav", 0.7)
    burst(ball.x, ball.y, colors.silver, 3, 110)
  elseif ev == "brick" then
    if broke then
      wall.set(b.col, b.row, 0)
      bricks_left = bricks_left - 1
      burst(b.x + b.w / 2, b.y + b.h / 2, BRICK_COLORS[b.frame + 1], 12, 190)
      if state == "playing" then
        combo = combo + 1
        score = score + b.score
        if not best_beat and score > hi_score then
          best_beat = true
          add_float(W / 2 - 44, H / 2 - 100, "NEW BEST!", colors.gold)
          sfx("Chime", 1320, 420)
        end
      end
      play_wav("sfx/break.wav", 0.8)
      sfx("Zap", 220 + (6 - b.frame) * 90 + (combo - 1) * 45, 60)
      if combo >= 4 and combo % 4 == 0 then
        shake(90, 5)
        add_float(ball.x - 22, ball.y - 26, "x" .. combo .. " COMBO", colors.gold)
      end
      if bricks_left <= 0 then
        if state == "attract" then
          rebuild_bricks() -- demo ball keeps bouncing on a fresh wall
        else
          ball.speed = math.min(D.BALL_MAX_SPEED, ball.speed * D.BALL_SPEED_STEP)
          hi_score = D.save_high_score(score)
          state = "clear"
          state_timer = D.CLEAR_DELAY
          ball_sp.hide()
          sfx("Chime", 880, 400)
          pcall(function() music.mml("t150 l16 o5 c e g > c2") end)
        end
      end
    else
      play_wav("sfx/brick.wav", 0.9)
    end
  end
end

local function update_ball(dt)
  if ball.stuck then
    ball.x = paddle.cx
    ball.y = D.PADDLE_Y - D.BALL_R - 2
    if launch_pressed() then
      local ang = math.rad(math.random(-20, 20))
      ball.vx = ball.speed * math.sin(ang)
      ball.vy = -ball.speed * math.cos(ang)
      ball.stuck = false
      sfx("Sweep", 420, 160)
    end
  else
    trail[#trail + 1] = { x = ball.x, y = ball.y, t = 0 }
    if #trail > 14 then table.remove(trail, 1) end
    local steps = D.clamp(math.ceil(ball.speed * dt / (D.BALL_R * 0.8)), 1, 8)
    local sdt = dt / steps
    for s = 1, steps do
      if state == "playing" or state == "attract" then
        ball.vx, ball.vy = D.fix_slope(ball.vx, ball.vy, ball.speed)
        step_ball(sdt)
      else
        break
      end
    end
  end
  -- the ball.png art is centred, so the sprite centre is the collision point
  ball_sp.x = ball.x
  ball_sp.y = ball.y
end

-- -----------------------------------------------------------------------------
-- Frame callbacks
-- -----------------------------------------------------------------------------
function update(dt)
  if dt > MAX_DT then dt = MAX_DT end   -- physics never skips on a hiccup frame
  if keyboard.pressed("escape") then exit() end
  if keyboard.pressed("m") then muted = not muted end

  update_fx(dt)
  if (state == "playing" or state == "clear" or state == "dead") then
    if muted then music_timer = D.MUSIC_LOOP
    else
      music_timer = music_timer - dt
      if music_timer <= 0 then play_theme() end
    end
  end

  if state == "playing" or state == "attract" then
    if keyboard.pressed("p") and state == "playing" then
      state = "paused"
      set_field_visible(false)
      return
    end

    update_paddle(dt)
    update_ball(dt)

    if state == "attract" and launch_pressed() then
      start_game()
    elseif state == "playing" then
      if ball.stuck then ball_sp.show() end
    end

  elseif state == "paused" then
    if keyboard.pressed("p") then
      state = "playing"
      set_field_visible(true)
    end

  elseif state == "dead" then
    update_paddle(dt)
    state_timer = state_timer - dt
    if state_timer <= 0 then
      respawn_ball()
      state = "playing"
    end

  elseif state == "clear" then
    update_paddle(dt)
    state_timer = state_timer - dt
    if state_timer <= 0 then
      level = level + 1
      rebuild_bricks()
      respawn_ball()
      state = "playing"
    end

  elseif state == "gameover" then
    if launch_pressed() then
      start_game()
    end
  end
end

-- -----------------------------------------------------------------------------
-- Drawing helpers
-- -----------------------------------------------------------------------------
local function text_center(y, s, col)
  local tw = textwidth(s)
  local x = math.floor((W - tw) / 2)
  canvas.color = colors.black
  canvas.text(x + 2, y + 2, s)   -- drop shadow
  canvas.color = col
  canvas.text(x, y, s)
end

local function draw_hud()
  canvas.color = colors.black
  canvas.rectangle(0, 0, W, D.HUD_H, true)
  canvas.color = colors.aqua
  canvas.text(10, 12, string.format("SCORE %06d", score))
  canvas.color = colors.silver
  canvas.text(math.floor(W / 2) - 60, 12, string.format("BEST %06d", math.max(hi_score, score)))
  canvas.color = colors.yellow
  canvas.text(W - 150, 12, "LEVEL " .. level)
  -- Balls left as little glowing dots
  for i = 1, lives - 1 do
    canvas.color = colors.aqua
    canvas.circle(W - 26 - i * 20, 20, 6, true)
  end
end

local function draw_field()
  -- Side rails and ceiling glow lines
  canvas.color = colors.darkblue
  canvas.rectangle(0, D.HUD_H, WALL, H - D.HUD_H, true)
  canvas.rectangle(W - WALL, D.HUD_H, WALL, H - D.HUD_H, true)
  canvas.color = colors.aqua
  canvas.line(0, TOP - 1, W, TOP - 1, 1)
  -- The brick wall (one tilemap pass; snapshot taken right here)
  wall.draw(WALL_X, WALL_Y)
end

local function draw_stars(t)
  for _, s in ipairs(stars) do
    local glow = 0.5 + 0.5 * math.sin(t * 2 + s.tw)
    canvas.color = colors.gray
    canvas.rectangle(s.x, s.y, s.r, s.r, true)
    if glow > 0.75 then
      canvas.color = colors.silver
      canvas.point(s.x, s.y)
    end
  end
end

function draw()
  local t = time()

  -- Deep space backdrop
  canvas.color = colors.black
  canvas.rectangle(0, 0, W, H, true)
  pcall(canvas.gradient.rectV, 0, 0, W, H, colors.black, colors.darkblue)
  draw_stars(t)

  draw_field()
  draw_fx()

  if state == "attract" then
    text_center(250, "N E O N   B R E A K E R", colors.aqua)
    text_center(288, "Smash every neon brick!", colors.silver)
    if math.floor(t * 2) % 2 == 0 then
      text_center(350, "PRESS SPACE OR CLICK TO PLAY", colors.yellow)
    end
    text_center(420, "MOUSE / KEYS / GAMEPAD - paddle   SPACE - launch", colors.gray)
    text_center(448, "P - pause    M - mute    ESC - exit", colors.gray)
    text_center(505, "BEST " .. math.max(hi_score, score), colors.lime)
  end

  if state == "dead" then
    text_center(H / 2 - 60, "BALL LOST!", colors.red)
    text_center(H / 2 - 20, "Balls left: " .. lives, colors.silver)
  elseif state == "clear" then
    text_center(H / 2 - 60, "BOARD CLEAR!", colors.lime)
    text_center(H / 2 - 20, "GET READY - LEVEL " .. (level + 1), colors.yellow)
  elseif state == "paused" then
    canvas.color = colors.black
    canvas.rectangle(0, 0, W, H, true)
    text_center(H / 2 - 20, "P A U S E D", colors.yellow)
  elseif state == "gameover" then
    canvas.color = colors.black
    canvas.rectangle(0, 0, W, H, true)
    text_center(180, "G A M E   O V E R", colors.red)
    text_center(250, "SCORE " .. score, colors.silver)
    text_center(290, "BEST  " .. hi_score, colors.gold)
    if math.floor(t * 2) % 2 == 0 then
      text_center(380, "PRESS SPACE TO PLAY AGAIN", colors.yellow)
    end
  end

  draw_hud()
end
