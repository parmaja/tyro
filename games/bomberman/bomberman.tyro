--======================================================================
--  BOMBER-MAN - Classic Grid Blast 'Em Up for Tyro Game Engine
--======================================================================
--  A polished, kid-friendly homage to the 1985 Hudson Soft classic.
--  Drop bombs, blast the wooden crates, grab the hidden power-ups and
--  clear every level before the balloon monsters get you!
--
--  Features:
--  * Animated multi-frame .sprite atlases (Bomber, Balom, Bomb, Flames,
--    Power-ups, Door) generated by make_assets.py
--  * Native tilemap board (grass / stone / crates) at smooth scale
--  * Classic grid bombs with fuse pulse, chain reactions, cross flames
--  * Hidden power-ups under crates: FLAME, BOMB, SPEED, SHIELD, points
--  * Corner auto-align movement, spawn protection, screen shake,
--    floating combat text, high score persistence, level progression
--
--  Controls:
--    ARROWS / WASD   Move the bomber
--    SPACE           Place a bomb
--    M               Mute / Unmute sound
--    R               Restart level run
--    ESC             Back to title / Quit
--======================================================================

local D = require("bomberman_data")

window.show(960, 540)
local W, H = canvas.width, canvas.height

-- Board is fixed (no camera): 15x13 grid of 32px cells drawn at 1.25 scale
local SCALE = 1.25
local OX, OY = 30, 10                       -- board origin on screen
local HUD_X = OX + D.COLS * D.TILE * SCALE + 20

-- Sound manager with mute toggle and safe fallback to TyroSounds wavetables
local muted = false
local function play_sfx(name, vol)
  if muted then return end
  vol = vol or 0.8
  if not sound.play("sfx/" .. name .. ".wav", vol) then
    if name == "place" then sound.play("Pew", 700, 160)
    elseif name == "boom" then sound.play("Explode", 100, 450)
    elseif name == "crack" then sound.play("Zap", 300, 120)
    elseif name == "pickup" then sound.play("Coin", 700, 260)
    elseif name == "die" then sound.play("Sweep", 900, 180)
    elseif name == "clear" then sound.play("Chime", 880, 440)
    end
  end
end

-- High score persistence
local highscore = 5000
local function load_high()
  local f = openfile("bomberman.hi", "r")
  if f then
    local s = f:read("*a")
    f:close()
    if s then highscore = tonumber(s) or highscore end
  end
end
local function save_high()
  local f = openfile("bomberman.hi", "w")
  if f then
    f:write(tostring(highscore))
    f:close()
  end
end
load_high()

-- ---- Screen transform (world px -> screen px) ------------------------
local function sx(wx) return OX + wx * SCALE end
local function sy(wy) return OY + wy * SCALE end

-- ---- Game State --------------------------------------------------------
local state = "title"   -- "title", "play", "dying", "clear", "over"
local state_timer = 0
local level = 1
local score = 0
local lives = D.START_LIVES
local board_grid = nil   -- pure board rules (walls, crates, floor)
local move_grid = nil    -- movement view of the board
local hidden = nil       -- hidden[gx+1][gy+1] item name under each crate
local crates_left = 0
local bombs = {}         -- { gx, gy, fuse, s }
local bomb_cells = {}    -- key gy*COLS+gx -> bomb
local player_on_bomb = nil
local flames = {}        -- { gx, gy, kind, t, s }
local pickups = {}       -- { gx, gy, kind, s }
local float_texts = {}   -- { msg, wx, wy, life, clr }
local player = { wx = 48, wy = 48, speed_level = 0, blast_level = 0,
                 bomb_level = 0, shield = 0, invuln = 0, walk_t = 0 }

-- ---- sprites ------------------------------------------------------------
local function make_sprite(name, file, layer)
  local sp = sprites.new(name)
  if sp then
    sp.load(file)
    sp.layer = layer
    sp.scale = SCALE
    sp.visible = false
    sp.hide()
  end
  return sp
end

local sp_player = make_sprite("bmp_player", "img/bomber.sprite", 30)
if sp_player then sp_player.looping = true end

local tilemap = nil

-- Pools ---------------------------------------------------------------
local bomb_pool = {}
for i = 1, 6 do
  local s = make_sprite("bmp_bomb" .. i, "img/bomb.sprite", 20)
  if s then bomb_pool[#bomb_pool + 1] = { s = s, active = false } end
end

local flame_pools = {}
for _, kind in ipairs({ "center", "arm", "tip" }) do
  flame_pools[kind] = {}
  for i = 1, (kind == "center" and 4 or (kind == "arm" and 16 or 8)) do
    local s = make_sprite("bmp_fl_" .. kind .. i, "img/flame_" .. kind .. ".sprite", 40)
    if s then
      flame_pools[kind][#flame_pools[kind] + 1] = { s = s, active = false }
    end
  end
end

local pu_pool = {}
for i = 1, 10 do
  local s = make_sprite("bmp_pu" .. i, "img/powerup.sprite", 25)
  if s then pu_pool[#pu_pool + 1] = { s = s, active = false } end
end

local function acquire(pool)
  for _, o in ipairs(pool) do
    if not o.active then
      o.active = true
      o.s.visible = true
      o.s:show()
      return o
    end
  end
  return nil
end

local function release(o)
  if o then
    o.active = false
    o.s.visible = false
    o.s:hide()
  end
end

local function release_all()
  for _, o in ipairs(bomb_pool) do release(o) end
  for _, p in pairs(flame_pools) do for _, o in ipairs(p) do release(o) end end
  for _, o in ipairs(pu_pool) do release(o) end
end

-- ---- Floating text ------------------------------------------------------
local function add_text(msg, wx, wy, clr)
  float_texts[#float_texts + 1] = { msg = msg, wx = wx, wy = wy, life = 1.1, clr = clr }
end

-- ---- Board setup ---------------------------------------------------------
local function init_board(lvl)
  local seed = 20261103 + lvl * 977
  board_grid, hidden = D.create_board(seed)
  move_grid = {}
  crates_left = 0
  for y = 1, D.ROWS do
    move_grid[y] = {}
    for x = 1, D.COLS do
      move_grid[y][x] = board_grid[y][x]
      if board_grid[y][x] == D.T_CRATE then crates_left = crates_left + 1 end
    end
  end

  if tilemap == nil then
    tilemap = tiles.new("bomberman_board")
    tilemap.load("img/tiles.png", 32, 32, 4, 0, 0)
    tilemap.resize(D.COLS, D.ROWS)
    tilemap.scale = 1.0
  end
  for y = 1, D.ROWS do
    for x = 1, D.COLS do
      -- tilemap tiles.png indices are 1-based; data module tiles are 0-based
      tilemap.set(x - 1, y - 1, board_grid[y][x] + 1)
    end
  end

  -- Clear live entities
  for _, b in ipairs(bombs) do release(b.s_owner) end
  bombs = {}
  bomb_cells = {}
  player_on_bomb = nil
  for _, f in ipairs(flames) do release(f.s_owner) end
  flames = {}
  for _, p in ipairs(pickups) do release(p.s_owner) end
  pickups = {}
  release_all()

  -- Player at the spawn nook center
  player.wx = D.cell_cx(1)
  player.wy = D.cell_cy(1)
  player.invuln = D.INVULN_TIME
  if sp_player then
    sp_player.layer = 30
    sp_player.visible = true
    sp_player:show()
    sp_player:stop()
    sp_player.frame = 0
  end
end

local function reset_game()
  level = 1
  score = 0
  lives = D.START_LIVES
  player.speed_level = 0
  player.blast_level = 0
  player.bomb_level = 0
  player.shield = 0
  init_board(level)
  state = "play"
end

-- ---- Bombs & explosions ---------------------------------------------------
local function bomb_count()
  local n = 0
  for _, b in ipairs(bombs) do n = n + 1 end
  return n
end

local function place_bomb()
  if bomb_count() >= 1 + player.bomb_level then return end
  local gx, gy = D.gx_clamp(player.wx), D.gy_clamp(player.wy)
  local key = gy * D.COLS + gx
  if bomb_cells[key] then return end
  local slot = acquire(bomb_pool)
  if not slot then return end
  slot.s.frame = 0
  slot.s:play()
  local b = { gx = gx, gy = gy, fuse = D.BOMB_FUSE, s_owner = slot }
  slot.s.x = sx(D.cell_cx(gx))
  slot.s.y = sy(D.cell_cy(gy)) - 2 * SCALE
  bomb_cells[key] = b
  bombs[#bombs + 1] = b
  play_sfx("place")
end

local FLAME_LIFE = 0.45

local function explode_bomb(b)
  -- Remove from active lists
  local key = b.gy * D.COLS + b.gx
  if bomb_cells[key] == b then bomb_cells[key] = nil end
  for i = #bombs, 1, -1 do
    if bombs[i] == b then table.remove(bombs, i) break end
  end
  if player_on_bomb == b then player_on_bomb = nil end
  release(b.s_owner)

  play_sfx("boom")
  world.shake(140 + b.gx * 3, 7)

  local reach = D.BLAST_LEVEL0 + player.blast_level
  local cells, crates, chains = D.blast_cells(board_grid, bomb_cells, b.gx, b.gy, reach)

  -- Flames
  for _, c in ipairs(cells) do
    local slot = acquire(flame_pools[c.kind])
    if slot then
      slot.s.frame = 0
      slot.s.x = sx(D.cell_cx(c.gx))
      slot.s.y = sy(D.cell_cy(c.gy))
      flames[#flames + 1] = { gx = c.gx, gy = c.gy, t = FLAME_LIFE, s_owner = slot }
    end
  end

  -- Crates break, hidden items pop out
  for _, cr in ipairs(crates) do
    board_grid[cr.gy + 1][cr.gx + 1] = D.T_FLOOR
    move_grid[cr.gy + 1][cr.gx + 1] = D.T_FLOOR
    tilemap.set(cr.gx, cr.gy, D.T_FLOOR + 1)
    crates_left = crates_left - 1
    play_sfx("crack")
    local item = hidden[cr.gy + 1][cr.gx + 1]
    if item == "points" then
      score = score + 400
      add_text("400", D.cell_cx(cr.gx), D.cell_cy(cr.gy), colors.gold)
    elseif item then
      local slot = acquire(pu_pool)
      if slot then
        slot.s.frame = D.PU_FRAME[item]
        slot.s.x = sx(D.cell_cx(cr.gx))
        slot.s.y = sy(D.cell_cy(cr.gy))
        pickups[#pickups + 1] = { gx = cr.gx, gy = cr.gy, kind = item, s_owner = slot }
      end
      hidden[cr.gy + 1][cr.gx + 1] = nil
    end
  end

  -- Chain reactions fire on the next tick for a nice cascade
  for _, ch in ipairs(chains) do
    local cb = bomb_cells[ch.gy * D.COLS + ch.gx]
    if cb then cb.fuse = math.min(cb.fuse, 0.08) end
  end
end

-- ---- Death / respawn --------------------------------------------------------
local function kill_player()
  if player.invuln > 0 or state ~= "play" then return end
  if player.shield > 0 then
    player.shield = 0
    player.invuln = 1.0
    play_sfx("crack")
    add_text("SHIELD!", player.wx, player.wy - 20, colors.aqua)
    return
  end
  lives = lives - 1
  play_sfx("die")
  world.shake(200, 10)
  if sp_player then
    sp_player:play()  -- spin away as a silly death jiggle
  end
  state = lives > 0 and "dying" or "over"
  state_timer = lives > 0 and 1.2 or 0
  if state == "over" then
    if score > highscore then
      highscore = score
      save_high()
    end
    if sp_player then sp_player.visible = false sp_player:hide() end
  end
end

local function respawn()
  player.wx = D.cell_cx(1)
  player.wy = D.cell_cy(1)
  player.invuln = D.INVULN_TIME
  player_on_bomb = nil
  if sp_player then
    sp_player.visible = true
    sp_player:show()
    sp_player:stop()
    sp_player.frame = 0
  end
  state = "play"
end

-- ---- Movement ------------------------------------------------------------
local function player_walkable(px, py)
  if not D.box_free(move_grid, px, py) then return false end
  local hw, hh = D.PLAYER_HW, D.PLAYER_HH
  for _, b in ipairs(bombs) do
    if b ~= player_on_bomb then
      local bx0, by0 = b.gx * D.TILE, b.gy * D.TILE
      if px + hw > bx0 and px - hw < bx0 + D.TILE
        and py + hh > by0 and py - hh < by0 + D.TILE then
        return false
      end
    end
  end
  return true
end

local function move_player(dt)
  local mx, my = 0, 0
  if keyboard.down("w") or keyboard.down("up") then my = my - 1 end
  if keyboard.down("s") or keyboard.down("down") then my = my + 1 end
  if keyboard.down("a") or keyboard.down("left") then mx = mx - 1 end
  if keyboard.down("d") or keyboard.down("right") then mx = mx + 1 end

  local moving = (mx ~= 0 or my ~= 0)
  local speed = D.PLAYER_SPEED + player.speed_level * D.SPEED_STEP

  if moving then
    -- One axis per press keeps sliding crisp; diagonals prefer the last input
    if mx ~= 0 and my ~= 0 then my = 0 end

    -- Corner auto-align: snap the off-axis toward the cell center while sliding
    local nx, ny = player.wx, player.wy
    if mx ~= 0 then
      ny = D.cell_cy(D.gy_clamp(player.wy))
      if math.abs(ny - player.wy) > D.TILE / 2 then ny = player.wy end
      if player_walkable(player.wx + mx * speed * dt, ny) then
        player.wx = player.wx + mx * speed * dt
        player.wy = ny
      elseif player_walkable(player.wx + mx * speed * dt, player.wy) then
        player.wx = player.wx + mx * speed * dt
      end
    else
      nx = D.cell_cx(D.gx_clamp(player.wx))
      if math.abs(nx - player.wx) > D.TILE / 2 then nx = player.wx end
      if player_walkable(nx, player.wy + my * speed * dt) then
        player.wx = nx
        player.wy = player.wy + my * speed * dt
      elseif player_walkable(player.wx, player.wy + my * speed * dt) then
        player.wy = player.wy + my * speed * dt
      end
    end

    player.walk_t = player.walk_t + dt
    if sp_player and not sp_player.playing then sp_player:play() end
  else
    if sp_player then
      sp_player:stop()
      sp_player.frame = 0
    end
  end

  -- Stand-off logic: a bomb under the feet is passable until we leave it
  local cgx, cgy = D.gx_clamp(player.wx), D.gy_clamp(player.wy)
  local under = bomb_cells[cgy * D.COLS + cgx]
  if under then
    player_on_bomb = under
  end

  -- Pickups
  for i = #pickups, 1, -1 do
    local p = pickups[i]
    if p.gx == cgx and p.gy == cgy then
      release(p.s_owner)
      table.remove(pickups, i)
      play_sfx("pickup")
      if p.kind == "flame" then
        player.blast_level = math.min(D.MAX_BLAST_LEVEL, player.blast_level + 1)
        add_text("FLAME+", player.wx, player.wy - 20, colors.orange)
      elseif p.kind == "bomb" then
        player.bomb_level = math.min(D.MAX_BOMB_LEVEL, player.bomb_level + 1)
        add_text("BOMB+", player.wx, player.wy - 20, colors.white)
      elseif p.kind == "speed" then
        player.speed_level = math.min(D.MAX_SPEED_LEVEL, player.speed_level + 1)
        add_text("SPEED+", player.wx, player.wy - 20, colors.yellow)
      elseif p.kind == "shield" then
        player.shield = 1
        add_text("SHIELD", player.wx, player.wy - 20, colors.aqua)
      end
    end
  end

  -- Flames burn (unless spawn protected)
  if player.invuln <= 0 then
    for _, f in ipairs(flames) do
      if f.gx == cgx and f.gy == cgy then
        kill_player()
        break
      end
    end
  end
end

-- ---- Update -----------------------------------------------------------------
local function update_play(dt)
  if keyboard.pressed("space") then place_bomb() end

  move_player(dt)
  if state ~= "play" then return end

  if player.invuln > 0 then player.invuln = player.invuln - dt end

  -- Bombs tick down
  for i = #bombs, 1, -1 do
    local b = bombs[i]
    b.fuse = b.fuse - dt
    if b.fuse <= 0 then explode_bomb(b) end
  end

  -- Flames decay
  for i = #flames, 1, -1 do
    local f = flames[i]
    f.t = f.t - dt
    if f.t <= 0 then
      release(f.s_owner)
      table.remove(flames, i)
    else
      local k = 1 - f.t / FLAME_LIFE
      f.s_owner.s.frame = math.min(3, math.floor(k * 4))
    end
  end

  -- Level cleared when every crate is smashed (enemies come in the next level-up)
  if crates_left <= 0 and state == "play" then
    score = score + 1000 + level * 100
    add_text("LEVEL CLEAR!", D.COLS * D.TILE / 2, D.ROWS * D.TILE / 2, colors.lime)
    play_sfx("clear")
    state = "clear"
    state_timer = 2.2
  end
end

local bmp_err_shown = 0
local function bmp_try(f, name, ...)
  local ok, err = pcall(f, ...)
  if not ok and bmp_err_shown < 5 then
    bmp_err_shown = bmp_err_shown + 1
    println("[bmp] " .. name .. " ERROR: " .. tostring(err))
  end
end

local function update_inner(dt)
  if dt > 0.05 then dt = 0.05 end

  if keyboard.pressed("m") then muted = not muted end

  if state == "title" then
    if keyboard.pressed("space") or keyboard.pressed("enter") then reset_game() end
  elseif state == "over" then
    if keyboard.pressed("space") or keyboard.pressed("enter") or keyboard.pressed("r") then
      state = "title"
    end
  elseif state == "play" then
    if keyboard.pressed("escape") then
      state = "title"
    elseif keyboard.pressed("r") then
      reset_game()
    else
      update_play(dt)
    end
  elseif state == "dying" then
    state_timer = state_timer - dt
    if state_timer <= 0 then respawn() end
  elseif state == "clear" then
    state_timer = state_timer - dt
    if state_timer <= 0 then
      level = level + 1
      init_board(level)
      state = "play"
    end
  end

  -- Idle flames keep animating on the title/board screens
  for _, f in ipairs(flames) do
    if state ~= "play" then
      f.t = f.t - dt
      if f.t <= 0 then release(f.s_owner) end
    end
  end
  for i = #flames, 1, -1 do
    if flames[i].t <= 0 then table.remove(flames, i) end
  end

  -- Floating combat text
  for i = #float_texts, 1, -1 do
    local t = float_texts[i]
    t.life = t.life - dt
    t.wy = t.wy - 26 * dt
    if t.life <= 0 then table.remove(float_texts, i) end
  end

  -- Sync player sprite (blink while spawn protected, jiggle when dying)
  if sp_player then
    if state == "dying" then
      sp_player.frame = math.floor(time() * 10) % 4
    else
      sp_player.alpha = (player.invuln > 0 and math.floor(time() * 8) % 2 == 0) and 70 or 255
    end
    sp_player.x = sx(player.wx)
    sp_player.y = sy(player.wy) + 6   -- feet on the cell, art has headroom
  end

  -- Floating text sprites are drawn via world.text in draw()
end

function update(dt)
  bmp_try(update_inner, "update", dt)
end

-- ---- Drawing ------------------------------------------------------------------
local function draw_board_background()
  world.color = colors.black
  world.clear()
  -- Board shadow frame
  world.color = rgba(12, 14, 22, 255)
  world.rectangle(OX - 8, OY - 8, D.COLS * D.TILE * SCALE + 16, D.ROWS * D.TILE * SCALE + 16, true)
  if tilemap then
    tilemap.draw(OX, OY, SCALE)
  end
end

local function draw_panel()
  local x0 = HUD_X
  world.color = rgba(24, 28, 42, 255)
  world.rectangle(x0, 10, 950 - x0, 520, true)
  world.color = rgba(60, 70, 100, 255)
  world.rectangle(x0, 10, 950 - x0, 520, false)
  world.rectangle(x0, 10, 950 - x0, 2, true)

  world.color = colors.red
  world.text(x0 + 16, 24, "B O M B E R - M A N")
  world.color = colors.white
  world.text(x0 + 16, 52, "SCORE " .. score)
  world.color = colors.yellow
  world.text(x0 + 16, 72, "HI    " .. math.max(highscore, score))
  world.color = colors.lime
  world.text(x0 + 16, 92, "LEVEL " .. level)

  -- Lives as little helmets
  world.color = colors.white
  world.text(x0 + 16, 124, "LIVES")
  for i = 1, lives do
    local lx = x0 + 84 + i * 20
    world.color = colors.white
    world.circle(lx, 131, 7, true)
    world.color = rgba(40, 40, 52, 255)
    world.circle(lx - 2, 130, 1, true)
    world.circle(lx + 2, 130, 1, true)
  end

  -- Stat bars: BOMB / FLAME / SPEED
  local function stat_row(y, label, filled, maxv, clr)
    world.color = colors.white
    world.text(x0 + 16, y, label)
    for i = 1, maxv do
      local bx = x0 + 92 + (i - 1) * 26
      world.color = (i <= filled) and clr or rgba(46, 50, 66, 255)
      world.rectangle(bx, y, 18, 12, true)
    end
  end
  stat_row(156, "BOMBS", 1 + player.bomb_level, D.MAX_BOMB_LEVEL + 1, colors.white)
  stat_row(180, "FLAME", 1 + player.blast_level, D.MAX_BLAST_LEVEL, colors.orange)
  stat_row(204, "SPEED", 1 + player.speed_level, D.MAX_SPEED_LEVEL + 1, colors.yellow)

  if player.shield > 0 then
    world.color = colors.aqua
    world.text(x0 + 16, 228, "* SHIELD READY")
  end

  -- Crates remaining
  world.color = colors.gray
  world.text(x0 + 16, 252, "CRATES LEFT " .. math.max(0, crates_left))

  world.color = rgba(120, 130, 160, 255)
  world.text(x0 + 16, 470, "WASD/ARROWS MOVE")
  world.text(x0 + 16, 488, "SPACE PLANT BOMB")
  world.text(x0 + 16, 506, "M SOUND  R RESTART")
end

local function draw_floats()
  for _, t in ipairs(float_texts) do
    world.color = t.clr
    world.text(math.floor(sx(t.wx) - #t.msg * 3), math.floor(sy(t.wy)), t.msg)
  end
end

local function draw_title()
  screen.color = rgba(6, 8, 16, 225)
  screen.rectangle(0, 0, W, H, true)
  screen.alpha = 255

  screen.color = colors.red
  screen.text(W / 2 - 150, 110, "B O M B E R - M A N")
  screen.color = colors.white
  screen.text(W / 2 - 150, 150, "A TYRO CLASSIC BLAST-'EM-UP")

  screen.color = colors.yellow
  screen.text(W / 2 - 190, 250, "WASD / ARROWS   MOVE")
  screen.text(W / 2 - 190, 276, "SPACE           PLANT BOMB")
  screen.text(W / 2 - 190, 302, "M               SOUND ON/OFF")

  screen.color = colors.lime
  if math.floor(time() * 2) % 2 == 0 then
    screen.text(W / 2 - 130, 380, "[ PRESS SPACE TO START ]")
  end
  screen.color = colors.gold
  screen.text(W / 2 - 80, 430, "HI-SCORE " .. highscore)
end

local function draw_over()
  screen.color = rgba(6, 8, 16, 200)
  screen.rectangle(0, 0, W, H, true)
  screen.alpha = 255
  screen.color = colors.red
  screen.text(W / 2 - 90, H / 2 - 60, "GAME OVER")
  screen.color = colors.white
  screen.text(W / 2 - 90, H / 2 - 20, "FINAL SCORE " .. score)
  if score >= highscore then
    screen.color = colors.gold
    screen.text(W / 2 - 90, H / 2 + 4, "NEW HI-SCORE!")
  end
  screen.color = colors.yellow
  screen.text(W / 2 - 150, H / 2 + 60, "[ SPACE RETURNS TO TITLE ]")
end

local function draw_clear()
  screen.color = rgba(6, 8, 16, 140)
  screen.rectangle(0, 0, W, H, true)
  screen.alpha = 255
  screen.color = colors.lime
  screen.text(W / 2 - 110, H / 2 - 30, "LEVEL " .. level .. " CLEAR!")
  screen.color = colors.white
  screen.text(W / 2 - 110, H / 2, "BONUS " .. (1000 + level * 100))
end

function draw()
  draw_board_background()
  draw_panel()
  draw_floats()
  if state == "title" then
    draw_title()
  elseif state == "over" then
    draw_over()
  elseif state == "clear" then
    draw_clear()
  end
end

-- Boot: show the board behind the title screen.
-- Drop an empty attract.txt next to the script to auto-start (QA/dev aid,
-- same convention as Zonix).
init_board(1)
state = "title"
if openfile("attract.txt", "r") ~= nil then
  state = "play"
end
