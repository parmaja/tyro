--======================================================================
--  TORUS TROOPER - a time trial inside a torus, for the Tyro Game Engine
--======================================================================
--  Fly the inside of a giant ring. The clock is always draining; energy
--  orbs buy back a little time, boost gates buy back a lot - but a gate
--  only pays when you fly through its middle, and the walls wear obstacles
--  that punish leaving the line. The loop never changes: learn it by heart,
--  lap after lap, while the speed ceiling lifts and the clock drains
--  harder. A homage to Kenta Cho's 1.76 / Torus Trooper, riding Tyro's
--  free perspective camera on the engine's own generated shapes.
--
--  Controls:
--    LEFT / RIGHT (or stick)  roll the ring around the tube
--    UP / DOWN                throttle up and down
--    SPACE / START            start, and retry after game over
--    P                        pause        M mute        ESC quit
--======================================================================

local D = require("torustrooper_data")

-- Set TORUSTROOPER_TEST before require() and this file is a module: it
-- exports its internals instead of playing, and stays silent (see the
-- test hook at the bottom). The harness stages a copy next to itself.
local TESTING = TORUSTROOPER_TEST == true

window.show(D.W, D.H)
canvas.backcolor = colors.black

local TAU = D.TAU
local R, TUBE = D.R, D.TUBE

-- ---------------------------------------------------------------------
-- The world
-- ---------------------------------------------------------------------

-- The track: one generated torus. A rider lives inside the tube, so the
-- world wears a second skin: the liner is the same torus a hair narrower
-- and at scale -1 - the negative scale mirrors the mesh, so its faces
-- (and its light) point into the tube. The depth test lets the liner win
-- every look from inside and the plain track win every look from outside,
-- which keeps the title's orbit of a solid ring and closes the tube walls
-- on the ride.
-- Everything that rides inside hangs off MINUS the tube normal: the normal
-- points out of the wall (toward the hole at the floor), so minus the
-- normal is the way into the tube, and it is the rider's head direction.
local track = models.torus("track", R, TUBE)
track.tint = colors.white
local liner = models.torus("liner", R, TUBE - 1.5)
liner.scale = -1
-- light gray, not white: the tube wants to read as a shaded volume, and a
-- bright tint on a fully-lit skin whites the whole frame out.
liner.tint = colors.lightgray
-- and both skins wear it half-seen: the tube is a glass chute, so the
-- starfield outside shines through the walls and the ride keeps its bearings
-- in space instead of sitting in a painted tunnel. The liner is the skin the
-- rider looks at, so it carries most of the see-through; the outer skin keeps
-- more body for the title's orbit of the ring.
liner.alpha = D.WALL_ALPHA
track.alpha = D.TRACK_ALPHA

-- A planet in the hole, and a scatter of star-blobs to spin against.
-- The frustum clips at 1000 units, so everything stays well inside it.
local planet = models.sphere("planet")
planet.scale = 90
planet.tint = colors.maroon

-- The stars are the sky, not the scenery. Each one is painted on the world
-- canvas as a radial gradient - a hot core softening out to nothing - and the
-- model pass lays its glass over them exactly as it lays it over the sky, so
-- the field blooms the way a real one does and the ride carries no bodies up
-- there at all. The colours are the hot ones of a real sky: white, gold, a
-- cool blue. `on_screen()` below does the projecting.
local hot = { {255, 255, 255}, {255, 205, 90}, {140, 215, 255} }
local stars = {}
for i = 1, D.STARS do
  local a = math.random() * TAU
  local b = (math.random() * 2 - 1) * 0.85
  local d = D.STAR_FAR + math.random() * D.STAR_DEPTH
  stars[i] = {
    x = d * math.cos(a) * math.cos(b), y = d * math.sin(a) * math.cos(b),
    z = d * math.sin(b),
    size = D.STAR_MIN + math.random() * D.STAR_SPAN,
    col = hot[1 + i % #hot],
    phase = math.random() * TAU, beat = 1.1 + math.random() * 2.4, tw = 1 }
end

-- Where the free eye puts a world point on the canvas, in pixels, plus how big
-- it looks there. The look-at basis is built the way the camera builds its own
-- - sight line, right hand of that and the up, so a glow lands on the star it
-- belongs to - and it is built once a frame for the whole field. A point behind
-- the eye has no place on the canvas and gives nothing back.
local cam = { ok = false }
local function read_camera()
  local ex, ey, ez, tx, ty, tz, ux, uy, uz = world.camera()
  cam.ok = false
  local fx, fy, fz = tx - ex, ty - ey, tz - ez
  local fl = math.sqrt(fx * fx + fy * fy + fz * fz)
  if fl < 1e-6 then return end
  fx, fy, fz = fx / fl, fy / fl, fz / fl
  local rx, ry, rz = fy * uz - fz * uy, fz * ux - fx * uz, fx * uy - fy * ux
  local rl = math.sqrt(rx * rx + ry * ry + rz * rz)
  if rl < 1e-6 then return end
  rx, ry, rz = rx / rl, ry / rl, rz / rl
  cam.ex, cam.ey, cam.ez = ex, ey, ez
  cam.fx, cam.fy, cam.fz = fx, fy, fz
  cam.rx, cam.ry, cam.rz = rx, ry, rz
  cam.ux, cam.uy, cam.uz = ry * fz - rz * fy, rz * fx - rx * fz, rx * fy - ry * fx
  -- Pixels per world unit at one unit down the sight line: the vertical field
  -- of view over half the canvas height.
  cam.k = (D.H * 0.5) / math.tan(math.rad(world.fov()) * 0.5)
  cam.ok = true
end

local function on_screen(x, y, z)
  if not cam.ok then return nil end
  local vx, vy, vz = x - cam.ex, y - cam.ey, z - cam.ez
  local d = vx * cam.fx + vy * cam.fy + vz * cam.fz
  if d < 1 then return nil end
  local s = cam.k / d
  return D.W * 0.5 + (vx * cam.rx + vy * cam.ry + vz * cam.rz) * s,
    D.H * 0.5 - (vx * cam.ux + vy * cam.uy + vz * cam.uz) * s, s
end

-- The field painted, in four strokes per star: the halo - two gradient discs, a
-- wide faint one and a narrower one on top, which is what turns the gradient's
-- straight fade into a bell - then the bloom, nearly white, and the point, the
-- small hard dot that makes it a star and not a cloud. All of it rides the
-- star's own twinkle. This is canvas ink under the model pass, so the glass tube
-- dims the stars exactly as it dims the sky behind it.
local MARGIN = 240        -- how far off the edge a glow may sit and still draw
local function paint_stars()
  read_camera()
  for _, s in ipairs(stars) do
    local px, py, scale = on_screen(s.x, s.y, s.z)
    if px and px > -MARGIN and px < D.W + MARGIN
      and py > -MARGIN and py < D.H + MARGIN then
      local tw = s.tw
      local r = s.size * scale
      local c = s.col
      local glow = math.floor(D.GLOW_ALPHA * (0.3 + 0.7 * tw))
      local clear = rgba(c[1], c[2], c[3], 0)
      canvas.gradient.circle(px, py, r * D.GLOW_SPAN * (0.7 + 0.5 * tw),
        rgba(c[1], c[2], c[3], glow), clear)
      canvas.gradient.circle(px, py, r * D.GLOW_SPAN * D.GLOW_MID,
        rgba(c[1], c[2], c[3], glow), clear)
      canvas.gradient.circle(px, py, r * D.CORE_SPAN,
        rgba(255, 255, 255, math.floor(D.CORE_ALPHA * (0.4 + 0.6 * tw))), clear)
      local dot = math.max(1, r * D.POINT_SPAN)
      canvas.color = rgba(255, 255, 255, math.floor(D.POINT_ALPHA * (0.3 + 0.7 * tw)))
      canvas.circle(px, py, dot, true)
    end
  end
end

-- ---------------------------------------------------------------------
-- The entities - one fixed layout, memorizable lap after lap
-- ---------------------------------------------------------------------

local layout = D.layout(20261110)

-- Boost gates: rings standing across the tube, gold until you pass.
local gates = {}
for i, g in ipairs(layout.gates) do
  local m = models.torus("gate" .. i, 20, 2.5)
  local hx, hy, hz = D.trackPoint(R, TUBE, g.th, 0)
  local nx, ny, nz = D.trackNormal(R, TUBE, g.th, 0)
  -- the ring floats in the middle of the tube, mouth square to the road
  m:move(hx - nx * 22, hy - ny * 22, hz - nz * 22)
  -- Own +y aims at the tube floor, +z leans along the road's tangent,
  -- so the ring stands across the track.
  m:face(hx, hy, hz, -math.sin(g.th), math.cos(g.th), 0)
  m.tint = colors.gold
  gates[i] = { th = g.th, model = m, cool = 0, flash = 0 }
  m:hide()
end

-- Walls: blocks flush on the tube wall, long across the road. The hit box
-- matches the drawn block, so what you see is what you crash into.
local walls = {}
for i, w in ipairs(layout.walls) do
  local m = models.box("wall" .. i, 44, 12, 26)
  local wx, wy, wz = D.trackPoint(R, TUBE, w.th, w.al)
  local nx, ny, nz = D.trackNormal(R, TUBE, w.th, w.al)
  -- half sunk into the wall, half standing in the tube
  m:move(wx - nx * 13, wy - ny * 13, wz - nz * 13)
  m:face(wx - nx * 13 - math.sin(w.th) * 10,
    wy - ny * 13 + math.cos(w.th) * 10,
    wz - nz * 13, -nx, -ny, -nz)
  m.tint = colors.maroon
  walls[i] = { th = w.th, al = w.al, model = m }
  m:hide()
end

-- Energy cells: small lime spheres in arcs across the wall.
local orbs = {}
for i, o in ipairs(layout.orbs) do
  local m = models.sphere("orb" .. i)
  local ox, oy, oz = D.trackPoint(R, TUBE, o.th, o.al)
  local nx, ny, nz = D.trackNormal(R, TUBE, o.th, o.al)
  m:move(ox - nx * 7, oy - ny * 7, oz - nz * 7)
  m.scale = 4
  m.tint = colors.lime
  orbs[i] = { th = o.th, al = o.al, model = m, live = true }
  m:hide()
end

-- The tunnel ribs: rings centred on the tube centre line, their holes
-- square to the road. Pure scenery - no hit test touches them.
for i = 1, D.RIBS do
  local th = (i - 1) * TAU / D.RIBS
  local rb = models.torus("rib" .. i, TUBE - 3, 1.2)
  local rx, ry, rz = D.trackPoint(R, TUBE, th, 0)
  local nx, ny, nz = D.trackNormal(R, TUBE, th, 0)
  rb:move(rx - nx * TUBE, ry - ny * TUBE, rz - nz * TUBE)
  rb:face(rx - nx * (TUBE + 10), ry - ny * (TUBE + 10), rz - nz * (TUBE + 10),
    -math.sin(th), math.cos(th), 0)
  rb.tint = colors.gray
end

-- The ship: the rider's own delta-wing jet (Ship.glb). The engine loads glTF
-- upright (Y-up), so on the engine's Z-up stage the jet lies down along y with
-- its nose on -y; declaring `nose = "-y"` turns it around so face() aims the
-- nose down the road. The box below is the spare hull: it flies as-is if the
-- file is not there.
local ship = models.box("ship", 11, 20, 6)
ship.tint = colors.orange
ship:load("Ship.glb")
local jet = false   -- whether the glb hull has landed (the box is the spare)
-- ---------------------------------------------------------------------
-- Game state
-- ---------------------------------------------------------------------

world.fov(D.FOV)
world.lights(true)   -- a 3D ride wears its lights: sun along world.light's
                     -- default ray, the sky at its default fill, and the
                     -- ship's headlamp below

local state = "title"      -- "title" | "play" | "over"
local paused = false
local muted = false
local wire = false           -- vector mode: meshes as edges, shader makes them glow
local wireProbe = 0          -- counts down to the frame shader.ok can judge neon.frag
local hi = D.load_high_score()

local th, al, v = 0, 0, D.CRUISE
-- The steering the tests hold: the keyboard and the pad add to this, so a
-- headless ride can lean on the stick and watch the ring turn.
local stick = 0
local time_left, score, laps = D.START_TIME, 0, 0
local inv, shake, clock, drone = 0, 0, 0, false
local grace, newhi = 0, false
local bank, flash = 0, 0
local lap_clock, last_lap, best_lap = 0, 0, 0
local lap_msg, lap_msg_t, lap_msg_best = "", 0, false
local last_tick = 0

local function reset()
  th, al, v = 0, 0, D.CRUISE
  stick = 0
  time_left, score, laps = D.START_TIME, 0, 0
  -- the count-in doubles as start-line mercy: no wall bites before GO!
  inv, shake, last_tick = D.GRACE, 0, 0
  grace = D.GRACE
  bank, flash = 0, 0
  lap_clock, last_lap, best_lap = 0, 0, 0
  lap_msg, lap_msg_t, lap_msg_best = "", 0, false
  for _, o in ipairs(orbs) do
    o.live = true
    o.model:show()
  end
  for _, g in ipairs(gates) do
    g.cool, g.flash = 0, 0
    g.model.tint = colors.gold
    g.model:show()
  end
  for _, w in ipairs(walls) do w.model:show() end
  ship.alpha = 255
end

local function sfx(fn, a, b, c)
  -- one nil call must not kill a live run mid-crash; the play test asserts
  -- the whole audio surface exists so a wrong name is caught at test time.
  if fn and not muted and not TESTING then fn(a, b, c) end
end

-- Vector mode: the whole ride as its wireframe, and the board wears the
-- game's neon frag so the wires burn like the arcade CRT they imitate (the
-- built-in "glow" is the understudy when the frag file is not at hand). The
-- HUD rides the screen layer above the board, so the panels stay crisp
-- while the tube blooms.
local function apply_wire()
  world.wire(wire)
  if not wire then
    shader.effect = "none"
    wireProbe = 0
  else
    -- shader.load only queues, so wireProbe waits for the compile and
    -- falls back to the built-in glow only if neon.frag really failed.
    shader.load("neon.frag")
    wireProbe = 3
  end
end

local function start_play()
  reset()
  state = "play"
  paused = false
  sfx(music.sound, "Square", 660, 90)   -- the count-in's ready tick
  if not drone and not TESTING then
    sound.loopPlay("Engine", 60)
    drone = true
  end
end

local function end_play()
  state = "over"
  -- the record call happens before the save, while hi is still the old mark
  newhi = math.floor(score) > hi
  hi = D.save_high_score(score)
  if drone then sound.loopStop() end
  drone = false
  if newhi then
    sfx(music.mml, "t160 o5 g8 c8 e8 >g4")
  else
    sfx(music.mml, "t140 o4 g8 e8 c4")
  end
end

local function crash()
  v = v * 0.45
  time_left = time_left + D.TIME_WALL
  inv = D.CRASH_INV
  shake = 0.45
  flash = D.FLASH
  sfx(sound.noise, 250, 300)
end

-- ---------------------------------------------------------------------
-- Update
-- ---------------------------------------------------------------------

local function update_play(dt)
  -- Steering across the tube, keyboard and stick alike.
  local steer = stick
  if keyboard.down("left") then steer = steer + 1 end
  if keyboard.down("right") then steer = steer - 1 end
  local gx = gamepad.axis("leftx")
  -- squared response with a dead zone: fine control near the middle of
  -- the tube, full tilt only at a hard push.
  if math.abs(gx) > 0.15 then steer = steer - gx * math.abs(gx) end
  -- The ring rolls rather than the ship climbing to a stop: the angle wraps at
  -- the ceiling, so a held key keeps travelling over the inside surface - up
  -- the wall, across the top, down the far side and back to the floor. The
  -- camera's up rides the ship's own normal, so the ship stays at the bottom
  -- of the frame while the tube turns around it.
  al = D.wrapPi(al + steer * D.STEER * dt)
  -- the ship rolls into a slide like a motorcycle, smoothed so a flick
  -- of the stick leans rather than snaps.
  local want_bank = -D.BANK * D.clamp(steer, -1, 1)
  bank = bank + (want_bank - bank) * math.min(1, 8 * dt)

  -- Throttle: the stick's vertical axis pushes too, and the cruise line
  -- always wins in the end.
  if keyboard.down("up") or gamepad.down("a") then v = v + D.THROTTLE_UP * dt end
  if keyboard.down("down") or gamepad.down("x") then v = v + D.THROTTLE_DOWN * dt end
  local gy = gamepad.axis("lefty")
  if math.abs(gy) > 0.15 then v = v - gy * math.abs(gy) * D.THROTTLE_UP * dt end
  v = v + (D.CRUISE - v) * D.EASE * dt
  v = D.clamp(v, D.MINV, D.vMax(laps))

  -- Around the loop; a lap re-arms every orb, pays the lap bonus and is
  -- clocked - the course is fixed, so laps are comparable by construction.
  lap_clock = lap_clock + dt
  th = th + v * dt
  if th >= TAU then
    th = th - TAU
    laps = laps + 1
    last_lap = lap_clock
    local record = best_lap == 0 or last_lap < best_lap
    if record then best_lap = last_lap end
    lap_clock = 0
    -- announce the crossing over the track, and celebrate the shave
    if record and laps > 1 then
      lap_msg = "N E W   B E S T   " .. string.format("%.2f", last_lap) .. " s"
      lap_msg_best = true
    else
      lap_msg = "LAP  " .. string.format("%.2f", last_lap) .. " s"
      lap_msg_best = false
    end
    lap_msg_t = D.LAP_MSG
    score = score + D.SC_LAP * D.multiplier(laps)
    for _, o in ipairs(orbs) do
      o.live = true
      o.model:show()
    end
    sfx(music.mml, "t160 o5 c8 e8 g8 >c4")
  end

  -- The clock: always draining, harder every lap - except during the
  -- count-in, which is free. Distance still pays from the first frame.
  if grace > 0 then
    grace = grace - dt
    if grace <= 0 then sfx(music.sound, "Square", 990, 160) end   -- GO!
  else
    time_left = time_left - D.drain(laps) * dt
  end
  local k = R - TUBE * math.cos(al)
  score = score + k * v * dt * D.SC_DIST * D.multiplier(laps)

  -- Ticks in the last five seconds.
  if time_left < 5.5 then
    local tick = math.floor(time_left)
    if tick ~= last_tick then
      last_tick = tick
      if tick >= 0 then sfx(music.sound, "Square", 1300, 60) end
    end
  end

  -- Energy cells.
  for _, o in ipairs(orbs) do
    if o.live and D.orbHit(th, al, o) then
      o.live = false
      o.model:hide()
      time_left = math.min(D.TIME_CAP, time_left + D.TIME_ORB)
      v = v + 0.02
      score = score + D.SC_ORB * D.multiplier(laps)
      sfx(music.sound, "Tri", 700 + math.random(400), 70)
    end
  end

  -- Boost gates: only the middle of the ring pays.
  for _, g in ipairs(gates) do
    g.cool = g.cool - dt
    g.flash = g.flash - dt
    if g.cool <= 0 and D.gatePass(th, al, g) then
      g.cool = 2.0
      g.flash = 0.4
      g.model.tint = colors.lime
      v = v + 0.12
      time_left = math.min(D.TIME_CAP, time_left + D.TIME_GATE)
      score = score + D.SC_GATE * D.multiplier(laps)
      sfx(music.sound, "Square", 660, 80)
      sfx(music.sound, "Square", 990, 120)
    elseif g.flash <= 0 then
      g.model.tint = colors.gold
    end
  end

  -- Walls, unless still in the mercy time after the last hit.
  if inv > 0 then
    inv = inv - dt
    if math.floor(clock * 12) % 2 == 0 then ship.alpha = 80 else ship.alpha = 255 end
  else
    ship.alpha = 255
    for _, w in ipairs(walls) do
      if D.wallHit(th, al, w) then
        crash()
        break
      end
    end
  end

  if time_left <= 0 then
    time_left = 0
    end_play()
    return
  end

  -- nose by `bank`: rotate the rest up (-n) around the forward tangent t
  -- with Rodrigues; at bank=0 the cos/sin terms leave -n untouched.
  local sx, sy, sz = D.trackPoint(R, TUBE, th, al)
  local nx, ny, nz = D.trackNormal(R, TUBE, th, al)
  local tx, ty, tz = -math.sin(th), math.cos(th), 0
  local ux, uy, uz = -nx, -ny, -nz
  local cb, sb = math.cos(bank), math.sin(bank)
  -- t cross u
  local cx_, cy_, cz_ = ty * uz - tz * uy, tz * ux - tx * uz, tx * uy - ty * ux
  ux = ux * cb + cx_ * sb
  uy = uy * cb + cy_ * sb
  uz = uz * cb + cz_ * sb
  ship:move(sx - nx * 3, sy - ny * 3, sz - nz * 3)
  ship:face(sx + tx * 10 - nx * 3, sy + ty * 10 - ny * 3, sz - nz * 3, ux, uy, uz)

  -- The headlamp: a bulb a nose-ahead off the floor, lighting the tube
  -- around the ship while the tube behind stays in the sky's dimmer fill -
  -- the ride reads its own direction. Vector mode ignores the dress: the
  -- bare grid takes its mood from the bloom.
  world.pointlight(1, sx + tx * 14 - nx * 8, sy + ty * 14 - ny * 8,
    sz + tz * 14 - nz * 8, D.LAMP, D.LAMP_RANGE)

  -- Chase cam riding the tube, jittered by the last crash's shake.
  local ch = th - D.CAM_BACK
  local cx, cy, cz = D.trackPoint(R, TUBE, ch, al + D.CAM_UP)
  local wx, wy, wz = D.trackNormal(R, TUBE, ch, al + D.CAM_UP)
  local ah = th + D.CAM_LOOKAHEAD
  local ax, ay, az = D.trackPoint(R, TUBE, ah, al)
  local j = 0
  if shake > 0 then
    shake = shake - dt
    j = shake * 34
  end
  -- The view breathes with speed: cruise keeps the calm lens, wide-open
  -- speed opens the tunnel. And the eye rolls with a third of the bank,
  -- so a hard slide pulls the whole tube sideways with it.
  world.fov(D.FOV + (v - D.CRUISE) * D.FOV_PUNCH)
  local cbm, sbm = math.cos(bank * 0.34), math.sin(bank * 0.34)
  local fx, fy, fz = -math.sin(ch), math.cos(ch), 0
  local px, py, pz = -wx, -wy, -wz
  local qx, qy, qz = fy * pz - fz * py, fz * px - fx * pz, fx * py - fy * px
  world.camera(cx - wx * D.CAM_IN + (math.random() - 0.5) * j,
    cy - wy * D.CAM_IN + (math.random() - 0.5) * j,
    cz - wz * D.CAM_IN + (math.random() - 0.5) * j,
    ax, ay, az, px * cbm + qx * sbm, py * cbm + qy * sbm, pz * cbm + qz * sbm)

  -- The drone climbs with the speed, and obeys the mute switch.
  if drone then
    sound.loopPitch(50 + v * 110)
    sound.loopVolume(muted and 0 or 1)
  end
end

function update(dt)
  if keyboard.pressed("escape") then exit() end
  clock = clock + dt
  -- neon.frag verdict: still in wire mode and nothing compiled? keep glow
  if wireProbe > 0 then
    wireProbe = wireProbe - 1
    if wireProbe == 0 and wire and not shader.ok then
      shader.effect = "glow"
    end
  end
  -- When the jet lands: declare its nose, size it to the tuned hull (the
  -- box's 20-unit nose-to-tail), and let the file's own paint shine - the
  -- spare box stays orange. One-time business, then never looked at again.
  if (not jet) and ship.loaded then
    jet = true
    ship.nose = "-y"          -- the loaded jet lies along y, nose on -y
    ship.scale = 20 / math.max(ship.width, ship.height, ship.depth)
    ship.tint = colors.white
    ship.glow = "Engine"      -- the intakes burn full-bright, lamps or not
    ship.bright = D.JET_HOT   -- and burn HARDER than the colour the file has
  end
  if flash > 0 then flash = flash - dt end
  if lap_msg_t > 0 then lap_msg_t = lap_msg_t - dt end

  -- The sky shimmers: every star beats its own twinkle, and the painter rides
  -- that one number - the halo opens at the flash, the core nearly goes out
  -- between. It runs in every state, so the attract orbit wears the same living
  -- sky as the ride.
  for _, s in ipairs(stars) do
    local beat = 0.5 + 0.5 * math.sin(clock * s.beat + s.phase)
    s.tw = D.TWINKLE_FLOOR + (1 - D.TWINKLE_FLOOR) * beat
  end

  if keyboard.pressed("m") then
    muted = not muted
    if drone then sound.loopVolume((muted or paused) and 0 or 1) end
  end

  -- vector mode, for the pure-grid ride: wires only, glowing.
  if keyboard.pressed("w") then
    wire = not wire
    apply_wire()
    sfx(music.sound, "Tri", wire and 990 or 660, 70)
  end

  if state == "title" then
    -- Attract mode: a slow eye orbiting the whole ring.
    local a = clock * 0.12
    world.camera(520 * math.cos(a), -520 * math.sin(a), 260,
      0, 0, 0, 0, 0, 1)
    if input.start_pressed() then
      start_play()
    end
    return
  end

  if state == "over" then
    if input.start_pressed() then
      start_play()
    end
    return
  end

  if input.pause_pressed() then
    paused = not paused
    if drone then sound.loopVolume(paused and 0 or (muted and 0 or 1)) end
  end
  if paused then return end

  update_play(dt)
end

-- ---------------------------------------------------------------------
-- Draw
-- ---------------------------------------------------------------------

-- The HUD and the bands ride the screen layer: the world canvas sits under
-- the 3D pass, and an arcade HUD must not dive under the track. The font is
-- one fixed 18px size; textwidth() does the centering.
local function center(y, s)
  screen.text((D.W - textwidth(s)) / 2, y, s)
end

local function band(h)
  screen.color = rgba(0, 0, 0, 220)
  screen.rectangle(0, (D.H - h) / 2, D.W, h, true)
end

function draw()
  canvas.color = colors.black
  canvas.clear()
  -- The sky first: the stars are canvas ink, and the model pass paints its
  -- glass over them a moment later.
  paint_stars()
  -- the screen buffer keeps whatever was drawn last frame unless told
  -- otherwise, and a HUD whose numbers change would smear over its ghosts.
  screen.clear()

  -- the wall's autograph: a red pulse that fades under everything else.
  if flash > 0 then
    screen.color = rgba(255, 70, 50, math.floor(flash / D.FLASH * 150))
    screen.rectangle(0, 0, D.W, D.H, true)
  end

  if state == "title" then
    band(190)
    screen.color = colors.lime
    center(196, "T O R U S   T R O O P E R")
    screen.color = colors.white
    center(226, "fly the inside of the ring - the clock is everything")
    center(256, "orbs buy time, gates buy speed, walls cost both")
    screen.color = colors.gold
    center(292, "HI  " .. hi)
    screen.color = colors.white
    center(322, "press SPACE or START to fly")
    return
  end

  local mult = D.multiplier(laps)
  local k = R - TUBE * math.cos(al)
  -- panels first: the tube is a light world, and a white HUD on it needs
  -- a dark board to stand on.
  local hint = "L/R roll   U/D throttle   P pause   M mute   W wires"
    .. (muted and "  [muted]" or "") .. (wire and "  [wires]" or "")
  screen.color = rgba(0, 0, 0, 150)
  screen.rectangle(4, 4, 150, 136, true)
  screen.rectangle(D.W - 140, 4, 136, 26, true)
  screen.rectangle(4, D.H - 28, textwidth(hint) + 16, 26, true)
  screen.color = colors.white
  screen.text(10, 8, "SPEED  " .. math.floor(v * k + 0.5) .. " u/s")
  screen.text(10, 26, "LAP    " .. laps)
  screen.text(10, 44, "SCORE  " .. math.floor(score))
  screen.text(10, 62, "HI     " .. hi)
  screen.text(10, 80, "x" .. string.format("%.2f", mult))
  screen.text(10, 98, "LAST   " .. (last_lap > 0 and string.format("%.2f", last_lap) or "--"))
  screen.text(10, 116, "BEST   " .. (best_lap > 0 and string.format("%.2f", best_lap) or "--"))

  screen.color = colors.white
  if time_left < 6 then
    if math.floor(clock * 4) % 2 == 0 then screen.color = colors.red end
  end
  screen.text(D.W - 130, 8, "TIME " .. math.ceil(time_left))

  screen.color = colors.gray
  screen.text(10, D.H - 24, hint)

  if grace > 0 then
    screen.color = colors.lime
    center(120, "G O !")
  end

  -- the lap callout: gold for a crossing, lime for a shave, blinking out.
  if lap_msg_t > 0 and state == "play" then
    if lap_msg_t > 0.7 or math.floor(clock * 8) % 2 == 0 then
      screen.color = lap_msg_best and colors.lime or colors.gold
      center(70, lap_msg)
    end
  end

  if state == "over" then
    band(180)
    screen.color = colors.red
    center(200, "T I M E   U P")
    screen.color = colors.white
    center(234, "SCORE  " .. math.floor(score) .. "    LAPS  " .. laps)
    if newhi then
      screen.color = colors.lime
      center(262, "N E W   H I G H   S C O R E !")
    else
      screen.color = colors.gold
      center(262, "HI  " .. hi)
    end
    screen.color = colors.white
    if best_lap > 0 then
      center(290, "BEST LAP  " .. string.format("%.2f", best_lap) .. " s")
    end
    center(322, "press SPACE or START to fly again")
  elseif paused then
    band(70)
    screen.color = colors.lime
    center(250, "P A U S E D")
  end
end

-- ---------------------------------------------------------------------
-- Test hook
-- ---------------------------------------------------------------------

-- With TORUSTROOPER_TEST set this file was pulled in via require() from a
-- harness, not run as the game: export just enough internals to drive the
-- ride frame by frame and check what it decides. The harness owns the
-- update/draw callbacks then (and keeps the window alive).
if TESTING then
  return {
    start     = start_play,
    frame     = update,
    render    = draw,
    state     = function() return state end,
    th        = function() return th end,
    al        = function() return al end,
    v         = function() return v end,
    time      = function() return time_left end,
    score     = function() return score end,
    laps      = function() return laps end,
    invuln    = function() return inv end,
    grace     = function() return grace end,
    set_grace = function(x) grace = x end,
    newhi     = function() return newhi end,
    set_score = function(x) score = x end,
    bank      = function() return bank end,
    set_bank  = function(x) bank = x end,
    flash     = function() return flash end,
    lastlap   = function() return last_lap end,
    bestlap   = function() return best_lap end,
    lapmsg    = function() return lap_msg, lap_msg_t, lap_msg_best end,
    paused    = function() return paused end,
    wire      = function() return wire end,
    set_wire  = function(on) wire = on apply_wire() end,
    set_pos   = function(a, b) th = a al = b end,
    set_stick = function(x) stick = x end,
    set_v     = function(x) v = x end,
    set_time  = function(x) time_left = x end,
    set_inv   = function(x) inv = x end,
    set_paused = function(x) paused = x end,
    orbs      = function() return orbs end,
    walls     = function() return walls end,
    gates     = function() return gates end,
    liner     = function() return liner end,
    hi        = function() return hi end,
  }
end
