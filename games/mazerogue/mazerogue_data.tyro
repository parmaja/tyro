--======================================================================
--  mazerogue_data.tyro - Pure Rules, World & Mechanics Engine
--======================================================================
--  Contains procedural maze generation, roguelike entity spawning,
--  combat calculations, recoil physics formulas, and collision helpers.
--  Kept pure (no RayLib / engine calls) so it can run inside Tyro tests
--  and be verified in tests/test_mazerogue_data.tyro.
--======================================================================

local M = {}

-- ---- Tile definitions & sizes ---------------------------------------
M.TILE_SIZE = 32

M.T_VOID          = 1
M.T_FLOOR_A       = 2
M.T_FLOOR_B       = 3
M.T_FLOOR_C       = 4
M.T_WALL_TOP      = 5
M.T_WALL_FACE     = 6
M.T_WALL_CORNER_L = 7
M.T_WALL_CORNER_R = 8
M.T_DOOR          = 9
M.T_PILLAR        = 10

-- Returns true if tile is solid / blocks movement & projectiles
function M.is_solid_tile(t)
  return t == M.T_WALL_TOP or t == M.T_WALL_FACE or
         t == M.T_WALL_CORNER_L or t == M.T_WALL_CORNER_R or
         t == M.T_PILLAR or t == M.T_VOID
end

-- ---- Weapons, Recoil & Combat Tuning --------------------------------
M.PLAYER_MAX_HP    = 100
M.PLAYER_MAX_SHIELD= 50
M.PLAYER_SPEED     = 165
M.PLAYER_RADIUS    = 12

-- Recoil: gunner is pushed backward opposite to firing direction
M.GUN_DAMAGE       = 24
M.GUN_SPEED        = 520
M.GUN_COOLDOWN     = 0.15
M.GUN_RECOIL       = 175 -- pixels/sec backward impulse
M.RECOIL_FRICTION  = 8.0 -- velocity decay per second

-- Grenade tuning
M.GRENADE_MAX_AMMO = 10
M.GRENADE_START    = 3
M.GRENADE_SPEED    = 290
M.GRENADE_FUSE     = 1.4 -- seconds until explosion
M.GRENADE_RADIUS   = 95  -- explosion damage radius
M.GRENADE_DAMAGE   = 130 -- maximum center damage
M.GRENADE_KNOCKBACK= 360 -- knockback force to enemies
M.GRENADE_COOLDOWN = 0.65

-- Explosive barrel
M.BARREL_RADIUS    = 80
M.BARREL_DAMAGE    = 110

-- Sector darkness (torch / flashlight shader) ---------------------------
M.DARK_START_FLOOR = 2    -- floors below this stay fully lit
M.LIGHT_RADIUS     = 300  -- torch radius in pixels on DARK_START_FLOOR.
                          -- INCREASE THIS for a wider light circle!
M.LIGHT_SHRINK     = 15   -- torch shrinks this many px per deeper sector
M.LIGHT_MIN_RADIUS = 170  -- the torch never gets smaller than this
M.DARK_STRENGTH    = 0.93 -- 0..1 how black the darkness gets (shader.value)
M.RADAR_MAX_FLOOR  = 2    -- radar / mini-map only shows up to this sector

-- Torch light radius for a floor. 0 means the sector is fully lit.
function M.light_radius_for_floor(floor_num)
  if floor_num < M.DARK_START_FLOOR then return 0 end
  local r = M.LIGHT_RADIUS - (floor_num - M.DARK_START_FLOOR) * M.LIGHT_SHRINK
  return math.max(M.LIGHT_MIN_RADIUS, r)
end

-- How strongly a world point is lit by the torch: 1 inside the inner core,
-- fading smoothly to 0 at the rim. Mirrors flashlight.frag's falloff so
-- sprites and terrain dim together.
function M.light_factor(x, y, cx, cy, radius)
  if radius <= 0 then return 1 end
  local inner = radius * 0.45
  local d = M.distance(x, y, cx, cy)
  if d <= inner then return 1 end
  if d >= radius then return 0 end
  local t = (radius - d) / (radius - inner)
  return t * t * (3.0 - 2.0 * t) -- smoothstep
end

-- Enemy rosters
M.ENEMIES = {
  scuttler = {
    hp = 40,
    speed = 115,
    damage = 14,
    radius = 12,
    score = 100,
    is_ranged = false,
  },
  drone = {
    hp = 50,
    speed = 70,
    damage = 12,
    radius = 13,
    score = 150,
    is_ranged = true,
    fire_rate = 1.6,
    bullet_speed = 220,
  },
  brute = {
    hp = 180,
    speed = 48,
    damage = 28,
    radius = 16,
    score = 300,
    is_ranged = false,
  },
  kamikaze = {
    hp = 25,
    speed = 145,
    damage = 65,
    radius = 11,
    score = 130,
    is_ranged = false,
    explode_radius = 65,
  },
  turret = {
    hp = 140,
    speed = 0,
    damage = 18,
    radius = 15,
    score = 250,
    is_ranged = true,
    immobile = true,      -- static emplacement, never moves from its pad
    gun_immune = true,    -- gun rounds ricochet off the armor, only blasts hurt it
    fire_rate = 2.4,
    bullet_speed = 240,
  },
}

-- Enemies keep "seeing" the player for this many seconds after he leaves
-- sight range or breaks line of sight, then give up the chase.
M.SIGHT_MEMORY_TIME = 3.0

-- Sight memory bookkeeping (pure). While the player is visible the enemy
-- stamps the player's position into e.last_x / e.last_y and refreshes the
-- memory timer. Afterwards it decays. Returns true while the enemy should
-- stay alert and keep hunting the last known position.
function M.update_sight_memory(e, can_see_player, player_x, player_y, dt)
  if can_see_player then
    e.memory = M.SIGHT_MEMORY_TIME
    e.last_x = player_x
    e.last_y = player_y
    return true
  end
  local mem = e.memory or 0
  if mem > 0 then
    e.memory = mem - dt
    return e.memory > 0
  end
  return false
end

-- ---- Math & Collision Helpers ----------------------------------------
-- The engine's global clamp, exported under M for the callers.
M.clamp = clamp

function M.distance(x1, y1, x2, y2)
  local dx = x2 - x1
  local dy = y2 - y1
  return math.sqrt(dx * dx + dy * dy)
end

function M.dist_sq(x1, y1, x2, y2)
  local dx = x2 - x1
  local dy = y2 - y1
  return dx * dx + dy * dy
end

-- Computes recoil velocity impulse opposite to firing angle
function M.calculate_recoil(aim_angle, recoil_force)
  local force = recoil_force or M.GUN_RECOIL
  local vx = -math.cos(aim_angle) * force
  local vy = -math.sin(aim_angle) * force
  return vx, vy
end

-- AOE damage falloff based on distance from blast center
function M.calculate_aoe_damage(dist, max_radius, max_damage)
  if dist >= max_radius then return 0 end
  local frac = 1.0 - (dist / max_radius)
  return math.floor(max_damage * frac)
end

-- Simple deterministic pseudo-random generator for reproducible tests:
-- the engine's seeded rng(), same seed same stream.
M.new_rng = rng

-- ---- Procedural Maze Generator ---------------------------------------
-- Generates a grid of size (cols x rows) with carved rooms and maze corridors.
function M.generate_maze(cols, rows, seed, num_rooms)
  local rng = M.new_rng(seed or 42)
  cols = (cols % 2 == 0) and (cols + 1) or cols
  rows = (rows % 2 == 0) and (rows + 1) or rows
  num_rooms = num_rooms or 6

  -- 1. Initialize grid with walls
  local grid = {}
  for y = 0, rows - 1 do
    grid[y] = {}
    for x = 0, cols - 1 do
      grid[y][x] = M.T_WALL_TOP
    end
  end

  local rooms = {}

  -- 2. Carve rectangular rooms
  for r = 1, 80 do
    if #rooms >= num_rooms then break end
    local rw = rng(2, 3) * 2 + 1  -- 5 or 7
    local rh = rng(2, 3) * 2 + 1  -- 5 or 7
    local max_rx = math.max(1, math.floor((cols - rw - 2) / 2))
    local max_ry = math.max(1, math.floor((rows - rh - 2) / 2))
    local rx = rng(1, max_rx) * 2 + 1
    local ry = rng(1, max_ry) * 2 + 1

    -- Check overlap with existing rooms (with 1 tile padding)
    local overlap = false
    for _, rm in ipairs(rooms) do
      if not (rx + rw + 1 < rm.x or rx > rm.x + rm.w + 1 or
              ry + rh + 1 < rm.y or ry > rm.y + rm.h + 1) then
        overlap = true
        break
      end
    end

    if not overlap then
      local floor_variant = (rng(1, 3) == 1) and M.T_FLOOR_B or M.T_FLOOR_A
      for y = ry, ry + rh - 1 do
        for x = rx, rx + rw - 1 do
          grid[y][x] = floor_variant
        end
      end
      table.insert(rooms, {
        x = rx, y = ry, w = rw, h = rh,
        cx = rx + math.floor(rw / 2),
        cy = ry + math.floor(rh / 2),
      })
    end
  end

  -- Fallback if no rooms carved
  if #rooms == 0 then
    local cx = math.floor(cols / 2)
    local cy = math.floor(rows / 2)
    for y = cy - 2, cy + 2 do
      for x = cx - 2, cx + 2 do
        grid[y][x] = M.T_FLOOR_A
      end
    end
    table.insert(rooms, {x = cx - 2, y = cy - 2, w = 5, h = 5, cx = cx, cy = cy})
  end

  -- 3. Carve Maze Corridors using Recursive Backtracking (DFS)
  local stack = {}
  local start_x = 1
  local start_y = 1
  grid[start_y][start_x] = M.T_FLOOR_A
  table.insert(stack, {x = start_x, y = start_y})

  local dirs = {
    {dx = 0, dy = -2},
    {dx = 0, dy = 2},
    {dx = -2, dy = 0},
    {dx = 2, dy = 0},
  }

  while #stack > 0 do
    local curr = stack[#stack]
    local neighbors = {}

    for _, d in ipairs(dirs) do
      local nx = curr.x + d.dx
      local ny = curr.y + d.dy
      if nx > 0 and nx < cols - 1 and ny > 0 and ny < rows - 1 then
        if M.is_solid_tile(grid[ny][nx]) then
          table.insert(neighbors, {x = nx, y = ny, mx = curr.x + d.dx / 2, my = curr.y + d.dy / 2})
        end
      end
    end

    if #neighbors > 0 then
      local pick = neighbors[rng(1, #neighbors)]
      grid[pick.my][pick.mx] = M.T_FLOOR_A
      grid[pick.y][pick.x] = M.T_FLOOR_A
      table.insert(stack, {x = pick.x, y = pick.y})
    else
      table.remove(stack)
    end
  end

  -- 4. Connect rooms to the maze passages
  for _, rm in ipairs(rooms) do
    local doors = {
      {x = rm.cx, y = rm.y - 1},
      {x = rm.cx, y = rm.y + rm.h},
      {x = rm.x - 1, y = rm.cy},
      {x = rm.x + rm.w, y = rm.cy},
    }
    for _, d in ipairs(doors) do
      if d.x > 0 and d.x < cols - 1 and d.y > 0 and d.y < rows - 1 then
        grid[d.y][d.x] = M.T_FLOOR_A
      end
    end
  end

  -- 5. Add loops and alternate pathways (removes ~8% of corridor walls)
  for y = 2, rows - 3, 2 do
    for x = 2, cols - 3, 2 do
      if M.is_solid_tile(grid[y][x]) and rng(1, 100) <= 8 then
        -- Carve if it joins two floor spaces
        if (not M.is_solid_tile(grid[y - 1][x]) and not M.is_solid_tile(grid[y + 1][x])) or
           (not M.is_solid_tile(grid[y][x - 1]) and not M.is_solid_tile(grid[y][x + 1])) then
          grid[y][x] = M.T_FLOOR_A
        end
      end
    end
  end

  -- 6. Beautify walls: Wall Face below Wall Top for 2.5D depth
  for y = 0, rows - 1 do
    for x = 0, cols - 1 do
      if grid[y][x] == M.T_WALL_TOP then
        if y < rows - 1 and not M.is_solid_tile(grid[y + 1][x]) then
          grid[y][x] = M.T_WALL_FACE
        end
      end
    end
  end

  -- 7. Assign Start and Exit rooms (farthest apart)
  local start_room = rooms[1]
  local exit_room = rooms[#rooms]
  local max_dist = 0
  for i = 1, #rooms do
    for j = i + 1, #rooms do
      local d = M.distance(rooms[i].cx, rooms[i].cy, rooms[j].cx, rooms[j].cy)
      if d > max_dist then
        max_dist = d
        start_room = rooms[i]
        exit_room = rooms[j]
      end
    end
  end

  return {
    grid = grid,
    cols = cols,
    rows = rows,
    rooms = rooms,
    start_pos = {
      x = start_room.cx * M.TILE_SIZE + M.TILE_SIZE / 2,
      y = start_room.cy * M.TILE_SIZE + M.TILE_SIZE / 2,
    },
    exit_pos = {
      x = exit_room.cx * M.TILE_SIZE + M.TILE_SIZE / 2,
      y = exit_room.cy * M.TILE_SIZE + M.TILE_SIZE / 2,
    },
    start_room = start_room,
    exit_room = exit_room,
  }
end

-- ---- Reachability / Connectivity Check (BFS) ------------------------
function M.is_reachable(grid, cols, rows, start_tx, start_ty, target_tx, target_ty)
  if start_tx == target_tx and start_ty == target_ty then return true end
  if M.is_solid_tile(grid[start_ty][start_tx]) or M.is_solid_tile(grid[target_ty][target_tx]) then
    return false
  end

  local visited = {}
  for y = 0, rows - 1 do
    visited[y] = {}
  end

  local queue = {{x = start_tx, y = start_ty}}
  visited[start_ty][start_tx] = true
  local head = 1

  local dirs = {{0, -1}, {0, 1}, {-1, 0}, {1, 0}}

  while head <= #queue do
    local curr = queue[head]
    head = head + 1

    if curr.x == target_tx and curr.y == target_ty then
      return true
    end

    for _, d in ipairs(dirs) do
      local nx = curr.x + d[1]
      local ny = curr.y + d[2]
      if nx >= 0 and nx < cols and ny >= 0 and ny < rows then
        if not visited[ny][nx] and not M.is_solid_tile(grid[ny][nx]) then
          visited[ny][nx] = true
          table.insert(queue, {x = nx, y = ny})
        end
      end
    end
  end

  return false
end

-- ---- Wall Collision Resolution for Circle Entities ------------------
-- Slides circle along solid tiles so player and enemies move smoothly.
function M.resolve_wall_collision(x, y, radius, grid, cols, rows, tile_size)
  local ts = tile_size or M.TILE_SIZE
  local min_tx = math.floor((x - radius) / ts)
  local max_tx = math.floor((x + radius) / ts)
  local min_ty = math.floor((y - radius) / ts)
  local max_ty = math.floor((y + radius) / ts)

  min_tx = M.clamp(min_tx, 0, cols - 1)
  max_tx = M.clamp(max_tx, 0, cols - 1)
  min_ty = M.clamp(min_ty, 0, rows - 1)
  max_ty = M.clamp(max_ty, 0, rows - 1)

  local new_x, new_y = x, y

  for ty = min_ty, max_ty do
    for tx = min_tx, max_tx do
      if M.is_solid_tile(grid[ty][tx]) then
        local rx = tx * ts
        local ry = ty * ts
        local rw, rh = ts, ts

        -- Nearest point on rectangle to circle center
        local near_x = M.clamp(new_x, rx, rx + rw)
        local near_y = M.clamp(new_y, ry, ry + rh)

        local dx = new_x - near_x
        local dy = new_y - near_y
        local d_sq = dx * dx + dy * dy

        if d_sq < radius * radius and d_sq > 0.0001 then
          local d = math.sqrt(d_sq)
          local push = radius - d
          new_x = new_x + (dx / d) * push
          new_y = new_y + (dy / d) * push
        elseif d_sq == 0 then
          -- Exactly centered inside solid tile: push out
          new_y = new_y + radius
        end
      end
    end
  end

  return new_x, new_y
end

-- ---- Line of Sight (LOS) Raycasting -----------------------------------
-- Returns true if there is an unblocked line of sight between (x1, y1) and (x2, y2).
-- Ray stops if it passes through any solid wall tile or diagonal corner seam.
function M.has_line_of_sight(x1, y1, x2, y2, grid, cols, rows, tile_size)
  local ts = tile_size or M.TILE_SIZE
  local dx = x2 - x1
  local dy = y2 - y1
  local dist = math.sqrt(dx * dx + dy * dy)
  if dist < 1 then return true end

  local step = ts * 0.25 -- 8 pixels per step (fine sampling across 32px tiles)
  local num_steps = math.ceil(dist / step)
  if num_steps < 1 then num_steps = 1 end

  local last_tx = math.floor(x1 / ts)
  local last_ty = math.floor(y1 / ts)

  if last_tx < 0 or last_tx >= cols or last_ty < 0 or last_ty >= rows then
    return false
  end
  if M.is_solid_tile(grid[last_ty][last_tx]) then
    return false
  end

  for i = 1, num_steps do
    local t = i / num_steps
    local px = x1 + dx * t
    local py = y1 + dy * t
    local tx = math.floor(px / ts)
    local ty = math.floor(py / ts)

    if tx < 0 or tx >= cols or ty < 0 or ty >= rows then
      return false
    end

    if M.is_solid_tile(grid[ty][tx]) then
      return false
    end

    -- Prevent seeing diagonally between two diagonally touching solid tiles
    if tx ~= last_tx and ty ~= last_ty then
      if M.is_solid_tile(grid[last_ty][tx]) and M.is_solid_tile(grid[ty][last_tx]) then
        return false
      end
    end

    last_tx = tx
    last_ty = ty
  end

  return true
end

-- ---- Enemy Separation (Anti-Overlap Physics) --------------------------
-- Pushes overlapping active enemies apart so they maintain circle spacing
-- and do not visually stack on top of each other.
function M.separate_enemies(enemies)
  local n = #enemies
  for i = 1, n do
    local e1 = enemies[i]
    if not e1.dead then
      local r1 = e1.radius or 12
      for j = i + 1, n do
        local e2 = enemies[j]
        if not e2.dead then
          local r2 = e2.radius or 12
          local dx = e2.x - e1.x
          local dy = e2.y - e1.y
          local min_dist = r1 + r2
          local dist_sq = dx * dx + dy * dy

          if dist_sq < min_dist * min_dist then
            local dist = math.sqrt(dist_sq)
            local overlap = min_dist - dist
            local nx, ny
            if dist > 0.0001 then
              nx = dx / dist
              ny = dy / dist
            else
              nx = 1
              ny = 0
              overlap = min_dist
            end

            -- Immobile emplacements (turrets) never get pushed; the free
            -- enemy absorbs the whole overlap instead.
            if not (e1.immobile and e2.immobile) then
              local share1 = e1.immobile and 0 or 0.5
              local share2 = e2.immobile and 0 or 0.5
              if share1 == 0 then share2 = 1 end
              if share2 == 0 then share1 = 1 end

              e1.x = e1.x - nx * overlap * share1
              e1.y = e1.y - ny * overlap * share1
              e2.x = e2.x + nx * overlap * share2
              e2.y = e2.y + ny * overlap * share2
            end
          end
        end
      end
    end
  end
end

-- ---- Entity Spawner for Level / Floor ---------------------------------
function M.spawn_level_entities(maze_data, floor_num)
  local rng = M.new_rng(floor_num * 1000 + 42)
  local enemies = {}
  local props = {}
  local pickups = {}
  local ts = M.TILE_SIZE

  local rooms = maze_data.rooms
  local start_room = maze_data.start_room
  local exit_room = maze_data.exit_room

  -- Roster weighting based on floor depth (turrets guard deeper sectors)
  local function pick_enemy_kind()
    local roll = rng(1, 100)
    if floor_num <= 1 then
      if roll <= 60 then return "scuttler"
      elseif roll <= 85 then return "drone"
      else return "kamikaze" end
    elseif floor_num <= 3 then
      if roll <= 38 then return "scuttler"
      elseif roll <= 64 then return "drone"
      elseif roll <= 82 then return "kamikaze"
      elseif roll <= 92 then return "turret"
      else return "brute" end
    else
      if roll <= 28 then return "scuttler"
      elseif roll <= 50 then return "drone"
      elseif roll <= 68 then return "kamikaze"
      elseif roll <= 82 then return "turret"
      else return "brute" end
    end
  end

  -- Spawn enemies in non-start rooms and corridors
  for _, rm in ipairs(rooms) do
    if rm ~= start_room then
      local count = rng(1, 1 + math.min(floor_num, 2))
      for _ = 1, count do
        local kind = pick_enemy_kind()
        local ex = (rm.x + rng(1, rm.w - 2)) * ts + ts / 2
        local ey = (rm.y + rng(1, rm.h - 2)) * ts + ts / 2

        -- Keep static cannons far enough from the exit portal so they
        -- never sit on top of the stairs; move them to a room corner.
        if kind == "turret" and maze_data.exit_pos then
          if M.distance(ex, ey, maze_data.exit_pos.x, maze_data.exit_pos.y) < 3 * ts then
            ex = (rm.x + 1) * ts + ts / 2
            ey = (rm.y + 1) * ts + ts / 2
          end
        end

        local stats = M.ENEMIES[kind]
        table.insert(enemies, {
          kind = kind,
          x = ex,
          y = ey,
          hp = math.floor(stats.hp * (1.0 + (floor_num - 1) * 0.15)),
          max_hp = math.floor(stats.hp * (1.0 + (floor_num - 1) * 0.15)),
          speed = stats.speed,
          damage = stats.damage,
          radius = stats.radius,
          score = stats.score,
          is_ranged = stats.is_ranged,
          immobile = stats.immobile,
          gun_immune = stats.gun_immune,
          memory = 0,
          fire_timer = rng(5, 20) / 10.0,
        })
      end

      -- Spawn Crates / Barrels in room corners
      if rng(1, 100) <= 60 then
        local bx = (rm.x + 1) * ts + ts / 2
        local by = (rm.y + 1) * ts + ts / 2
        local is_barrel = rng(1, 100) <= 40
        table.insert(props, {
          kind = is_barrel and "barrel" or "crate",
          x = bx,
          y = by,
          hp = is_barrel and 10 or 20,
          radius = 12,
        })
      end
    end
  end

  -- Guarantee at least one plasma turret emplacement from floor 2 onward
  if floor_num >= 2 then
    local has_turret = false
    for _, e in ipairs(enemies) do
      if e.kind == "turret" then
        has_turret = true
        break
      end
    end
    if not has_turret then
      local t_room = nil
      for _, rm in ipairs(rooms) do
        if rm ~= start_room then
          t_room = rm
          break
        end
      end
      t_room = t_room or rooms[1]
      local stats = M.ENEMIES.turret
      local tx = (t_room.x + 2) * ts + ts / 2
      local ty = (t_room.y + 2) * ts + ts / 2
      if maze_data.exit_pos
         and M.distance(tx, ty, maze_data.exit_pos.x, maze_data.exit_pos.y) < 3 * ts then
        tx = (t_room.x + t_room.w - 2) * ts + ts / 2
        ty = (t_room.y + t_room.h - 2) * ts + ts / 2
      end
      table.insert(enemies, {
        kind = "turret",
        x = tx,
        y = ty,
        hp = math.floor(stats.hp * (1.0 + (floor_num - 1) * 0.15)),
        max_hp = math.floor(stats.hp * (1.0 + (floor_num - 1) * 0.15)),
        speed = stats.speed,
        damage = stats.damage,
        radius = stats.radius,
        score = stats.score,
        is_ranged = stats.is_ranged,
        immobile = stats.immobile,
        gun_immune = stats.gun_immune,
        memory = 0,
        fire_timer = 1.5,
      })
    end
  end

  -- Pickups: placed in non-start rooms
  for _, rm in ipairs(rooms) do
    if rm ~= start_room and rng(1, 100) <= 45 then
      local p_kind
      local roll = rng(1, 100)
      if roll <= 40 then p_kind = "health"
      elseif roll <= 70 then p_kind = "grenade"
      elseif roll <= 85 then p_kind = "shield"
      else p_kind = "gem" end

      table.insert(pickups, {
        kind = p_kind,
        x = rm.cx * ts + ts / 2,
        y = rm.cy * ts + ts / 2,
        radius = 10,
      })
    end
  end

  -- Ensure at least one crate exists, and assign the key to exactly one crate
  local crate_indices = {}
  for i, pr in ipairs(props) do
    if pr.kind == "crate" then
      table.insert(crate_indices, i)
    end
  end

  if #crate_indices == 0 then
    -- Guarantee a crate in an available non-start room
    local target_room = rooms[2] or rooms[1]
    local cx = (target_room.x + 1) * ts + ts / 2
    local cy = (target_room.y + 1) * ts + ts / 2
    local key_crate = {
      kind = "crate",
      x = cx,
      y = cy,
      hp = 20,
      radius = 12,
      has_key = true,
    }
    table.insert(props, key_crate)
  else
    local key_idx = crate_indices[rng(1, #crate_indices)]
    props[key_idx].has_key = true
  end

  return {
    enemies = enemies,
    props = props,
    pickups = pickups,
  }
end

return M
