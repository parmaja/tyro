--======================================================================
--  Fire - a Game & Watch style rescue game for Tyro
--======================================================================
--  A burning building on the left. People appear at the windows and jump.
--  Two firemen below carry a life net: slide it under a jumper to catch
--  them, then keep bouncing them to the right until they land on the
--  ambulance. Every catch scores a point, every rescue scores a bonus.
--  A jumper who hits the street is injured and costs a miss; three misses
--  end the game. At 200 and 500 points the misses are cleared and every
--  jumper freezes for a moment, just like the wide screen original.
--
--  Everything is drawn with canvas primitives - no image files.
--
--  Controls:  LEFT / RIGHT  (A / D)    move the net
--             SPACE / ENTER           start or restart
--             ESC                     quit
--  Gamepad:   left stick / D-pad      move the net
--             A / START               start or restart
--  Sound:     a gapless "Fire" crackle loop, "Boing" catches and a
--             "Siren" game over - all generated by the engine.
--  Run:  tyro games/fire/fire.tyro
--======================================================================

window.show(720, 520)

local W, H = canvas.width, canvas.height

-- ---- scene geometry --------------------------------------------------
local GROUND_Y   = 470
local NET_Y      = 404
local NET_HALF   = 48
local NET_SPEED  = 430
local NET_MIN_X  = 80
local NET_MAX_X  = 560
local PERSON_H   = 26

local BUILD_X    = 20
local BUILD_Y    = 50
local BUILD_W    = 300
local BUILD_H    = GROUND_Y - BUILD_Y
local FLOOR_TOPS = {86, 182, 278}
local WINDOW_W   = 62
local WINDOW_H   = 58
local WINDOW_XS  = {88, 190}

local AMB_X      = 612
local AMB_Y      = 408
local AMB_W      = 98
local AMB_H      = 62

local MAX_MISSES = 3
local MAX_AIRBORNE = 5
local BONUS_AT   = {200, 500}

local SHIRTS = {colors.red, colors.blue, colors.green, colors.purple, colors.orange, colors.white}

-- ---- helpers ---------------------------------------------------------
local function clamp(v, lo, hi)
  if v < lo then return lo elseif v > hi then return hi else return v end
end

local function center_text(s, y, col)
  canvas.color = col
  canvas.text((W - textwidth(s)) / 2, y, s)
end

local function bold_text(s, y, col)
  local x = (W - textwidth(s)) / 2
  canvas.color = col
  canvas.text(x - 1, y, s)
  canvas.text(x + 1, y, s)
  canvas.text(x, y - 1, s)
  canvas.text(x, y + 1, s)
  canvas.text(x, y, s)
end

-- The left stick gives smooth net movement. The dead zone keeps stick
-- drift from nudging the net, and movement past it is rescaled so the
-- controls still start gently. D-pad and keys mirror each other.
local PAD_DEAD = 0.25

local function pad_axis(name)
  local v = gamepadaxis(name)
  if v > -PAD_DEAD and v < PAD_DEAD then return 0 end
  local sign = 1
  if v < 0 then sign = -1 end
  return sign * ((math.abs(v) - PAD_DEAD) / (1 - PAD_DEAD))
end

-- ---- state -----------------------------------------------------------
local state          -- "ready", "play" or "over"
local score, highScore, misses
local netX
local victims, hurts, pops
local spawnTimer, freezeTimer, nextBonus
local fireOn, firePitchTimer

local function gravity()
  return 470 + math.min(score, 1000) * 0.32
end

local function add_pop(x, y, col)
  pops[#pops + 1] = { x = x, y = y, t = 0, color = col }
end

-- ---- fire audio ------------------------------------------------------
-- The engine renders a crackling "Fire" waveform into a gapless stream, so
-- the ambience runs without a retrigger gap. Street level raises the pitch
-- (a faster crackle) as the game gets harder.
local function update_fire_sound(dt)
  if state == "play" then
    if not fireOn then
      fireOn = true
      firePitchTimer = 0
      sound.loopPlay("Fire", 520, 0.16)
    end
    firePitchTimer = firePitchTimer - dt
    if firePitchTimer <= 0 then
      firePitchTimer = 0.35
      sound.loopPitch(430 + math.min(score, 900) * 0.55 + 35 * math.sin(time() * 1.7))
    end
  elseif fireOn then
    fireOn = false
    sound.loopStop()
  end
end

-- ---- spawning --------------------------------------------------------
local function spawn_victim()
  local floor = rand(1, #FLOOR_TOPS)
  local win = rand(1, #WINDOW_XS)
  local x = WINDOW_XS[win] + WINDOW_W / 2
  local y = FLOOR_TOPS[floor] + WINDOW_H - PERSON_H
  victims[#victims + 1] = {
    x = x, y = y,
    vy = 0, vx = 0,
    state = "wait",
    timer = 0.45 + rand(0, 80) / 100,
    bounces = 0,
    shirt = SHIRTS[rand(1, #SHIRTS)],
    seed = rand(0, 1000),
  }
end

-- ---- victim events ---------------------------------------------------
local function catch_victim(v)
  score = score + 1
  v.bounces = v.bounces + 1
  v.state = "bounce"
  v.y = NET_Y - PERSON_H
  v.vy = -(420 + math.min(v.bounces * 10, 90))
  v.vx = 165 + math.min(v.bounces * 12, 95)
  music.sound("Boing", 230 + math.min(v.bounces * 18, 130), 180)
  add_pop(v.x, NET_Y, colors.white)
end

local function rescue_victim(v)
  score = score + 5
  music.sound("Bell", 880, 160)
  music.sound("Bell", 1320, 320)
  add_pop(v.x, NET_Y + 20, colors.gold)
end

local function miss_victim(v)
  misses = misses + 1
  hurts[#hurts + 1] = {
    x = v.x,
    y = GROUND_Y - PERSON_H,
    timer = 1.1,
    shirt = v.shirt,
    seed = v.seed,
  }
  music.sound("Pew", 220, 220)
  add_pop(v.x, GROUND_Y - 10, colors.red)
end

-- ---- simulation ------------------------------------------------------
local function move_net(dt)
  local dir = 0
  if iskeydown("left") or iskeydown("a") or isgamepaddown("dpad_left") then dir = dir - 1 end
  if iskeydown("right") or iskeydown("d") or isgamepaddown("dpad_right") then dir = dir + 1 end
  dir = clamp(dir + pad_axis("leftx"), -1, 1)
  netX = clamp(netX + dir * NET_SPEED * dt, NET_MIN_X, NET_MAX_X)
end

local function step_victims(dt)
  local g = gravity()
  local i
  for i = #victims, 1, -1 do
    local v = victims[i]
    local oldY = v.y

    if v.state == "wait" then
      v.timer = v.timer - dt
      if v.timer <= 0 then
        v.state = "fall"
        v.vy = 40 + rand(0, 40)
        v.vx = rand(-14, 14)
      end
    else
      v.vy = v.vy + g * dt
      v.y = v.y + v.vy * dt
      v.x = v.x + v.vx * dt

      -- Catch on the downward crossing of the net plane, so the net has
      -- to be under the jumper at the right moment.
      if v.vy > 0
          and oldY + PERSON_H <= NET_Y
          and v.y + PERSON_H >= NET_Y
          and math.abs(v.x - netX) <= NET_HALF + 6 then
        catch_victim(v)
      elseif v.y + PERSON_H >= GROUND_Y then
        if v.x >= AMB_X - 12 then
          rescue_victim(v)
        else
          miss_victim(v)
        end
        table.remove(victims, i)
      elseif v.x > W + 60 or v.x < -60 then
        -- should not happen, but never leak an unreachable jumper
        rescue_victim(v)
        table.remove(victims, i)
      end
    end
  end
end

local function game_over()
  if state ~= "play" then return end
  state = "over"
  if score > highScore then highScore = score end
  victims = {}
  freezeTimer = 0
  nextBonus = 1
  sound.loopStop()
  fireOn = false
  music.sound("Siren", 600, 900)
  shake(500, 10)
end

local function check_bonus()
  if nextBonus <= #BONUS_AT and score >= BONUS_AT[nextBonus] then
    nextBonus = nextBonus + 1
    misses = 0
    freezeTimer = 2.0
    music.sound("Bell", 1046, 320)
    add_pop(W / 2, 190, colors.gold)
  end
end

local function reset_game()
  state = "play"
  score = 0
  misses = 0
  netX = W / 2
  victims = {}
  hurts = {}
  pops = {}
  spawnTimer = 1.2
  freezeTimer = 0
  nextBonus = 1
  fireOn = false
  firePitchTimer = 0
end

local function simulate(dt)
  if state == "play" then
    move_net(dt)

    if freezeTimer > 0 then
      freezeTimer = freezeTimer - dt
    else
      spawnTimer = spawnTimer - dt
      if spawnTimer <= 0 then
        local count = 1
        if score > 300 and rand(1, 100) <= 30 then count = 2 end
        local k
        for k = 1, count do
          if #victims < MAX_AIRBORNE then spawn_victim() end
        end
        spawnTimer = math.max(0.55, 1.85 - score * 0.0015)
        spawnTimer = spawnTimer + rand(-15, 20) / 100
        if spawnTimer < 0.45 then spawnTimer = 0.45 end
      end

      step_victims(dt)
      if misses >= MAX_MISSES then game_over() end
    end

    if state == "play" then check_bonus() end
  end

  -- injured people and pop rings animate in every state
  local i
  for i = #hurts, 1, -1 do
    local h = hurts[i]
    h.timer = h.timer - dt
    h.x = h.x + 52 * dt
    if h.timer <= 0 then table.remove(hurts, i) end
  end
  for i = #pops, 1, -1 do
    local p = pops[i]
    p.t = p.t + dt
    if p.t > 0.45 then table.remove(pops, i) end
  end

  update_fire_sound(dt)
end

-- ---- drawing the scene ----------------------------------------------
local STARS = {}
do
  local i
  for i = 1, 24 do
    STARS[i] = { x = rand(8, W - 8), y = rand(8, 150), tw = rand(0, 360) }
  end
end

local function draw_flame(cx, baseY, w, h, seed)
  local t = time()
  local flick = 0.78 + 0.22 * math.sin(t * 8.5 + seed * 1.73)
  local hh = h * flick
  local sway = math.sin(t * 6.1 + seed) * w * 0.10

  canvas.color = colors.red
  canvas.triangle(cx - w / 2, baseY, cx + w / 2, baseY, cx + sway, baseY - hh, true)
  canvas.color = colors.orange
  canvas.triangle(cx - w * 0.34, baseY, cx + w * 0.34, baseY,
                  cx + sway * 1.4, baseY - hh * 0.66, true)
  canvas.color = colors.yellow
  canvas.circle(cx, baseY - hh * 0.22, w * 0.14, true)
end

local function draw_background()
  canvas.color = colors.darkblue
  canvas.rectangle(0, 0, W, H, true)

  local t = time()
  local i
  for i = 1, #STARS do
    local s = STARS[i]
    if math.sin(t * 1.3 + s.tw) > -0.2 then
      canvas.color = colors.gray
      canvas.point(s.x, s.y)
    end
  end

  -- street
  canvas.color = colors.darkgray
  canvas.rectangle(0, GROUND_Y, W, H - GROUND_Y, true)
  canvas.color = colors.gray
  canvas.line(0, GROUND_Y, W, GROUND_Y, 2)
  canvas.color = colors.black
  canvas.line(0, GROUND_Y + 26, W, GROUND_Y + 26, 2)
end

local function draw_smoke()
  local t = time()
  local i
  for i = 1, 5 do
    local rise = (t * 22 + i * 54) % 230
    local sx = 92 + i * 42 + math.sin(t * 0.8 + i) * 16
    local sy = BUILD_Y - 6 - rise
    local r = 7 + i * 2
    -- a puff is a little cluster, not one clean ball
    canvas.color = colors.darkgray
    canvas.circle(sx, sy, r, true)
    canvas.circle(sx - r * 0.8, sy + r * 0.4, r * 0.7, true)
    canvas.circle(sx + r * 0.8, sy + r * 0.2, r * 0.6, true)
    canvas.color = colors.gray
    canvas.circle(sx + r * 0.2, sy - r * 0.3, r * 0.45, true)
  end
end

local function draw_building()
  -- smoke sits behind/above the roof
  draw_smoke()

  canvas.color = colors.darkbrown
  canvas.rectangle(BUILD_X, BUILD_Y, BUILD_W, BUILD_H, true)

  -- brick courses
  canvas.color = colors.maroon
  local y = BUILD_Y + 14
  local row = 0
  while y < GROUND_Y do
    canvas.line(BUILD_X + 2, y, BUILD_X + BUILD_W - 2, y)
    local x = BUILD_X + 18 + (row % 2) * 22
    while x < BUILD_X + BUILD_W - 8 do
      canvas.line(x, y, x, y + 16)
      x = x + 44
    end
    y = y + 17
    row = row + 1
  end

  -- roof
  canvas.color = colors.black
  canvas.rectangle(BUILD_X - 8, BUILD_Y - 10, BUILD_W + 16, 12, true)
  canvas.color = colors.darkgray
  canvas.rectangle(BUILD_X - 4, BUILD_Y - 6, BUILD_W + 8, 4, true)

  -- windows: orange glow with a flame inside each one
  local f, w
  for f = 1, #FLOOR_TOPS do
    for w = 1, #WINDOW_XS do
      local x = WINDOW_XS[w]
      local wy = FLOOR_TOPS[f]
      canvas.color = colors.black
      canvas.rectangle(x - 4, wy - 4, WINDOW_W + 8, WINDOW_H + 8, true)
      canvas.color = colors.orange
      canvas.rectangle(x, wy, WINDOW_W, WINDOW_H, true)
      canvas.color = colors.gold
      canvas.rectangle(x + 4, wy + WINDOW_H - 9, WINDOW_W - 8, 9, true)
      draw_flame(x + WINDOW_W / 2, wy + WINDOW_H, 30, 36, f * 7 + w * 3)
      canvas.color = colors.darkbrown
      canvas.line(x + WINDOW_W / 2, wy, x + WINDOW_W / 2, wy + WINDOW_H, 2)
      canvas.line(x, wy + WINDOW_H / 2, x + WINDOW_W, wy + WINDOW_H / 2, 2)
    end
  end
end

local function draw_ambulance()
  -- cabin and body
  canvas.color = colors.white
  canvas.rectangle(AMB_X, AMB_Y, AMB_W, AMB_H, true)
  canvas.color = colors.lightgray
  canvas.rectangle(AMB_X + 14, AMB_Y - 24, AMB_W - 42, 24, true)
  canvas.color = colors.skyblue
  canvas.rectangle(AMB_X + 20, AMB_Y - 19, 20, 14, true)

  -- red stripe and cross
  canvas.color = colors.red
  canvas.rectangle(AMB_X, AMB_Y + 10, AMB_W, 8, true)
  canvas.rectangle(AMB_X + 40, AMB_Y + 30, 22, 6, true)
  canvas.rectangle(AMB_X + 48, AMB_Y + 22, 6, 22, true)

  -- wheels
  canvas.color = colors.black
  canvas.circle(AMB_X + 18, GROUND_Y, 8, true)
  canvas.circle(AMB_X + 80, GROUND_Y, 8, true)
  canvas.color = colors.gray
  canvas.circle(AMB_X + 18, GROUND_Y, 3, true)
  canvas.circle(AMB_X + 80, GROUND_Y, 3, true)

  -- flashing roof light
  if math.floor(time() * 6) % 2 == 0 then
    canvas.color = colors.skyblue
  else
    canvas.color = colors.red
  end
  canvas.circle(AMB_X + 43, AMB_Y - 28, 5, true)
end

local function draw_person(x, y, shirt, mode, seed)
  local wig = math.sin(time() * 10 + seed) * 2

  -- legs
  canvas.color = colors.darkblue
  if mode == "bounce" then
    canvas.line(x - 2, y + 19, x - 9, y + 25, 2)
    canvas.line(x + 2, y + 19, x + 9, y + 25, 2)
  elseif mode == "fall" then
    canvas.line(x - 2, y + 19, x - 7, y + 26, 2)
    canvas.line(x + 2, y + 19, x + 7, y + 26, 2)
  else
    canvas.line(x - 2, y + 19, x - 4, y + 26, 2)
    canvas.line(x + 2, y + 19, x + 4, y + 26, 2)
  end

  -- body
  canvas.color = shirt
  canvas.rectangle(math.floor(x - 5), math.floor(y + 8), 10, 13, true)

  -- arms
  canvas.color = colors.beige
  if mode == "wait" then
    canvas.line(x - 4, y + 10, x - 10, y + 3 + wig, 2)
    canvas.line(x + 4, y + 10, x + 10, y + 3 - wig, 2)
  else
    canvas.line(x - 4, y + 10, x - 10, y + 2, 2)
    canvas.line(x + 4, y + 10, x + 10, y + 2, 2)
  end

  -- head and hair
  canvas.color = colors.beige
  canvas.circle(x, y + 4, 4, true)
  canvas.color = colors.black
  canvas.rectangle(math.floor(x - 4), math.floor(y), 8, 3, true)
end

local function draw_victim(v)
  draw_person(v.x, v.y, v.shirt, v.state, v.seed)
end

local function draw_hurt(h)
  draw_person(h.x, h.y, h.shirt, "wait", h.seed)
  canvas.color = colors.white
  canvas.circle(h.x + 4, h.y + 12, 3, true)
  canvas.color = colors.red
  canvas.line(h.x + 2, h.y + 12, h.x + 6, h.y + 12, 2)
  canvas.line(h.x + 4, h.y + 10, h.x + 4, h.y + 14, 2)
end

local function draw_fireman(x)
  -- legs
  canvas.color = colors.darkblue
  canvas.line(x - 4, GROUND_Y - 18, x - 6, GROUND_Y - 2, 4)
  canvas.line(x + 4, GROUND_Y - 18, x + 6, GROUND_Y - 2, 4)

  -- coat
  canvas.color = colors.yellow
  canvas.rectangle(x - 7, NET_Y + 24, 14, 30, true)
  canvas.color = colors.black
  canvas.rectangle(x - 7, NET_Y + 40, 14, 4, true)

  -- head and red helmet
  canvas.color = colors.beige
  canvas.circle(x, NET_Y + 17, 6, true)
  canvas.color = colors.red
  canvas.circle(x, NET_Y + 13, 7, true)
  canvas.rectangle(x - 8, NET_Y + 13, 16, 3, true)
end

local function draw_net()
  local left = netX - NET_HALF
  local right = netX + NET_HALF

  draw_fireman(netX - 34)
  draw_fireman(netX + 34)

  -- arms reaching up to the net
  canvas.color = colors.yellow
  canvas.line(netX - 34, NET_Y + 28, left + 8, NET_Y, 3)
  canvas.line(netX + 34, NET_Y + 28, right - 8, NET_Y, 3)

  -- the net: white bar with red stripes, so it reads at a glance
  canvas.color = colors.white
  canvas.rectangle(left, NET_Y - 5, right - left, 10, true)
  canvas.color = colors.red
  local x = left + 8
  while x < right - 4 do
    canvas.rectangle(math.floor(x), NET_Y - 5, 6, 10, true)
    x = x + 16
  end
  canvas.color = colors.lightgray
  canvas.line(left, NET_Y, right, NET_Y, 2)
end

local function draw_pops()
  local i
  for i = 1, #pops do
    local p = pops[i]
    local r = 4 + p.t * 70
    canvas.color = p.color
    canvas.circle(p.x, p.y, math.floor(r), false)
  end
end

local function draw_angel(x, y, alive)
  if alive then
    canvas.color = colors.white
  else
    canvas.color = colors.darkgray
  end
  canvas.circle(x, y - 2, 4, false)          -- halo
  canvas.circle(x, y + 7, 4, true)           -- head
  canvas.line(x - 4, y + 8, x - 12, y + 3, 2)
  canvas.line(x + 4, y + 8, x + 12, y + 3, 2)
  canvas.triangle(x - 6, y + 11, x + 6, y + 11, x, y + 23, true)
end

local function draw_hud()
  -- One line, because the roof runs across the second line at this height.
  local scoreText = "SCORE " .. score
  canvas.color = colors.white
  canvas.text(14, 10, scoreText)
  canvas.color = colors.silver
  canvas.text(14 + textwidth(scoreText) + 24, 10, "BEST " .. highScore)

  -- Keep the label clear of the first halo (the icons start at W - 104).
  canvas.color = colors.white
  canvas.text(W - 184, 22, "MISS")
  local i
  for i = 1, MAX_MISSES do
    draw_angel(W - 104 + (i - 1) * 32, 24, i <= MAX_MISSES - misses)
  end

  if state == "play" then
    if freezeTimer > 0 then
      canvas.color = colors.black
      canvas.rectangle(W / 2 - 132, 150, 264, 58, true)
      canvas.color = colors.maroon
      canvas.rectangle(W / 2 - 128, 154, 256, 50, false)
      bold_text("MISSES CLEARED!", 160, colors.gold)
      center_text("FREEZE!", 184, colors.white)
    elseif score > 0 then
      center_text("CATCH +1    RESCUE +5", H - 20, colors.silver)
    end
  end
end

local function draw_overlay()
  if state == "ready" then
    canvas.color = colors.black
    canvas.rectangle(70, 132, W - 140, 248, true)
    canvas.color = colors.maroon
    canvas.rectangle(74, 136, W - 148, 240, false)

    bold_text("FIRE", 154, colors.orange)
    center_text("A GAME & WATCH STYLE RESCUE", 186, colors.gold)
    center_text("LEFT / RIGHT or A / D  move the net", 232, colors.white)
    center_text("Catch the jumpers and bounce them", 258, colors.white)
    center_text("to the ambulance on the right.", 278, colors.white)
    center_text("3 misses end the game - 200 and 500 clear them.", 304, colors.silver)
    center_text("SPACE / ENTER  start        ESC  quit", 340, colors.yellow)
  elseif state == "over" then
    canvas.color = colors.black
    canvas.rectangle(110, 166, W - 220, 194, true)
    canvas.color = colors.maroon
    canvas.rectangle(114, 170, W - 228, 186, false)

    bold_text("GAME OVER", 188, colors.red)
    center_text("SCORE " .. score, 228, colors.white)
    center_text("BEST " .. highScore, 250, colors.gold)
    center_text("SPACE / ENTER  play again        ESC  quit", 296, colors.silver)
  end
end

-- Frame callback: the engine calls this once per frame, after update().
function draw()
  draw_background()
  draw_building()
  draw_ambulance()

  local i
  for i = 1, #victims do draw_victim(victims[i]) end
  for i = 1, #hurts do draw_hurt(hurts[i]) end

  draw_net()
  draw_pops()
  draw_hud()
  draw_overlay()
end

-- ---- boot and input --------------------------------------------------
state = "ready"
score = 0
highScore = 0
misses = 0
netX = W / 2
victims = {}
hurts = {}
pops = {}
spawnTimer = 1.2
freezeTimer = 0
nextBonus = 1
fireOn = false
firePitchTimer = 0

-- The top-level chunk returns here, so the engine takes the script over and
-- calls update(dt) then draw() once per frame.
function update(dt)
  if dt <= 0 then dt = 1 / 60 end
  if dt > 0.06 then dt = 0.06 end

  if iskeypressed("escape") then exit() end

  if state == "ready" or state == "over" then
    if iskeypressed("space") or iskeypressed("enter")
        or isgamepadpressed("a") or isgamepadpressed("start") then
      reset_game()
    end
  end

  simulate(dt)
end
