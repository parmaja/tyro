--======================================================================
--  King Valley - a desert treasure hunt for Tyro
--======================================================================
--  Built on the tilemap (tiles.*) and sprite (sprites.*) APIs and the
--  Part 1 engine features: sprite.flipH (right-facing frames are the left
--  frames mirrored), sound.play("sfx/*.wav") file SFX, the Kick/Snare/HiHat
--  drum waveforms via music.sound, and gamepad input (left stick / d-pad).
--
--  Each valley is a 20x16 grid of 16x16 desert tiles at scale 2: sand
--  floor, stone walls, a stepped sandstone pyramid, cacti and rocks.
--  Collect every vase and gem to clear the valley, then the next pyramid
--  opens.  A mummy that catches you costs a life; lose all three and the
--  run ends.  All five Kenney jingles are wired to the game states.
--
--  Controls:  ARROWS / WASD / left stick / d-pad   move
--             SPACE / ENTER / START / A            start / restart
--             ESC                                  quit
--  Run:  tyro games/kingvalley/kingvalley.tyro
--======================================================================

window.show(640, 512)

local W = canvas.width
local H = canvas.height

-- ---- tiles ----------------------------------------------------
-- Tile ids are 1-based into tiles.png (15 columns x 12 rows of 16x16,
-- "Cute Retro RPG - Grand Desert Demo", see CREDITS.txt).
local T = {
  SAND    = 17,   -- plain sand floor
  WALL    = 122,  -- grey stone block
  CACTUS  = 58,   -- big cactus
  CACTUS2 = 57,   -- small cactus cluster
  ROCK    = 43,   -- small dark rock
  VASE    = 27,   -- big jar (treasure)
  GEM     = 29,   -- gem (treasure)
}

-- The pyramid is a 5x6 slice of the sheet's left group (t001..t080);
-- -1 marks the two empty corners of the apex row.
local PYRAMID = {
  {-1,  2,  3,  4, -1},
  { 16, 17, 18, 19, 20},
  { 31, 32, 33, 34, 35},
  { 46, 47, 48, 49, 50},
  { 61, 62, 63, 64, 65},
  { 76, 77, 78, 79, 80},
}

-- ---- levels ---------------------------------------------------
-- '#' wall   '.' sand   'A' pyramid (5x6, top-left cell)
-- 'c' cactus 'r' rock   'V' vase    'G' gem
-- 'P' player start      'M' mummy
local LEVELS = {
  {
    "####################",
    "#..................#",
    "#..A...............#",
    "#..................#",
    "#..................#",
    "#..................#",
    "#..................#",
    "#..................#",
    "#....V....rr...G...#",
    "#..................#",
    "#.......c..........#",
    "#..P.........V.....#",
    "#..................#",
    "#.....r......c.....#",
    "#..V....M......M...#",
    "####################",
  },
  {
    "####################",
    "#..................#",
    "#.A................#",
    "#..................#",
    "#..................#",
    "#..................#",
    "#..................#",
    "#..................#",
    "#....r....V........#",
    "#..........c.......#",
    "#..V.........G.....#",
    "#.......M..........#",
    "#....c......r....M.#",
    "#..P..........V....#",
    "#.......G........M.#",
    "####################",
  },
  {
    "####################",
    "#..................#",
    "#.A..........c.....#",
    "#..................#",
    "#........r.........#",
    "#..................#",
    "#.........c........#",
    "#..................#",
    "#.....V....r.......#",
    "#............A.....#",
    "#..G....c.........G#",
    "#.....M....V.......#",
    "#..V........M......#",
    "#.......M...r......#",
    "#....P......M......#",
    "####################",
  },
}

local MAXLEVEL = #LEVELS
local COLS = #LEVELS[1][1]
local ROWS = #LEVELS[1]
local CELL = 32   -- 16px tiles at scale 2

-- ---- tilemaps -------------------------------------------------
local terrain = tiles.new("terrain")
terrain.load("tiles.png", 16, 16, 15, 0, 0)
terrain.resize(COLS, ROWS)
terrain.scale = 2

local over = tiles.new("over")
over.load("tiles.png", 16, 16, 15, 0, 0)
over.resize(COLS, ROWS)
over.scale = 2

-- ---- sprites --------------------------------------------------
-- player.sprite frames: 0-3 walk down, 4-7 walk left, 8-11 walk up.
-- Right-facing = the left frames drawn with flipH (Part 1d).
local PLAYER_BASE = {down = 0, left = 4, up = 8}
-- mummy.sprite frames: 0-2 N, 3-5 E, 6-8 S, 9-11 W (all four directions
-- exist in the sheet, so mummies use their real facing frames).
local MUMMY_BASE = {n = 0, e = 3, s = 6, w = 9}
local MAXMUMMY = 4

local player = Sprites.new("player")
player.load("player.sprite")
player.scale = 1

local mummyPool = {}
for i = 1, MAXMUMMY do
  local sp = Sprites.new("mummy" .. i)
  sp.load("mummy.sprite")
  sp.scale = 1
  sp.hide()
  mummyPool[i] = sp
end

-- ---- helpers --------------------------------------------------
local function beep(freq, ms)
  music.sound(freq, ms)
end

local function center_text(s, y, col)
  canvas.color = col
  canvas.text((W - textwidth(s)) / 2, y, s)
end

-- ---- state ----------------------------------------------------
local state            -- "title" | "play" | "done" | "over"
local level            -- current level index (1-based)
local rows             -- current level rows
local start            -- {c, r} player start cell
local walls            -- set, key = c * 100 + r
local decor            -- list of {c, r, tile} (cacti / rocks)
local treasures        -- list of {c, r, tile} not yet collected
local treasureTotal
local mummySpawns      -- list of {c, r}
local mummies          -- list of {c, r, face, step, t, sp}
local score, lives, msg, msgTimer, moveTimer, flashTimer, doneTimer

local function key(c, r) return c * 100 + r end
local function iswall(c, r)
  if c < 0 or r < 0 or c >= COLS or r >= ROWS then return true end
  return walls[key(c, r)] == true
end

local function set_player_frame()
  player.frame = PLAYER_BASE[player.face] + (player.tick % 4)
end

local function place_player()
  player.move(player.c * CELL + 4, player.r * CELL + 4)
end

-- ---- mummies --------------------------------------------------
local function buildMummies()
  mummies = {}
  for i = 1, #mummySpawns do
    local s = mummySpawns[i]
    local sp = mummyPool[i]
    mummies[i] = {c = s.c, r = s.r, face = 's', step = 0,
                  t = rand(25, 40) / 100, sp = sp}
    sp.show()
    sp.move(s.c * CELL + 4, s.r * CELL)
    sp.frame = MUMMY_BASE.s
  end
  for i = #mummySpawns + 1, MAXMUMMY do
    mummyPool[i].hide()
  end
end

local function mummy_step(m)
  local dx, dy = player.c - m.c, player.r - m.r
  local tries = {}
  if math.abs(dx) <= 4 and math.abs(dy) <= 4 then
    if dx ~= 0 then tries[#tries + 1] = {dx > 0 and 1 or -1, 0} end
    if dy ~= 0 then tries[#tries + 1] = {0, dy > 0 and 1 or -1} end
  end
  local dirs = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}}
  local d = dirs[rand(1, 4)]
  tries[#tries + 1] = {d[1], d[2]}
  for i = 1, #tries do
    local nc, nr = m.c + tries[i][1], m.r + tries[i][2]
    if not iswall(nc, nr) then
      m.c, m.r = nc, nr
      if tries[i][1] < 0 then m.face = 'w'
      elseif tries[i][1] > 0 then m.face = 'e'
      elseif tries[i][2] < 0 then m.face = 'n'
      else m.face = 's' end
      m.step = m.step + 1
      m.sp.move(nc * CELL + 4, nr * CELL)
      m.sp.frame = MUMMY_BASE[m.face] + (m.step % 3)
      return
    end
  end
end

-- ---- level load -----------------------------------------------
local function loadLevel(n)
  level = n
  rows = LEVELS[n]
  walls = {}
  decor = {}
  treasures = {}
  mummySpawns = {}
  start = {c = 1, r = 1}

  terrain.fill(T.SAND)
  over.clear()

  local r, c, ch, col, row
  for r = 1, ROWS do
    local line = rows[r]
    for c = 1, COLS do
      col = c - 1
      row = r - 1
      ch = line:sub(c, c)
      if ch == '#' then
        terrain.set(col, row, T.WALL)
        walls[key(col, row)] = true
      elseif ch == 'A' then
        for dy = 1, 6 do
          for dx = 1, 5 do
            local t = PYRAMID[dy][dx]
            if t > 0 then terrain.set(col + dx - 1, row + dy - 1, t) end
            walls[key(col + dx - 1, row + dy - 1)] = true
          end
        end
      elseif ch == 'c' then
        decor[#decor + 1] = {c = col, r = row, tile = T.CACTUS}
        walls[key(col, row)] = true
      elseif ch == 'r' then
        decor[#decor + 1] = {c = col, r = row, tile = T.ROCK}
        walls[key(col, row)] = true
      elseif ch == 'V' then
        treasures[#treasures + 1] = {c = col, r = row, tile = T.VASE}
      elseif ch == 'G' then
        treasures[#treasures + 1] = {c = col, r = row, tile = T.GEM}
      elseif ch == 'P' then
        start = {c = col, r = row}
      elseif ch == 'M' then
        mummySpawns[#mummySpawns + 1] = {c = col, r = row}
      end
    end
  end

  treasureTotal = #treasures
  player.c, player.r = start.c, start.r
  player.face = 'down'
  player.flipH = false
  player.tick = 0
  set_player_frame()
  place_player()
  buildMummies()
end

-- ---- gameplay -------------------------------------------------
local function respawn()
  player.c, player.r = start.c, start.r
  player.tick = 0
  set_player_frame()
  place_player()
  buildMummies()
end

local function level_done()
  score = score + 50
  state = "done"
  doneTimer = 2
  msg = "VALLEY CLEARED!"
  msgTimer = 2
  music.play("03 All Treasure Collected.mp3")
end

local function hit()
  if flashTimer > 0 then return end
  lives = lives - 1
  flashTimer = 0.6
  msg = "OUCH!"
  msgTimer = 1.0
  music.sound('Explode', 50, 250)
  shake(300, 8)
  if lives <= 0 then
    state = "over"
    music.play("05 Game Over.mp3")
  else
    respawn()
  end
end

local function try_move(dc, dr)
  local nc, nr = player.c + dc, player.r + dr
  if iswall(nc, nr) then
    beep(90, 40)
    return
  end
  player.c = nc
  player.r = nr
  if dc < 0 then
    player.face, player.flipH = 'left', false
  elseif dc > 0 then
    player.face, player.flipH = 'left', true   -- right = left frames + flipH
  elseif dr < 0 then
    player.face, player.flipH = 'up', false
  else
    player.face, player.flipH = 'down', false
  end
  player.tick = player.tick + 1
  set_player_frame()
  place_player()
  -- collect treasure on this cell
  local i
  for i = #treasures, 1, -1 do
    local t = treasures[i]
    if t.c == player.c and t.r == player.r then
      table.remove(treasures, i)
      score = score + 10
      sound.play("sfx/pickup.wav")
      music.sound('HiHat', 500, 80)
      if #treasures == 0 then
        level_done()
      end
    end
  end
end

local function read_input()
  if keyboard.down("left") or keyboard.down("a") then return -1, 0 end
  if keyboard.down("right") or keyboard.down("d") then return 1, 0 end
  if keyboard.down("up") or keyboard.down("w") then return 0, -1 end
  if keyboard.down("down") or keyboard.down("s") then return 0, 1 end
  -- gamepad (Part 1c): left stick first, then the d-pad
  local ax, ay = gamepad.axis("leftx"), gamepad.axis("lefty")
  if ax < -0.5 then return -1, 0 end
  if ax > 0.5 then return 1, 0 end
  if ay < -0.5 then return 0, -1 end
  if ay > 0.5 then return 0, 1 end
  if gamepad.down("dpad_left") then return -1, 0 end
  if gamepad.down("dpad_right") then return 1, 0 end
  if gamepad.down("dpad_up") then return 0, -1 end
  if gamepad.down("dpad_down") then return 0, 1 end
  return 0, 0
end

local function game_update(ft)
  if msgTimer > 0 then msgTimer = msgTimer - ft end
  if flashTimer > 0 then flashTimer = flashTimer - ft end
  if moveTimer > 0 then moveTimer = moveTimer - ft end

  if state == "play" then
    local dc, dr = read_input()
    if (dc ~= 0 or dr ~= 0) and moveTimer <= 0 then
      try_move(dc, dr)
      moveTimer = 0.11
    end

    for i = 1, #mummies do
      local m = mummies[i]
      m.t = m.t - ft
      if m.t <= 0 then
        m.t = rand(25, 40) / 100
        mummy_step(m)
      end
      if m.c == player.c and m.r == player.r then
        hit()
        return
      end
    end
  end
end

-- ---- rendering ------------------------------------------------
local function draw_hud()
  canvas.color = colors.silver
  canvas.text(8, 6, "LEVEL " .. level .. "/" .. MAXLEVEL)
  canvas.text(120, 6, "TREASURE " .. (treasureTotal - #treasures) .. "/" .. treasureTotal)
  canvas.text(280, 6, "SCORE " .. score)
  local i
  for i = 1, math.max(0, math.min(lives, 3)) do
    canvas.color = colors.red
    canvas.circle(W - 16 - (i - 1) * 18, 11, 6, true)
  end
  if msgTimer > 0 then
    center_text(msg, 40, colors.yellow)
  end
end

local function draw_over()
  over.clear()
  local i
  for i = 1, #decor do
    over.set(decor[i].c, decor[i].r, decor[i].tile)
  end
  for i = 1, #treasures do
    over.set(treasures[i].c, treasures[i].r, treasures[i].tile)
  end
  over.draw(0, 0)
end

local function draw_screen()
  canvas.color = colors.black
  canvas.clear()
  terrain.draw(0, 0)
  draw_over()
  draw_hud()

  if state == "title" then
    canvas.color = colors.black
    canvas.rectangle(0, 150, W, 190, true)
    center_text("KING VALLEY", 170, colors.yellow)
    center_text("COLLECT THE TREASURE, MIND THE MUMMIES", 212, colors.white)
    center_text("ARROWS / WASD / LEFT STICK  move", 250, colors.silver)
    center_text("PRESS SPACE TO START", 292, colors.white)
  elseif state == "over" then
    canvas.color = colors.black
    canvas.rectangle(0, 160, W, 170, true)
    if level >= MAXLEVEL and #treasures == 0 then
      center_text("ALL VALLEYS CLEARED!", 180, colors.yellow)
    else
      center_text("GAME OVER", 180, colors.red)
    end
    center_text("SCORE " .. score, 220, colors.white)
    center_text("PRESS SPACE TO PLAY AGAIN", 270, colors.silver)
  end
end

-- ---- boot -----------------------------------------------------
local function startGame()
  score = 0
  lives = 3
  msg = ""
  msgTimer = 0
  flashTimer = 0
  moveTimer = 0
  loadLevel(1)
  state = "play"
  msg = "LEVEL 1"
  msgTimer = 1.2
  music.play("02 Main Theme.mp3")
  music.sound('Kick', 60, 120)
end

score = 0
lives = 3
msg = ""
msgTimer = 0
flashTimer = 0
moveTimer = 0
doneTimer = 0
music.play("01 Game Start.mp3")
loadLevel(1)
state = "title"

function update(dt)
  local ft = dt
  if ft == nil or ft <= 0 then ft = 1 / 60 end
  if ft > 0.06 then ft = 0.06 end

  if keyboard.pressed("escape") then exit() end

  if state == "title" or state == "over" then
    if keyboard.pressed("space") or keyboard.pressed("enter")
       or gamepad.pressed("start") or gamepad.pressed("a") then
      startGame()
    end
  elseif state == "play" then
    game_update(ft)
  elseif state == "done" then
    doneTimer = doneTimer - ft
    if doneTimer <= 0 then
      if level < MAXLEVEL then
        music.play("04 Next Pyramid.mp3")
        loadLevel(level + 1)
        state = "play"
        msg = "LEVEL " .. level
        msgTimer = 1.2
      else
        state = "over"
        music.play("05 Game Over.mp3")
      end
    end
  end
end

function draw()
  draw_screen()
end

game_update = update
update = function(dt)
  local ft = dt
  if ft == nil or ft <= 0 then ft = 1 / 60 end
  if ft > 0.06 then ft = 0.06 end

  if keyboard.pressed("escape") then exit() end

  if state == "title" or state == "over" then
    if keyboard.pressed("space") or keyboard.pressed("enter")
       or gamepad.pressed("start") or gamepad.pressed("a") then
      startGame()
    end
  elseif state == "play" then
    if msgTimer > 0 then msgTimer = msgTimer - ft end
    if flashTimer > 0 then flashTimer = flashTimer - ft end
    if moveTimer > 0 then moveTimer = moveTimer - ft end
    local dc, dr = read_input()
    if (dc ~= 0 or dr ~= 0) and moveTimer <= 0 then
      try_move(dc, dr)
      moveTimer = 0.11
    end
    for i = 1, #mummies do
      local m = mummies[i]
      m.t = m.t - ft
      if m.t <= 0 then
        m.t = rand(25, 40) / 100
        mummy_step(m)
      end
      if m.c == player.c and m.r == player.r then
        hit()
        return
      end
    end
  elseif state == "done" then
    doneTimer = doneTimer - ft
    if doneTimer <= 0 then
      if level < MAXLEVEL then
        music.play("04 Next Pyramid.mp3")
        loadLevel(level + 1)
        state = "play"
        msg = "LEVEL " .. level
        msgTimer = 1.2
      else
        state = "over"
        music.play("05 Game Over.mp3")
      end
    end
  end
end

draw = function()
  draw_screen()
end
