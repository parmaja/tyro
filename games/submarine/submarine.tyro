--======================================================================
--  SUBMARINE - retro deep-sea rescue for the Tyro game engine
--======================================================================
--  You are the captain of a small yellow research submarine, and six
--  divers are lost somewhere in the deep. Swim down, pick them up and
--  bring every single one of them back to the surface alive.
--
--  Watch the tank: your oxygen burns all the time, and only the top of
--  the sea refills it. Sharks patrol the mid water, jellyfish float up
--  from the floor, drifting mines pop out of the bottom and, from
--  level 3, a dark red patrol sub hunts you and drops mines at your
--  depth. Torpedoes clear the way - a shark is one hit, a mine is worth
--  more, the patrol sub is armored and only a fool rams it.
--
--  Rescue all six divers to clear the level. Every level is deeper,
--  darker and busier than the last; four water palettes cycle.
--
--  Controls:  LEFT/RIGHT (or A/D)   cruise
--             UP/DOWN    (or W/S)   depth
--             SPACE      (or ENTER) fire torpedo
--             P                     pause
--             M                     mute / unmute
--             Q / E                 water shader strength
--             ESC                   quit
--
--  A gamepad works too: stick or d-pad moves, A fires.
--
--  An "attract.txt" file next to this script flips the title screen
--  into an attract mode: the demo captain plays by itself - classic
--  arcade behavior, and also how the automated tests play the game.
--
--  Run:  tyro games/submarine/submarine.tyro
--
--  Art, sound and design: original, generated by make_assets.py.
--======================================================================

window.show(960, 540)

local W, H = canvas.width, canvas.height

local SANDTOP = H - 44        -- top of the sea floor
local SURF    = 70            -- the waterline

-- attract mode: a file next to the script turns the title into a demo
local attract = false
do
  local f = openfile("attract.txt", "r")
  if f then f:close() attract = true end
end

math.randomseed(math.floor(millis() % 1000000))

-- ---- tiny helpers -----------------------------------------------------
local function clamp(v, lo, hi)
  if v < lo then return lo elseif v > hi then return hi else return v end
end

local function rnd(a, b)
  return a + (b - a) * math.random()
end

local function ri(a, b)
  return math.random(a, b)
end

local function sfx(name, volume)
  sound.play("sfx/" .. name .. ".wav", volume or 1.0)
end

local function aabb(ax, ay, ahw, ahh, bx, by, bhw, bhh)
  local dx = math.abs(ax - bx) - (ahw + bhw)
  local dy = math.abs(ay - by) - (ahh + bhh)
  return dx < 0 and dy < 0
end

-- place a sprite so its center sits at (cx, cy); Tyro sprite x/y is top-left
local function place(sp, cx, cy)
  local s = sp.scale or 1
  sp.x = cx - sp.width() * s / 2
  sp.y = cy - sp.height() * s / 2
end

-- sound cache: decode everything once, play as instant aliases -----
local SOUNDS = { "shoot", "boom", "pickup", "deliver", "warn",
                 "hit", "clear", "over", "sonar", "start" }
for _, n in ipairs(SOUNDS) do
  sound.load("sfx/" .. n .. ".wav")
end

local muted = false

-- ---- level palettes (cycle through the levels) ------------------------
local PALS = {
  { -- 1: tropical shallows
    skyA = colors.aqua,   skyB = colors.skyblue,
    seaA = colors.aqua,   seaB = colors.darkblue,
    sun  = colors.gold,   foam = colors.white,
    sand = colors.beige,  sand2 = colors.darkbrown,
    weed = colors.green,  weed2 = colors.lime,
  },
  { -- 2: sunset shelf
    skyA = colors.orange, skyB = colors.gold,
    seaA = colors.aqua,   seaB = colors.darkblue,
    sun  = colors.orange, foam = colors.yellow,
    sand = colors.brown,  sand2 = colors.darkbrown,
    weed = colors.darkgreen, weed2 = colors.olive,
  },
  { -- 3: cold depths
    skyA = colors.gray,   skyB = colors.silver,
    seaA = colors.blue,   seaB = colors.darkblue,
    sun  = colors.silver, foam = colors.white,
    sand = colors.gray,   sand2 = colors.darkgray,
    weed = colors.olive,  weed2 = colors.green,
  },
  { -- 4: midnight trench
    skyA = colors.darkblue, skyB = colors.darkpurple,
    seaA = colors.darkblue, seaB = colors.black,
    sun  = colors.silver,   foam = colors.white,
    sand = colors.darkgray, sand2 = colors.darkgray,
    weed = colors.olive,    weed2 = colors.darkgreen,
  },
}

-- torpedo hit values
local SCORE_SHARK, SCORE_JELLY, SCORE_MINE, SCORE_CHEST = 60, 40, 90, 250
local SCORE_PICKUP, SCORE_DEPOSIT = 50, 100

-- ---- pebbles on the sand -----------------------------------------------
local pebbles = {}
for i = 1, 26 do
  pebbles[i] = { x = rnd(10, W - 10), y = rnd(SANDTOP + 6, H - 8),
                 r = rnd(1.5, 4.5) }
end

-- ---- ambient bubbles ----------------------------------------------------
local amb = {}
for i = 1, 30 do
  amb[i] = { x = rnd(16, W - 16), y = rnd(SURF + 30, SANDTOP),
             r = rnd(1.5, 4),  spd = rnd(14, 34),
             amp = rnd(3, 10), ph = rnd(0, 6.28) }
end

-- ---- sprite pools -------------------------------------------------------
-- Sprites are engine objects the engine draws every frame. Nothing is
-- created or destroyed mid-game: every entity draws from a fixed pool,
-- hidden while idle.

local subSpr
local torps, sharks, jellies, patrols, mines, divers, booms, weeds, rocks
local chest

-- player -----------------------------------------------------------------
subSpr = Sprites.new("sub0")
subSpr.load("img/sub.sprite")
subSpr.layer = 5
subSpr.play(10)
subSpr.hide()
place(subSpr, W / 2, SURF + 40)

-- torpedo pool
torps = {}
for i = 1, 3 do
  local sp = Sprites.new("torp" .. i)
  sp.load("img/torpedo.png")
  sp.hide()
  sp.layer = 6
  torps[i] = { sp = sp, live = false, x = 0, y = 0, dir = 1 }
end

-- sharks -------------------------------------------------------------------
sharks = {}
for i = 1, 6 do
  local sp = Sprites.new("shark" .. i)
  sp.load("img/shark.sprite")
  sp.layer = 2
  sp.hide()
  sharks[i] = { sp = sp, live = false }
end

-- jellyfish -----------------------------------------------------------------
jellies = {}
for i = 1, 4 do
  local sp = Sprites.new("jelly" .. i)
  sp.load("img/jelly.sprite")
  sp.layer = 2
  sp.hide()
  jellies[i] = { sp = sp, live = false }
end

-- patrol subs ----------------------------------------------------------------
patrols = {}
for i = 1, 2 do
  local sp = Sprites.new("patrol" .. i)
  sp.load("img/patrol.sprite")
  sp.layer = 2
  sp.hide()
  patrols[i] = { sp = sp, live = false }
end

-- mines -----------------------------------------------------------------------
mines = {}
for i = 1, 8 do
  local sp = Sprites.new("mine" .. i)
  sp.load("img/mine.sprite")
  sp.layer = 3
  sp.hide()
  mines[i] = { sp = sp, live = false }
end

-- divers -----------------------------------------------------------------------
divers = {}
for i = 1, 3 do
  local sp = Sprites.new("diver" .. i)
  sp.load("img/diver.sprite")
  sp.layer = 1
  sp.hide()
  divers[i] = { sp = sp, live = false }
end

-- treasure chest ----------------------------------------------------------------
chest = { sp = Sprites.new("chest"), live = false }
chest.sp.load("img/chest.png")
chest.sp.layer = 1
chest.sp.hide()

-- explosions ----------------------------------------------------------------------
booms = {}
for i = 1, 6 do
  local sp = Sprites.new("boom" .. i)
  sp.load("img/boom.sprite")
  sp.layer = 10
  sp.hide()
  booms[i] = { sp = sp, live = false, age = 0 }
end

-- decor: kelp, corals, rocks, stars -------------------------------------------------
weeds = {}
for i = 1, 10 do
  local sp = Sprites.new("weed" .. i)
  sp.load("img/seaweed.sprite")
  sp.layer = -5
  sp.hide()
  weeds[i] = { sp = sp }
end
rocks = {}
for i = 1, 6 do
  local sp = Sprites.new("decor" .. i)
  sp.layer = -4
  sp.hide()
  local eccentric = i % 4
  local kind = "star"
  if eccentric == 1 then kind = "rock"
  elseif eccentric == 2 then kind = "coral" end
  if kind == "rock" then sp.load("img/rock.png")
  elseif kind == "coral" then sp.load("img/coral.png")
  else sp.load("img/star.png") end
  rocks[i] = { sp = sp, kind = kind }
end

local function pool_find(list)
  for _, e in ipairs(list) do
    if not e.live then return e end
  end
  return nil
end

local function boom_at(x, y, scale)
  local b = pool_find(booms)
  if not b then return end
  b.live = true
  b.age = 0
  b.scale = scale or 1.5
  b.sp.scale = b.scale
  b.sp:play(14)
  b.sp.show()
  place(b.sp, x, y)
end

-- ---- music & ambience ---------------------------------------------------
local music_theme =
  "t112 l8 v90 ml o4 e g b o5 c b g e r f a o5 c a f d r e o4 a b g e c < g b < c r e f r" ..
  "o4 g b o5 c o4 e g b o5 c b g e r f a o5 d c a f r a b o4 c d e r2"
local THEME_SECONDS = 16.5

local tMusic = 0
local function play_theme()
  if not muted then
    music.mml(music_theme)
    tMusic = THEME_SECONDS
  end
end

local function stop_theme()
  sound.loopStop()
end

local engineOn = false
local function engine(on)
  if on == engineOn then return end
  engineOn = on
  if on and not muted and not attract then
    sound.loopPlay("Engine", 58, 0.055)
  else
    if not on then sound.loopStop() end
  end
end

-- ---- run state ----------------------------------------------------------
local state = "title"      -- title | ready | play | dying | clear | over
local stime = 0
local paused = false
local time0 = 0

local level, score, lives = 1, 0, 3
local o2, carried, banked = 100, 0, 0
local diversNeed = 6

local subx, suby = W / 2, SURF + 40
local subdir = 1
local invuln = 0
local fireCd = 0

local highscore = 0
do
  local f = openfile("highscore.txt", "r")
  if f then
    local s = f:read("l") or "0"
    f:close()
    highscore = tonumber((s:match("%d+"))) or 0
  end
end

-- director timers
local tShark, tJelly, tMine, tPatrol, tChest, tDiver = 2, 10, 6, 20, 12, 1.5
local tWarn, tSonar, tBubble, tDeposit = 0, 6, 0.08, 0.3

local floaters = {}
local function floater(x, y, text, color)
  floaters[#floaters + 1] = { x = x, y = y, text = text, age = 0,
                              color = color or colors.gold }
  if #floaters > 14 then table.remove(floaters, 1) end
end

-- ---- the water shader ----------------------------------------------------
shader.load("underwater.frag")
shader.value = 0.75
shader.area = { 0, 0, W, H }

-- ---- decor dressing ------------------------------------------------------
local function dress_level()
  local pal = PALS[((level - 1) % #PALS) + 1]
  for _, w in ipairs(weeds) do
    w.sp.show()
    w.sp.tint = (math.random() < 0.5) and pal.weed or pal.weed2
    local s = rnd(0.85, 1.6)
    w.sp.scale = s
    local h = w.sp.height() * s
    w.sp.x = rnd(24, W - 24)
    w.sp.y = SANDTOP + 6 - h
    w.sp:play(rnd(3, 6))
  end
  for _, r in ipairs(rocks) do
    r.sp.show()
    local s = rnd(0.9, 1.7)
    r.sp.scale = s
    local w = r.sp.width() * s
    if r.kind == "star" then
      place(r.sp, rnd(30, W - 30), rnd(SANDTOP - 26, H - 16))
    else
      place(r.sp, rnd(30, W - 30), SANDTOP + rnd(2, 12))
    end
  end
end

-- ---- state transitions ---------------------------------------------------
local function spawn_cap()
  return math.min(4 + level, 9)
end

-- park every live entity (called between missions)
local function clear_entities()
  subSpr.hide()
  for _, list in ipairs({ torps, sharks, jellies, patrols, mines, divers, booms }) do
    for _, e in ipairs(list) do
      e.live = false
      e.sp.hide()
    end
  end
  chest.live = false
  chest.sp.hide()
end

local function reset_level()
  banked = 0
  o2 = 100
  carried = 0
  subx, suby = W / 2, SURF + 36
  subdir = 1
  invuln = 1.2
  fireCd = 0
  tShark, tJelly, tMine, tPatrol, tChest, tDiver = 2.5, 8, 5, 14, 10, 1.2
  tWarn, tSonar, tBubble, tDeposit = 0, 7, 0.08, 0.3
  clear_entities()
  dress_level()
end

local function set_state(s)
  state = s
  stime = 0
  if s == "play" then
    engine(true)
    if not attract then play_theme() end
  elseif s == "title" then
    engine(false)
    stop_theme()
  elseif s == "clear" then
    sfx("clear", 1.0)
    stop_theme()
    engine(false)
  elseif s == "over" then
    sfx("over", 1.0)
    stop_theme()
    engine(false)
    if not attract and score > highscore then
      highscore = score
      local f = openfile("highscore.txt", "w")
      if f then
        f:write(tostring(score) .. "\n")
        f:close()
      end
    end
  end
end

local function start_game()
  level, score, lives = 1, 0, 3
  reset_level()
  set_state("ready")
  sfx("start", 0.9)
  subSpr.show()
  subSpr.visible = true
  place(subSpr, subx, suby)
end

-- ---- spawning -----------------------------------------------------------
local function enemy_slots()
  local n = 0
  for _, list in ipairs({ sharks, jellies, patrols }) do
    for _, e in ipairs(list) do
      if e.live then n = n + 1 end
    end
  end
  return n
end

local function spawn_torpedo()
  if fireCd > 0 then return end
  for _, e in ipairs(torps) do
    if e.live then return end         -- seaquest: one fish in the tube
  end
  local t = pool_find(torps)
  if not t then return end
  t.live = true
  t.x = subx + subdir * 26
  t.y = suby + 2
  t.dir = subdir
  t.sp.flipH = subdir < 0
  t.sp.show()
  place(t.sp, t.x, t.y)
  sfx("shoot", 0.85)
  fireCd = 0.5
end

local function spawn_shark()
  local e = pool_find(sharks)
  if not e then return end
  e.live = true
  e.dir = math.random() < 0.5 and 1 or -1
  e.x = e.dir == 1 and -50 or W + 50
  e.speed = math.min(rnd(40, 72) + level * 6, 150)
  e.y0 = rnd(SURF + 70, SANDTOP - 40)
  e.y = e.y0
  e.ph = rnd(0, 6.28)
  e.amp = rnd(4, 14)
  e.t = rnd(1.5, 4)
  e.sp.show()
  e.sp.flipH = e.dir < 0
  e.sp.scale = 1
  place(e.sp, e.x, e.y)
  e.sp:play(rnd(7, 11))
end

local function spawn_jelly()
  local e = pool_find(jellies)
  if not e then return end
  e.live = true
  e.x = rnd(60, W - 60)
  e.y = SANDTOP - 6
  e.vy = -(11 + level * 1.4)
  e.vx = rnd(-9, 9)
  e.sp.show()
  e.sp.scale = 1.15
  place(e.sp, e.x, e.y)
  e.sp:play(4)
end

local function spawn_patrol()
  local e = pool_find(patrols)
  if not e then return end
  e.live = true
  e.dir = subx > W / 2 and -1 or 1     -- attack from behind the player
  e.x = e.dir == -1 and W + 60 or -60
  e.y = clamp(rnd(suby - 60, suby + 60), SURF + 80, SANDTOP - 30)
  e.speed = 55 + level * 4
  e.mineT = rnd(2.5, 4)
  e.sp.show()
  e.sp.flipH = e.dir > 0               -- art faces left
  e.sp.scale = 1
  place(e.sp, e.x, e.y)
  e.sp:play(8)
end

local function spawn_mine(px, py)
  local e = pool_find(mines)
  if not e then return end
  e.live = true
  e.x = px or rnd(40, W - 40)
  e.y = py or SANDTOP - 4
  e.vy = -(8 + level)
  e.vx = rnd(-10, 10)
  e.sp.show()
  e.sp.scale = 1
  e.sp:play(2)
  place(e.sp, e.x, e.y)
end

local function spawn_diver()
  local e = pool_find(divers)
  if not e then return end
  e.live = true
  e.dir = math.random() < 0.5 and 1 or -1
  e.x = rnd(90, W - 90)
  e.y0 = rnd(SURF + 60, SANDTOP - 36)
  e.y = e.y0
  e.speed = rnd(13, 22)
  e.ph = rnd(0, 6.28)
  e.turn = rnd(4, 8)
  e.sp.show()
  e.sp.flipH = e.dir < 0
  e.sp.scale = 1.1
  place(e.sp, e.x, e.y)
  e.sp:play(5)
end

local function spawn_chest()
  if chest.live then return end
  chest.live = true
  chest.x = rnd(60, W - 60)
  chest.y = SANDTOP + 10
  chest.vy = -26
  chest.sp.show()
  chest.sp.scale = 1.2
  place(chest.sp, chest.x, chest.y)
end

-- ---- combat results ------------------------------------------------------
local function kill_enemy(e, points, x, y)
  boom_at(x, y, 1.3)
  shake(180, 9)
  score = score + points
  floater(x, y - 14, "+" .. points)
  sfx("boom", 0.9)
end

local function player_hit()
  if invuln > 0 or state ~= "play" then return end
  boom_at(subx, suby, 2.2)
  shake(600, 26)
  sfx("boom", 1.0)
  carried = 0                 -- the divers swim away in the blast
  o2 = math.max(0, o2 - 22)
  lives = lives - 1
  invuln = 0
  subSpr.hide()
  set_state("dying")
end

-- ---- entity updates ------------------------------------------------------
local function update_player(dt, dx, dy, fire)
  if dx > 0 then subdir = 1 elseif dx < 0 then subdir = -1 end

  subx = clamp(subx + dx * 158 * dt, 26, W - 26)
  suby = clamp(suby + dy * 118 * dt, SURF + 26, SANDTOP - 12)

  -- engine wash bubbles while the boat moves
  tBubble = tBubble - dt
  if tBubble <= 0 and (dx ~= 0 or dy ~= 0) then
    tBubble = 0.06
    for i = 1, ri(1, 2) do
      amb[#amb + 1] = { x = subx - subdir * 26 + rnd(-3, 3), y = suby + rnd(-3, 3),
                        r = rnd(1, 2.4), spd = rnd(30, 60),
                        amp = rnd(2, 5), ph = rnd(0, 6.28) }
      if #amb > 60 then table.remove(amb, 1) end
    end
  end

  fireCd = fireCd - dt
  if fire then spawn_torpedo() end

  -- oxygen
  local surfaced = suby <= SURF + 40
  if surfaced then
    o2 = math.min(100, o2 + 42 * dt)
    if math.random() < 0.10 then
      music.sound("Bubble", ri(600, 1100), 80)
    end
  else
    o2 = o2 - (1.45 + level * 0.07) * dt
    if o2 < 30 then
      tWarn = tWarn - dt
      if tWarn <= 0 and o2 > 0 then
        tWarn = 2.4
        sfx("warn", 0.8)
      end
    end
    if o2 <= 0 then
      player_hit()   -- the tank ran dry
      return
    end
  end

  -- surface deposit line: one diver every short beat
  if surfaced and carried > 0 then
    tDeposit = tDeposit - dt
    if tDeposit <= 0 then
      tDeposit = 0.38
      carried = carried - 1
      banked = banked + 1
      score = score + SCORE_DEPOSIT
      floater(subx, suby - 26, "RESCUED +" .. SCORE_DEPOSIT, colors.skyblue)
      sfx("deliver", 0.9)
      if banked >= diversNeed then
        score = score + 400 + level * 100
        set_state("clear")
      end
    end
  end

  invuln = math.max(0, invuln - dt)
  if invuln > 0 then
    subSpr.visible = (math.floor(time0 * 12) % 2) == 0
  else
    subSpr.visible = true
  end
  place(subSpr, subx, suby)
  subSpr.angle = clamp(dy * 14 + math.sin(time0 * 2.2) * 1.5, -18, 18)
  subSpr.flipH = subdir < 0
end

local function update_torps(dt)
  for _, t in ipairs(torps) do
    if t.live then
      t.x = t.x + t.dir * 340 * dt
      if t.x < -30 or t.x > W + 30 then
        t.live = false
        t.sp.hide()
      else
        place(t.sp, t.x, t.y)
      end
    end
  end
end

local function update_sharks(dt)
  for _, e in ipairs(sharks) do
    if e.live then
      e.t = e.t - dt
      if e.t <= 0 and level >= 4 then
        -- deep-sharks sniff the submarine
        e.t = rnd(1.2, 3)
        e.y0 = clamp(e.y0 + (suby > e.y0 and 30 or -30), SURF + 60, SANDTOP - 34)
      end
      e.x = e.x + e.dir * e.speed * dt
      e.ph = e.ph + dt * 1.6
      e.y = e.y0 + math.sin(e.ph) * e.amp
      if e.x < -70 or e.x > W + 70 then
        e.live = false
        e.sp.hide()
      else
        place(e.sp, e.x, e.y)
      end
    end
  end
end

local function update_jellies(dt)
  for _, e in ipairs(jellies) do
    if e.live then
      e.y = e.y + e.vy * dt
      e.x = clamp(e.x + e.vx * dt + math.sin(e.y * 0.05) * 4 * dt, 24, W - 24)
      if e.y < SURF + 34 then
        e.live = false
        e.sp.hide()
      else
        place(e.sp, e.x, e.y)
      end
    end
  end
end

local function update_patrols(dt)
  for _, e in ipairs(patrols) do
    if e.live then
      e.x = e.x + e.dir * e.speed * dt
      e.y = e.y + math.sin(e.x * 0.02) * 6 * dt
      e.mineT = e.mineT - dt
      if e.mineT <= 0 then
        e.mineT = rnd(4, 6.5)
        spawn_mine(e.x - e.dir * 20, e.y + 12)
      end
      if e.x < -80 or e.x > W + 80 then
        e.live = false
        e.sp.hide()
      else
        place(e.sp, e.x, e.y)
      end
    end
  end
end

local function update_mines(dt)
  for _, e in ipairs(mines) do
    if e.live then
      e.y = e.y + e.vy * dt
      e.x = e.x + e.vx * dt + math.sin(e.y * 0.09) * 5 * dt
      if e.y < SURF + 30 then
        e.live = false
        e.sp.hide()
      else
        place(e.sp, e.x, e.y)
      end
    end
  end
end

local function update_divers(dt)
  for _, e in ipairs(divers) do
    if e.live then
      e.turn = e.turn - dt
      if e.turn <= 0 then
        e.turn = rnd(3, 7)
        if math.random() < 0.4 then e.dir = -e.dir end
        e.y0 = clamp(e.y0 + rnd(-30, 30), SURF + 55, SANDTOP - 34)
      end
      e.x = e.x + e.dir * e.speed * dt
      if e.x < 70 then e.dir = 1 elseif e.x > W - 70 then e.dir = -1 end
      e.y = e.y0 + math.sin(time0 * 1.5 + e.ph) * 6
      e.sp.flipH = e.dir < 0
      place(e.sp, e.x, e.y)
    end
  end
end

local function update_chest(dt)
  if not chest.live then return end
  chest.y = chest.y + chest.vy * dt
  if chest.y < SURF + 46 then
    chest.live = false
    chest.sp.hide()
  else
    place(chest.sp, chest.x, chest.y)
  end
end

local function update_booms(dt)
  for _, b in ipairs(booms) do
    if b.live then
      b.age = b.age + dt
      if b.age > 0.62 then
        b.live = false
        b.sp.hide()
      end
    end
  end
end

local function update_amb(dt)
  for _, b in ipairs(amb) do
    b.y = b.y - b.spd * dt
    b.x = b.x + math.sin(time0 * 2 + b.ph) * b.amp * dt
    if b.y < SURF + 8 then
      b.y = SANDTOP - rnd(4, 20)
      b.x = rnd(16, W - 16)
    end
  end
end

-- ---- collisions ----------------------------------------------------------
local function check_collisions()
  local hit = false

  for _, t in ipairs(torps) do
    if t.live then
      local used = false
      for _, e in ipairs(sharks) do
        if not used and e.live and aabb(t.x, t.y, 8, 3, e.x, e.y, 20, 8) then
          used = true
          kill_enemy(e, SCORE_SHARK, e.x, e.y)
          e.live = false e.sp.hide()
        end
      end
      if not used then
        for _, e in ipairs(jellies) do
          if not used and e.live and aabb(t.x, t.y, 8, 3, e.x, e.y, 8, 11) then
            used = true
            kill_enemy(e, SCORE_JELLY, e.x, e.y)
            e.live = false e.sp.hide()
          end
        end
      end
      if not used then
        for _, e in ipairs(mines) do
          if not used and e.live and aabb(t.x, t.y, 8, 3, e.x, e.y, 9, 9) then
            used = true
            kill_enemy(e, SCORE_MINE, e.x, e.y)
            e.live = false e.sp.hide()
          end
        end
      end
      if not used then
        for _, e in ipairs(patrols) do
          if e.live and aabb(t.x, t.y, 8, 3, e.x, e.y, 24, 8) then
            used = true
            boom_at(t.x, t.y, 1.0)      -- small burst: the armor held
            floater(t.x, t.y, "armored!", colors.red)
          end
        end
      end
      if used then
        t.live = false
        t.sp.hide()
      end
    end
  end

  if invuln <= 0 then
    for _, e in ipairs(sharks) do
      if not hit and e.live and aabb(subx, suby, 19, 8, e.x, e.y, 20, 8) then
        e.live = false e.sp.hide()
        hit = true
      end
    end
    for _, e in ipairs(jellies) do
      if not hit and e.live and aabb(subx, suby, 19, 8, e.x, e.y, 8, 11) then
        e.live = false e.sp.hide()
        hit = true
      end
    end
    for _, e in ipairs(mines) do
      if not hit and e.live and aabb(subx, suby, 19, 8, e.x, e.y, 9, 9) then
        e.live = false e.sp.hide()
        hit = true
      end
    end
    for _, e in ipairs(patrols) do
      if not hit and e.live and aabb(subx, suby, 19, 8, e.x, e.y, 24, 8) then
        hit = true
      end
    end
  end
  if hit then player_hit() end

  -- pickups
  for _, e in ipairs(divers) do
    if e.live and carried < diversNeed and aabb(subx, suby, 26, 8, e.x, e.y, 10, 6) then
      e.live = false
      e.sp.hide()
      carried = carried + 1
      score = score + SCORE_PICKUP
      floater(e.x, e.y - 12, "DIVER +50", colors.orange)
      sfx("pickup", 0.9)
    end
  end
  if chest.live and aabb(subx, suby, 26, 10, chest.x, chest.y, 10, 7) then
    chest.live = false
    chest.sp.hide()
    score = score + SCORE_CHEST
    o2 = math.min(100, o2 + 10)
    floater(chest.x, chest.y - 12, "+250")
    sfx("pickup", 1.0)
  end
end

-- ---- the spawn director ---------------------------------------------------
local function update_director(dt)
  tShark = tShark - dt
  tDiver = tDiver - dt
  tChest = tChest - dt
  local tide = math.max(1.0, 3.3 - level * 0.26)

  if tShark <= 0 and enemy_slots() < spawn_cap() then
    tShark = tide
    spawn_shark()
  end

  if level >= 2 then
    tJelly = tJelly - dt
    if tJelly <= 0 then
      tJelly = math.max(3.2, 8.5 - level * 0.5)
      spawn_jelly()
    end
    tMine = tMine - dt
    if tMine <= 0 then
      tMine = math.max(2.6, 6.4 - level * 0.32)
      spawn_mine()
    end
  end

  if level >= 3 then
    tPatrol = tPatrol - dt
    if tPatrol <= 0 and enemy_slots() < spawn_cap() then
      tPatrol = 13
      spawn_patrol()
    end
  end

  if tDiver <= 0 then
    tDiver = math.max(2.2, 4.6 - level * 0.22)
    local n = 0
    for _, e in ipairs(divers) do
      if e.live then n = n + 1 end
    end
    if n < 2 and carried + banked < diversNeed then spawn_diver() end
  end

  if tChest <= 0 then
    tChest = rnd(15, 26)
    spawn_chest()
  end
end

local function update_floaters(dt)
  for i = #floaters, 1, -1 do
    local f = floaters[i]
    f.age = f.age + dt
    f.y = f.y - 18 * dt
    if f.age > 1.1 then table.remove(floaters, i) end
  end
end

-- ---- attract autopilot ----------------------------------------------------
local function autopilot()
  local dx, dy, fire = 0.4, 0, false

  if carried >= diversNeed or o2 < 26 then
    -- home for the surface
    dx = 0.35
    dy = -1
  else
    local target, best = nil, 1e9
    for _, e in ipairs(divers) do
      if e.live then
        local d = (e.x - subx) ^ 2 + (e.y - suby) ^ 2
        if d < best then best = d target = e end
      end
    end
    if target then
      dx = (target.x > subx + 8) and 1 or ((target.x < subx - 8) and -1 or 0)
      dy = (target.y > suby + 8) and 1 or ((target.y < suby - 8) and -1 or 0)
      if dx == 0 and dy == 0 then dy = 0.2 end
    else
      dy = math.sin(time0 * 0.6) > 0 and 0.4 or -0.4
    end
  end

  -- dodge the closest live threat sharing the depth band
  local dodge, closest = nil, 1e9
  for _, list in ipairs({ sharks, jellies, mines, patrols }) do
    for _, e in ipairs(list) do
      if e.live then
        local ddx = math.abs(e.x - subx)
        if ddx < closest and math.abs(e.y - suby) < 46 then
          closest = ddx
          dodge = e
        end
      end
    end
  end
  if dodge and closest < 110 then
    dy = dodge.y > suby and -1 or 1
    dx = dodge.x > subx and -0.5 or 0.2
  end

  -- shoot what swims at nose level ahead of us
  for _, list in ipairs({ sharks, mines, jellies }) do
    for _, e in ipairs(list) do
      if e.live and math.abs(e.y - suby) < 16
         and (e.x - subx) * subdir > 0 and math.abs(e.x - subx) < 240
         and fireCd <= 0 then
        fire = true
      end
    end
  end
  return dx, dy, fire
end

-- ---- input -----------------------------------------------------------------
local function human_input()
  local dx, dy, fire = 0, 0, false
  if keyboard.down("left") or keyboard.down("a") then dx = dx - 1 end
  if keyboard.down("right") or keyboard.down("d") then dx = dx + 1 end
  if keyboard.down("up") or keyboard.down("w") then dy = dy - 1 end
  if keyboard.down("down") or keyboard.down("s") then dy = dy + 1 end
  if keyboard.down("space") or keyboard.down("enter") then fire = true end
  if gamepad.available() then
    local ax, ay = gamepad.axis("leftx"), gamepad.axis("lefty")
    if math.abs(ax) > 0.25 then dx = dx + ax end
    if math.abs(ay) > 0.25 then dy = dy + ay end
    if gamepad.down("a") or gamepad.down("b") then fire = true end
  end
  return dx, dy, fire
end

-- ---- one frame ---------------------------------------------------------------
local function step_state(dt)
  stime = stime + dt

  if state == "title" then
    if keyboard.pressed("space") or keyboard.pressed("enter")
       or gamepad.pressed("start") or gamepad.pressed("a") then
      start_game()
    elseif attract and stime > 3 then
      start_game()
    end
  elseif state == "ready" then
    if stime > 2.4 or keyboard.pressed("space") then
      set_state("play")
    end
  elseif state == "play" then
    -- handled in update()
  elseif state == "dying" then
    if stime > 1.5 then
      if lives <= 0 then
        set_state("over")
      else
        subx, suby = W / 2, SURF + 36
        subdir = 1
        invuln = 2.6
        o2 = math.max(o2, 60)      -- fresh breath at the dock
        set_state("play")
        subSpr.show()
        place(subSpr, subx, suby)
      end
    end
  elseif state == "clear" then
    if stime > 3.2 then
      level = level + 1
      reset_level()
      set_state("ready")
      subSpr.show()
      subSpr.visible = true
      place(subSpr, subx, suby)
    end
  elseif state == "over" then
    if (stime > 1.2 and (keyboard.pressed("space") or keyboard.pressed("enter")
        or gamepad.pressed("start"))) or (attract and stime > 5) then
      set_state("title")
    end
  end
end

function update(dt)
  if dt <= 0 then dt = 1 / 60 end
  if dt > 0.08 then dt = 0.08 end
  time0 = time0 + dt

  if keyboard.pressed("escape") then exit() end
  if keyboard.pressed("p") and state == "play" then
    paused = not paused
  end
  if keyboard.pressed("m") then
    muted = not muted
    if muted then
      stop_theme()
    elseif state == "play" then
      play_theme()
      engine(false) engine(true)
    end
  end
  if keyboard.pressed("q") then
    shader.value = clamp(shader.value - 0.1, 0, 1)
  elseif keyboard.pressed("e") then
    shader.value = clamp(shader.value + 0.1, 0, 1)
  end

  step_state(dt)

  tSonar = tSonar - dt
  if tSonar <= 0 and state == "play" then
    tSonar = rnd(7, 12)
    sfx("sonar", 0.5)
  end
  if tMusic > 0 then
    tMusic = tMusic - dt
    if tMusic <= 0 and state == "play" and not attract and not muted then
      tMusic = THEME_SECONDS
      music.mml(music_theme)
    end
  end

  if paused then return end

  if state == "play" then
    update_director(dt)
    local dx, dy, fire
    if attract then
      dx, dy, fire = autopilot()
    else
      dx, dy, fire = human_input()
    end
    update_player(dt, dx, dy, fire)
    update_torps(dt)
    update_sharks(dt)
    update_jellies(dt)
    update_patrols(dt)
    update_mines(dt)
    update_divers(dt)
    update_chest(dt)
    update_booms(dt)
    update_amb(dt)
    check_collisions()
  else
    update_amb(dt)
    update_booms(dt)
  end

  update_floaters(dt)
end

-- ---- drawing -------------------------------------------------------------------
local foamy = {}
for i = 0, W, 22 do
  foamy[#foamy + 1] = i
end

local function center_text(y, s, c)
  if c then canvas.color = c end
  canvas.text(W / 2 - textwidth(s) / 2, y, s)
  canvas.color = colors.white
end

function draw()
  local pal = PALS[((level - 1) % #PALS) + 1]
  local blink = (math.floor(time0 * 2) % 2) == 0

  canvas.backcolor = pal.seaB
  canvas.clear()

  -- ==== sky ====
  canvas.gradient.rectV(0, 0, W, SURF + 10, pal.skyA, pal.skyB)
  -- sun
  local sunx, suny = W - 120, 34
  canvas.color = pal.sun
  canvas.circle(sunx, suny, 26, true)
  canvas.color = pal.foam
  canvas.circle(sunx, suny, 14, true)

  -- lazy flat clouds
  canvas.color = colors.white
  canvas.alpha = 90
  for i = 0, 3 do
    local cx = (i * 260 + time0 * 7) % (W + 160) - 80
    local cy = 14 + (i % 2) * 16
    canvas.circle(cx, cy, 9, true)
    canvas.circle(cx + 12, cy + 3, 7, true)
    canvas.circle(cx - 11, cy + 4, 6, true)
  end
  canvas.alpha = 255

  -- ==== water ====
  canvas.gradient.rectV(0, SURF - 4, W, SANDTOP - SURF + 4, pal.seaA, pal.seaB)

  -- god rays from the sun down into the sea
  canvas.alpha = 22
  canvas.color = colors.white
  for i = 1, 6 do
    local a = math.pi * (0.55 + i * 0.08) + math.sin(time0 * 0.4 + i) * 0.06
    local len = 160 + (i % 3) * 120
    local x2 = sunx + math.cos(a) * len
    local y2 = SURF - 4 + math.sin(a) * len * 0.55
    canvas.line(sunx, SURF - 8, x2, math.min(y2, SANDTOP - 40), 5 - i % 2)
  end
  canvas.alpha = 255

  -- the waterline: a foam row drifting with the wind
  canvas.color = pal.foam
  canvas.alpha = 230
  canvas.rectangle(0, SURF - 2, W, 3, true)
  canvas.alpha = 120
  local drift = (time0 * 22) % 44
  for _, x in ipairs(foamy) do
    local xx = (x + drift) % (W + 22)
    canvas.rectangle(xx, SURF + 4, 14, 2, true)
  end
  canvas.alpha = 255

  -- ==== sand ====
  canvas.gradient.rectV(0, SANDTOP - 8, W, H - SANDTOP + 8, pal.sand, pal.sand2)
  local x = 0
  while x < W + 12 do
    local top = SANDTOP - 8 + math.sin((x - time0 * 4) * 0.02) * 5 + math.sin(x * 0.05) * 3
    local n = math.floor(top)
    canvas.rectangle(x, n, 12, H - n, true)
    x = x + 12
  end
  for i = 1, #pebbles do
    local p = pebbles[i]
    canvas.color = pal.sand2
    canvas.circle(p.x, p.y, p.r, true)
  end

  -- ==== ambient bubbles ====
  canvas.color = colors.aqua
  canvas.alpha = 160
  for _, b in ipairs(amb) do
    if b.r > 2.4 then
      canvas.circle(b.x, b.y, b.r, false)
    else
      canvas.circle(b.x, b.y, b.r, true)
    end
  end
  canvas.alpha = 255

  -- ==== carried divers trailing the sub ====
  if (state == "play" or state == "dying") and carried > 0 then
    for i = 0, carried - 1 do
      local bxr = subx - subdir * (28 + i * 11)
      local byr = suby + math.sin(time0 * 3 + i) * 2
      canvas.color = colors.silver
      canvas.circle(bxr + 2, byr + 2, 4, true)
      canvas.color = colors.orange
      canvas.circle(bxr, byr, 5, true)
      canvas.color = colors.gold
      canvas.circle(bxr - 2, byr - 2, 2, true)
    end
  end

  -- ==== floaters ====
  for _, f in ipairs(floaters) do
    canvas.color = f.color
    canvas.alpha = math.floor(255 * (1 - f.age / 1.1))
    canvas.text(f.x - textwidth(f.text) / 2, f.y, f.text)
  end
  canvas.alpha = 255

  -- ==== HUD: lives in the calm sky band where no sprite swims ====
  local y0 = 6
  canvas.color = colors.white
  canvas.text(10, y0, "SCORE " .. string.format("%06d", score))
  canvas.color = colors.silver
  canvas.text(230, y0, "HI " .. highscore)
  canvas.color = colors.gold
  canvas.text(360, y0, "LEVEL " .. level)
  canvas.color = colors.white

  for i = 1, lives - 1 do
    local lx, ly = 14 + (i - 1) * 22, y0 + 12
    canvas.color = colors.darkgray
    canvas.rectangle(lx, ly, 15, 7, true)
    canvas.color = colors.gold
    canvas.rectangle(lx + 1, ly, 13, 5, true)
    canvas.rectangle(lx + 4, ly - 3, 6, 4, true)
  end

  local ox, oy, ow, oh = 14, y0 + 30, 132, 9
  canvas.color = colors.darkgray
  canvas.rectangle(ox - 1, oy - 1, ow + 2, oh + 2, true)
  local frac = clamp(o2 / 100, 0, 1)
  local wy = (math.floor(time0 * 4) % 2) == 0
  canvas.color = (o2 < 30 and wy) and colors.red
              or (o2 < 55 and colors.yellow or colors.lime)
  canvas.rectangle(ox, oy, math.max(0, math.floor(ow * frac)), oh, true)
  canvas.color = colors.white
  canvas.text(ox + ow + 8, oy - 2, "O2 " .. math.floor(o2) .. "%")

  local dtext = "DIVERS " .. banked .. "/" .. diversNeed
  canvas.color = colors.white
  canvas.text(ox, oy + 18, dtext)
  for i = 0, diversNeed - 1 do
    local cxx = ox + textwidth(dtext) + 12 + i * 11
    canvas.color = colors.darkgray
    canvas.circle(cxx, oy + 27, 4, true)
    if i < banked then
      canvas.color = colors.orange
      canvas.circle(cxx, oy + 27, 3, true)
    end
  end

  -- ==== banners ====
  if state == "title" then
    canvas.color = colors.darkblue
    canvas.alpha = 150
    canvas.rectangle(0, H / 2 - 100, W, 164, true)
    canvas.alpha = 255
    center_text(H / 2 - 84, "S U B M A R I N E", colors.gold)
    center_text(H / 2 - 64, "d a n g e r  i n  d e p t h", colors.aqua)
    center_text(H / 2 - 20, "Rescue the six divers hiding in the deep.", colors.white)
    center_text(H / 2 - 4, "Your oxygen burns. Only the surface refills it.", colors.white)
    center_text(H / 2 + 32, "PRESS SPACE TO DIVE", blinkTitle and colors.orange or colors.white)
    center_text(H / 2 + 50, "P pause   M mute   Q/E water shader   ESC quit", colors.silver)
    center_text(H / 2 + 68, "HI SCORE " .. highscore, colors.gold)
    if attract then center_text(H / 2 + 86, "ATTRACT MODE", colors.red) end
  elseif state == "ready" then
    canvas.color = colors.darkblue
    canvas.alpha = 140
    canvas.rectangle(0, H / 2 - 60, W, 110, true)
    canvas.alpha = 255
    center_text(H / 2 - 42, "MISSION " .. level, colors.gold)
    center_text(H / 2 - 20, "Dive to depth " .. (40 + level * 60) .. " fathoms.", colors.white)
    center_text(H / 2, "Rescue 6 divers. Keep the tank breathing.", colors.aqua)
    center_text(H / 2 + 24, "GET READY", blink and colors.orange or colors.white)
  elseif state == "clear" then
    canvas.color = colors.darkblue
    canvas.alpha = 150
    canvas.rectangle(0, H / 2 - 70, W, 130, true)
    canvas.alpha = 255
    center_text(H / 2 - 60, "MISSION COMPLETE", colors.lime)
    center_text(H / 2 - 38, "Divers delivered: " .. banked .. "/6", colors.white)
    center_text(H / 2 - 16, "Bonus + " .. (400 + level * 100), colors.gold)
    center_text(H / 2 + 8, "Score " .. string.format("%06d", score), colors.white)
    center_text(H / 2 + 34, "Going deeper...", colors.aqua)
  elseif state == "over" then
    canvas.color = colors.black
    canvas.alpha = 170
    canvas.rectangle(0, H / 2 - 80, W, 150, true)
    canvas.alpha = 255
    center_text(H / 2 - 70, "GAME OVER", colors.red)
    center_text(H / 2 - 48, "Final score " .. string.format("%06d", score), colors.white)
    if score >= highscore and score > 0 then
      center_text(H / 2 - 26, "NEW HIGH SCORE!", colors.gold)
    else
      center_text(H / 2 - 26, "High score " .. string.format("%06d", highscore), colors.gold)
    end
    center_text(H / 2 + 6, "Depth charts read: LEVEL " .. level, colors.aqua)
    if (math.floor(time0 * 2) % 2) == 0 then
      center_text(H / 2 + 38, "PRESS SPACE FOR THE TITLE", colors.orange)
    end
  end

  -- paused veil
  if paused then
    canvas.color = colors.black
    canvas.alpha = 130
    canvas.rectangle(0, 0, W, H, true)
    canvas.alpha = 255
    center_text(H / 2 - 10, "PAUSED", colors.white)
    center_text(H / 2 + 12, "press P to dive again", colors.silver)
  end
end

-- hand the engine the update/draw loop: the engine calls these every frame

