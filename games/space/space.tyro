--======================================================================
--  Space: Starfield & Universe Travel for Tyro
--======================================================================
--  A pseudo-3D starfield: hundreds of stars stream toward the viewer as
--  you travel through the universe. Steer with the mouse or WASD, boost
--  with SPACE, drop to cruise with SHIFT. Twinkling, motion trails,
--  distant nebula clouds and the occasional planet drift by.
--
--  Controls:  Mouse / WASD / Arrows   steer
--             SPACE                   boost (warp)
--             SHIFT                   slow cruise
--             S                       toggle glow shader
--             R                       reset voyage
--             ESC                     quit
--
--  Run:  tyro games/space/space.tyro
--======================================================================

window.show(960, 600)
window.backcolor = colors.black

local W = canvas.width
local H = canvas.height
local CX = W * 0.5
local CY = H * 0.5

-- ambient engine drone, retuned with speed
sound.loopPlay("Engine", 70, 0.35)

-- ---- helpers ---------------------------------------------------------
local function clamp(v, lo, hi)
  if v < lo then return lo elseif v > hi then return hi else return v end
end

local function rgba(r, g, b, a)
  a = a or 255
  return r + g * 256 + b * 65536 + a * 16777216
end

local COL_BG      = rgba(2, 4, 12, 255)
local COL_STAR    = rgba(230, 235, 255, 255)
local COL_DIM     = rgba(120, 130, 170, 200)
local COL_BLUE    = rgba(120, 170, 255, 255)
local COL_RED     = rgba(255, 120, 120, 255)
local COL_GOLD    = rgba(255, 215, 120, 255)
local COL_NEB     = rgba(80, 40, 140, 90)
local COL_TRAIL   = rgba(120, 160, 255, 120)

-- ---- tuning ----------------------------------------------------------
local STAR_COUNT  = 700
local MAX_Z       = 2000
local MIN_Z       = 1
local BASE_SPEED  = 260       -- world units / sec
local BOOST_MULT  = 3.2
local CRUISE_MULT = 0.45
local FOV         = 320
local TRAIL_LEN   = 0.18      -- seconds of motion trail

-- ---- state -----------------------------------------------------------
local stars = {}
local trails = {}   -- parallel: previous screen pos per star
local planets = {}
local nebulae = {}
local comets = {}
local galaxyAngle = 0
local shipAngle = 0
local yaw = 0        -- -1..1 steering
local pitch = 0
local speedMul = 1.0
local speedSmooth = 1.0
local distance = 0
local glowOn = true
local resetFlag = false

-- ship sprite
local shipSprite = Sprites.new("ship")
shipSprite.load("ship.png")
shipSprite.show()
shipSprite.scale = 1.0

-- ---- init stars ------------------------------------------------------
local function init_star(s, fresh)
  s.x = (math.random() * 2 - 1) * 1400
  s.y = (math.random() * 2 - 1) * 900
  if fresh then
    s.z = MAX_Z
  else
    s.z = math.random() * MAX_Z + 1
  end
  s.bright = 0.3 + math.random() * 0.7
  s.color = math.random()
  s.twinkle = math.random() * math.pi * 2
  s.size = 0.6 + math.random() * 1.6
end

for i = 1, STAR_COUNT do
  local s = {}
  init_star(s, false)
  stars[i] = s
  trails[i] = { sx = 0, sy = 0, valid = false }
end

-- ---- nebula clouds (screen-space drifting) --------------------------
for i = 1, 6 do
  nebulae[i] = {
    x = math.random() * W,
    y = math.random() * H,
    r = 90 + math.random() * 160,
    vx = (math.random() - 0.5) * 6,
    vy = (math.random() - 0.5) * 4,
    hue = math.random(),
    a = 40 + math.random() * 40,
  }
end

-- ---- planets ---------------------------------------------------------
local function spawn_planet()
  local p = {
    x = (math.random() * 2 - 1) * 600,
    y = (math.random() * 2 - 1) * 400,
    z = MAX_Z * (0.6 + math.random() * 0.4),
    r = 12 + math.random() * 26,
    hue = math.random(),
    rot = 0,
    rotSpeed = (math.random() - 0.5) * 0.6,
  }
  planets[#planets + 1] = p
end
for i = 1, 3 do spawn_planet() end

-- ---- shader ----------------------------------------------------------
if shader then
  shader.effect = "glow"
  shader.value = 0.6
  shader.area = {0, 0, W, H}
end

-- ---- reset voyage ----------------------------------------------------
local function reset_voyage()
  distance = 0
  yaw = 0; pitch = 0
  shipAngle = 0
  for i = 1, STAR_COUNT do init_star(stars[i], false) end
  planets = {}
  for i = 1, 3 do spawn_planet() end
  comets = {}
end

-- ---- comets ----------------------------------------------------------
local function spawn_comet()
  local side = math.random(4)
  local c = { life = 1.2 + math.random() * 1.0, trail = {} }
  if side == 1 then c.x = -20; c.y = math.random() * H; c.vx = 200 + math.random()*200; c.vy = (math.random()-0.5)*120
  elseif side == 2 then c.x = W + 20; c.y = math.random() * H; c.vx = -(200 + math.random()*200); c.vy = (math.random()-0.5)*120
  elseif side == 3 then c.x = math.random() * W; c.y = -20; c.vx = (math.random()-0.5)*120; c.vy = 200 + math.random()*200
  else c.x = math.random() * W; c.y = H + 20; c.vx = (math.random()-0.5)*120; c.vy = -(200 + math.random()*200) end
  comets[#comets + 1] = c
end

-- ---- main loop -------------------------------------------------------
local t = 0
while cycle do
  local dt = frametime()
  if dt <= 0 or dt > 0.1 then dt = 0.016 end
  t = t + dt

  -- input
  if keyboard.pressed("escape") then break end
  if keyboard.pressed("r") then reset_voyage() end
  if keyboard.pressed("s") then
    glowOn = not glowOn
    if shader then
      if glowOn then shader.effect = "glow" else shader.effect = "none" end
    end
  end

  -- steering
  local steerX = 0
  local steerY = 0
  if keyboard.down("a") or keyboard.down("left")  then steerX = steerX - 1 end
  if keyboard.down("d") or keyboard.down("right") then steerX = steerX + 1 end
  if keyboard.down("w") or keyboard.down("up")    then steerY = steerY - 1 end
  if keyboard.down("s") or keyboard.down("down")  then steerY = steerY + 1 end

  -- mouse steering (relative to center)
  local mx = mouse.x - CX
  local my = mouse.y - CY
  steerX = steerX + clamp(mx / (W * 0.5), -1, 1) * 0.8
  steerY = steerY + clamp(my / (H * 0.5), -1, 1) * 0.8

  yaw = yaw + (steerX - yaw) * clamp(dt * 4.0, 0, 1)
  pitch = pitch + (steerY - pitch) * clamp(dt * 4.0, 0, 1)
  shipAngle = yaw * 18

  -- speed
  local targetMul = 1.0
  if keyboard.down("space") then targetMul = BOOST_MULT end
  if keyboard.down("shift") then targetMul = CRUISE_MULT end
  speedMul = speedMul + (targetMul - speedMul) * clamp(dt * 2.5, 0, 1)
  speedSmooth = speedSmooth + (speedMul - speedSmooth) * clamp(dt * 5, 0, 1)

  local speed = BASE_SPEED * speedSmooth
  distance = distance + speed * dt

  -- update nebulae
  for i = 1, #nebulae do
    local n = nebulae[i]
    n.x = n.x + n.vx * dt * (0.5 + speedSmooth * 0.5)
    n.y = n.y + n.vy * dt * (0.5 + speedSmooth * 0.5)
    if n.x < -n.r then n.x = W + n.r end
    if n.x > W + n.r then n.x = -n.r end
    if n.y < -n.r then n.y = H + n.r end
    if n.y > H + n.r then n.y = -n.r end
  end

  -- update planets
  for i = #planets, 1, -1 do
    local p = planets[i]
    p.z = p.z - speed * 1.6 * dt
    p.rot = p.rot + p.rotSpeed * dt
    if p.z <= 50 then
      table.remove(planets, i)
      spawn_planet()
    end
  end
  if #planets < 4 and math.random() < dt * 0.3 then spawn_planet() end

  -- update comets
  for i = #comets, 1, -1 do
    local c = comets[i]
    c.life = c.life - dt
    c.x = c.x + c.vx * dt * (0.6 + speedSmooth * 0.4)
    c.y = c.y + c.vy * dt * (0.6 + speedSmooth * 0.4)
    -- record trail
    c.trail[#c.trail + 1] = { x = c.x, y = c.y }
    if #c.trail > 14 then table.remove(c.trail, 1) end
    if c.life <= 0 or c.x < -50 or c.x > W + 50 or c.y < -50 or c.y > H + 50 then
      table.remove(comets, i)
    end
  end
  if math.random() < dt * 0.18 then spawn_comet() end

  galaxyAngle = galaxyAngle + dt * 0.05

  -- sound
  sound.loopPitch(60 + speedSmooth * 80)
  sound.loopVolume(clamp(0.25 + speedSmooth * 0.15, 0.1, 0.7))

  -- reset voyage includes comets? handled below

  -- update stars
  for i = 1, STAR_COUNT do
    local s = stars[i]
    -- steer influence: lateral drift
    s.x = s.x - yaw * 40 * dt * (MAX_Z / math.max(s.z, 1))
    s.y = s.y - pitch * 30 * dt * (MAX_Z / math.max(s.z, 1))
    s.z = s.z - speed * dt
    s.twinkle = s.twinkle + dt * (2 + s.bright * 3)
    if s.z <= MIN_Z then
      init_star(s, true)
      trails[i].valid = false
    end
  end

  -- ---- draw ---------------------------------------------------------
  canvas.color = colors.black
  canvas.clear()

  -- background gradient
  canvas.color = rgba(4, 6, 18, 255)
  canvas.rectangle(0, 0, W, H, true)

  -- distant galaxy (rotating spiral) in background
  local gx = W * 0.78
  local gy = H * 0.22
  for i = 1, 260 do
    local a = (i / 260) * math.pi * 6 + galaxyAngle
    local rad = 8 + (i / 260) * 70
    local x = gx + math.cos(a) * rad + (math.random()-0.5)*4
    local y = gy + math.sin(a) * rad * 0.45 + (math.random()-0.5)*4
    local b = 0.3 + 0.7 * (1 - i/260)
    local rr = math.floor(200 * b)
    local gg = math.floor(180 * b)
    local bb = math.floor(255 * b)
    canvas.color = rgba(rr, gg, bb, math.floor(120 * b + 40))
    canvas.point(math.floor(x), math.floor(y))
  end
  -- galaxy core
  canvas.color = rgba(255, 240, 200, 180)
  canvas.circle(math.floor(gx), math.floor(gy), 6, true)
  canvas.color = rgba(255, 220, 160, 80)
  canvas.circle(math.floor(gx), math.floor(gy), 14, true)

  -- nebula clouds
  for i = 1, #nebulae do
    local n = nebulae[i]
    local rr = n.r * (0.8 + speedSmooth * 0.4)
    -- draw as concentric circles for soft blob
    for k = 0, 4 do
      local fr = rr * (1 - k * 0.18)
      local a = math.floor(n.a * (1 - k * 0.2))
      local c
      if n.hue < 0.33 then c = rgba(90, 50, 160, a)
      elseif n.hue < 0.66 then c = rgba(40, 80, 180, a)
      else c = rgba(160, 60, 120, a) end
      canvas.color = c
      canvas.circle(math.floor(n.x), math.floor(n.y), math.floor(fr), true)
    end
  end

  -- sort stars by z descending (far to near) for proper draw order
  -- (simple: iterate and draw; near stars drawn later naturally if we sort)
  -- We'll do a lightweight bucket: collect indices then sort by z
  local order = {}
  for i = 1, STAR_COUNT do order[i] = i end
  table.sort(order, function(a, b) return stars[a].z > stars[b].z end)

  for _, idx in ipairs(order) do
    local s = stars[idx]
    local z = math.max(s.z, 1)
    local sx = CX + (s.x / z) * FOV
    local sy = CY + (s.y / z) * FOV
    local tr = trails[idx]

    -- trail
    if tr.valid then
      local dx = sx - tr.sx
      local dy = sy - tr.sy
      local len = math.sqrt(dx*dx + dy*dy)
      if len > 1.5 and len < 80 then
        canvas.color = COL_TRAIL
        canvas.line(math.floor(tr.sx), math.floor(tr.sy), math.floor(sx), math.floor(sy), 1)
      end
    end
    tr.sx = sx; tr.sy = sy; tr.valid = true

    -- skip off-screen
    if sx >= -10 and sx <= W + 10 and sy >= -10 and sy <= H + 10 then
      local near = 1 - (z / MAX_Z)
      if near < 0 then near = 0 end
      local r = s.size * (0.4 + near * 2.6)
      if r < 0.5 then r = 0.5 end
      -- brightness twinkle
      local tw = 0.75 + 0.25 * math.sin(s.twinkle)
      local b = s.bright * tw * (0.35 + near * 0.65)
      local rr = math.floor(255 * b)
      local gg = math.floor(255 * b)
      local bb = math.floor(255 * (b * 0.9 + 0.1))
      -- color tint
      if s.color < 0.15 then
        rr = math.floor(rr * 0.7); gg = math.floor(gg * 0.85); bb = 255
      elseif s.color > 0.85 then
        rr = 255; gg = math.floor(gg * 0.85); bb = math.floor(bb * 0.7)
      end
      canvas.color = rgba(rr, gg, bb, 255)
      if r >= 1.2 then
        canvas.circle(math.floor(sx), math.floor(sy), math.floor(r), true)
      else
        canvas.point(math.floor(sx), math.floor(sy))
      end
      -- glow for bright near stars
      if near > 0.85 and r > 2 then
        canvas.color = rgba(rr, gg, bb, 60)
        canvas.circle(math.floor(sx), math.floor(sy), math.floor(r * 2.2), true)
      end
    end
  end

  -- planets (draw after stars, before ship)
  for _, p in ipairs(planets) do
    local z = math.max(p.z, 1)
    local sx = CX + (p.x / z) * FOV
    local sy = CY + (p.y / z) * FOV
    local near = 1 - (z / MAX_Z)
    if near < 0 then near = 0 end
    local r = p.r * (0.3 + near * 1.7)
    if sx > -r and sx < W + r and sy > -r and sy < H + r then
      -- body
      local hue = p.hue
      local cr, cg, cb
      if hue < 0.33 then cr, cg, cb = 180, 140, 100
      elseif hue < 0.66 then cr, cg, cb = 100, 160, 220
      else cr, cg, cb = 200, 120, 90 end
      canvas.color = rgba(cr, cg, cb, 255)
      canvas.circle(math.floor(sx), math.floor(sy), math.floor(r), true)
      -- shading
      canvas.color = rgba(math.floor(cr*0.5), math.floor(cg*0.5), math.floor(cb*0.5), 180)
      canvas.circle(math.floor(sx + r*0.3), math.floor(sy - r*0.1), math.floor(r*0.85), true)
      -- highlight
      canvas.color = rgba(255, 255, 255, 90)
      canvas.circle(math.floor(sx - r*0.35), math.floor(sy - r*0.35), math.floor(r*0.25), true)
      -- ring for some
      if p.hue > 0.7 then
        canvas.color = rgba(220, 200, 160, 120)
        canvas.circle(math.floor(sx), math.floor(sy), math.floor(r * 1.6), false)
      end
    end
  end

  -- comets
  for _, c in ipairs(comets) do
    -- trail
    for k = 2, #c.trail do
      local a = (k / #c.trail)
      canvas.color = rgba(255, 255, 220, math.floor(200 * a))
      canvas.line(math.floor(c.trail[k-1].x), math.floor(c.trail[k-1].y),
                 math.floor(c.trail[k].x), math.floor(c.trail[k].y), 2)
    end
    canvas.color = colors.white
    canvas.circle(math.floor(c.x), math.floor(c.y), 3, true)
    canvas.color = rgba(255, 240, 180, 120)
    canvas.circle(math.floor(c.x), math.floor(c.y), 7, true)
  end

  -- ship sprite update
  shipSprite.x = CX - 24 + math.sin(math.rad(shipAngle)) * 2
  shipSprite.y = H - 80
  shipSprite.angle = shipAngle
  if speedSmooth > 1.3 then
    shipSprite.scale = 1.0 + 0.05 * math.sin(t * 20)
  else
    shipSprite.scale = 1.0
  end

  -- thrust flame when boosting (canvas)
  if speedSmooth > 1.3 then
    canvas.color = colors.orange
    canvas.triangle(
      math.floor(CX - 4), math.floor(H - 80 + 24),
      math.floor(CX + 4), math.floor(H - 80 + 24),
      math.floor(CX), math.floor(H - 80 + 24 + 8 + math.random()*8), true)
  end

  -- HUD
  canvas.color = colors.white
  canvas.text(12, 12, "SPACE / UNIVERSE TRAVEL")
  canvas.text(12, 28, string.format("Speed: %.1fx   Distance: %.0f ly", speedSmooth, distance / 100))
  canvas.text(12, 44, string.format("Heading: %+.0f   Pitch: %+.0f", yaw * 10, pitch * 10))
  canvas.text(12, H - 24, "WASD/Arrows/Mouse steer   SPACE boost   SHIFT cruise   S glow   R reset   ESC quit")

  -- warp indicator
  if speedSmooth > 2.0 then
    canvas.color = rgba(120, 180, 255, math.floor(80 + 60 * math.sin(t * 8)))
    canvas.text(W - 120, 12, "WARP")
  end
end

sound.loopStop()
