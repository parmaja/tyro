--======================================================================
--  Fish Tank - a calm aquarium for Tyro
--======================================================================
--  Nine pixel fish from the fish/ folder swim freely over the whole
--  screen. Every fish has its own speed, wobble and mind: they cruise,
--  change depth, turn around at the glass and now and then blow a
--  bubble from their mouth.
--
--  Bubbles rise from two air stones on the sand, wobble on their way up
--  and pop at the surface with a "Bubble" waveform generated by the
--  engine (TyroSounds.pas, registered as "Bubble").
--
--  The water itself is a custom full-screen post-processing shader
--  (water.frag): refraction, depth tint, moving caustics, shimmer bands,
--  glass vignette and a bright glass edge.
--
--  Controls:  B / left click   blow a burst of bubbles
--             W               water shader on/off
--             UP / DOWN       stronger / weaker water
--             ESC             quit
--
--  Run:  tyro games/fishtank/fishtank.tyro
--======================================================================

window.show(960, 640)

local W, H = canvas.width, canvas.height

local FISH_FILES = {
  "fish_1.png",  "fish_15.png", "fish_22.png",
  "fish_23.png", "fish_25.png", "fish_3.png",
  "fish_50.png", "fish_58.png", "fish_6.png",
}

local fish        = {}
local bubbles     = {}
local pops        = {}
local plants      = {}
local corals      = {}
local pebbles     = {}
local elapsed     = 0
local bubbleAccum = 0
local bubbleSoundCooldown = 0
local waterOn     = true
local waterValue  = 0.72

local BUBBLER_X   = math.floor(W * 0.22)
local BUBBLER2_X  = math.floor(W * 0.79)
local BUBBLER_Y   = H - 44
local SAND_Y      = H - 58

-- ---- tiny helpers ----------------------------------------------------
local function clamp(v, lo, hi)
  if v < lo then return lo elseif v > hi then return hi else return v end
end

local function rnd(a, b)
  return a + (b - a) * math.random()
end

-- ---- the water shader -------------------------------------------------
-- Looks for water.frag next to this script. shader.value is the strength,
-- the area is the whole canvas so the water covers the entire tank.
shader.load("water.frag")
shader.value = waterValue
shader.area = {0, 0, W, H}

-- ---- fish -------------------------------------------------------------
local function make_fish(file, index, count)
  local sprite = Sprites.new()
  sprite.load("fish/" .. file)

  local scale = rnd(0.58, 1.18)
  sprite.scale = scale
  sprite.show()

  local dir = 1
  if math.random() < 0.5 then dir = -1 end

  -- Spread the school out at start: even columns, four loose depth bands.
  local column = (index - 0.5) / count
  local bands = { 95, 225, 355, 490 }
  local bandY = bands[(index - 1) % #bands + 1]

  local f = {
    sprite   = sprite,
    scale    = scale,
    dir      = dir,
    speed    = rnd(24, 74),          -- individual cruise speed, px/s
    x        = clamp(W * column + rnd(-45, 45), 90, W - 90),
    y        = bandY + rnd(-28, 28),
    targetY  = rnd(80, H - 150),
    vy       = 0,
    phase    = rnd(0, math.pi * 2),
    bobAmp   = rnd(3, 11),
    bobSpeed = rnd(0.55, 1.5),
    turnIn   = rnd(2.5, 8.0),
    bubbleIn = rnd(1.5, 6.0),
  }
  sprite.x = f.x
  sprite.y = f.y
  sprite.flipH = f.dir > 0
  return f
end

for i = 1, #FISH_FILES do
  fish[i] = make_fish(FISH_FILES[i], i, #FISH_FILES)
end

local function update_fish(f, dt)
  f.turnIn = f.turnIn - dt
  if f.turnIn <= 0 then
    f.turnIn = rnd(3.5, 8.5)
    if math.random() < 0.32 then f.dir = -f.dir end
    f.targetY = rnd(70, H - 130)
  end

  f.x = f.x + f.dir * f.speed * dt
  local margin = 48 * f.scale + 8
  if f.x < margin then
    f.x = margin
    f.dir = 1
    f.targetY = rnd(70, H - 130)
  elseif f.x > W - margin then
    f.x = W - margin
    f.dir = -1
    f.targetY = rnd(70, H - 130)
  end

  -- Ease toward the wanted depth instead of snapping, so the fish glide.
  local wantedVy = clamp((f.targetY - f.y) * 0.85, -26, 26)
  f.vy = f.vy + (wantedVy - f.vy) * math.min(1, dt * 1.6)
  f.y = clamp(f.y + f.vy * dt, 46, H - 112)

  f.phase = f.phase + dt * f.bobSpeed
  local bob = math.sin(f.phase) * f.bobAmp

  f.sprite.x = f.x
  f.sprite.y = f.y + bob
  f.sprite.flipH = f.dir > 0

  -- Tilt the nose along the vertical path. abs() on the horizontal speed
  -- keeps the angle right for both facing directions.
  local tilt = f.vy + math.cos(f.phase) * f.bobAmp * f.bobSpeed
  f.sprite.angle = clamp(math.deg(math.atan(tilt, f.speed)), -16, 16)

  -- A little bubble from the mouth every few seconds.
  f.bubbleIn = f.bubbleIn - dt
  if f.bubbleIn <= 0 then
    f.bubbleIn = rnd(1.6, 5.5)
    local mouthX = f.x + f.dir * (33 * f.scale)
    local mouthY = f.sprite.y - 3 * f.scale
    bubbles[#bubbles + 1] = {
      x = mouthX, y = mouthY,
      r = rnd(1.8, 4.6),
      vy = rnd(20, 42),
      sway = rnd(2, 6),
      swaySpeed = rnd(1.4, 3.2),
      phase = rnd(0, math.pi * 2),
      age = 0,
    }
  end
end

-- ---- bubbles ----------------------------------------------------------
local function spawn_bubble(x, y, radius, speed)
  if #bubbles > 170 then
    table.remove(bubbles, 1)
  end
  bubbles[#bubbles + 1] = {
    x = x, y = y,
    r = radius,
    vy = speed,
    sway = rnd(2.5, 8.5),
    swaySpeed = rnd(1.2, 3.0),
    phase = rnd(0, math.pi * 2),
    age = 0,
  }
end

local function blow_burst(x, y, count)
  for i = 1, count do
    spawn_bubble(x + rnd(-24, 24), y + rnd(-8, 8),
                 rnd(1.5, 7.0), rnd(28, 78))
  end
  music.sound("Bubble", math.floor(rnd(520, 980)), 90)
end

local function pop_bubble_sound(radius)
  if bubbleSoundCooldown > 0 then return end
  if math.random() > 0.55 then return end
  -- Small bubbles are high and fizzy, big ones are low and round.
  local pitch = math.floor(clamp(1650 - radius * 150, 420, 1600))
  music.sound("Bubble", pitch, 80)
  bubbleSoundCooldown = rnd(0.16, 0.34)
end

local function update_bubbles(dt)
  bubbleAccum = bubbleAccum - dt
  if bubbleAccum <= 0 then
    bubbleAccum = rnd(0.07, 0.19)
    if math.random() < 0.56 then
      spawn_bubble(BUBBLER_X + rnd(-7, 7), BUBBLER_Y,
                   rnd(1.8, 6.8), rnd(24, 58))
    elseif math.random() < 0.45 then
      spawn_bubble(BUBBLER2_X + rnd(-6, 6), BUBBLER_Y + rnd(-2, 3),
                   rnd(1.8, 5.6), rnd(22, 52))
    else
      spawn_bubble(rnd(24, W - 24), SAND_Y + rnd(-10, 6),
                   rnd(1.8, 5.6), rnd(20, 50))
    end
  end

  local i
  for i = #bubbles, 1, -1 do
    local b = bubbles[i]
    b.age = b.age + dt
    b.y = b.y - b.vy * dt
    b.x = b.x + math.sin(b.age * b.swaySpeed + b.phase) * b.sway * dt

    if b.y < 5 then
      pops[#pops + 1] = { x = b.x, y = 4, r = b.r, age = 0 }
      pop_bubble_sound(b.r)
      table.remove(bubbles, i)
    elseif b.x < -20 or b.x > W + 20 then
      table.remove(bubbles, i)
    end
  end
end

local function update_pops(dt)
  local i
  for i = #pops, 1, -1 do
    pops[i].age = pops[i].age + dt
    if pops[i].age > 0.4 then
      table.remove(pops, i)
    end
  end
end

-- ---- fixed decorations ------------------------------------------------
local PLANT_COLORS = { colors.green, colors.darkgreen, colors.lime }
local STONE_COLORS = { colors.darkgray, colors.gray, colors.brown, colors.darkbrown }

for i = 1, 11 do
  plants[i] = {
    x = math.floor(W * (i - 0.5) / 11 + rnd(-22, 22)),
    h = rnd(60, 185),
    sway = rnd(9, 26),
    phase = rnd(0, math.pi * 2),
    leaves = rand(2, 4),
    color = PLANT_COLORS[rand(1, #PLANT_COLORS)],
  }
end

for i = 1, 3 do
  corals[i] = {
    x = math.floor(W * (0.14 + i * 0.29) + rnd(-30, 30)),
    h = rnd(52, 105),
    phase = rnd(0, math.pi * 2),
    color = colors.pink,
  }
  if i == 2 then corals[i].color = colors.orange end
end

for i = 1, 22 do
  pebbles[i] = {
    x = rand(12, W - 12),
    y = SAND_Y + rand(-6, 34),
    r = rand(2, 7),
    color = STONE_COLORS[rand(1, #STONE_COLORS)],
  }
end

-- ---- drawing ----------------------------------------------------------
local function draw_water()
  canvas.color = colors.darkblue
  canvas.rectangle(0, 0, W, H, true)

  -- Semitransparent bands blend darkblue at the bottom into a lighter,
  -- greener blue at the top. The shader adds the moving light on top.
  local bands = 28
  for i = 0, bands - 1 do
    local t = i / (bands - 1)
    canvas.color = colors.aqua
    canvas.alpha = math.floor(86 * (1 - t) ^ 1.6)
    canvas.rectangle(0, math.floor(i * H / bands), W, math.ceil(H / bands) + 1, true)
  end
  canvas.alpha = 255
end

local function draw_plants()
  local i
  for i = 1, #plants do
    local p = plants[i]
    local sway = math.sin(elapsed * 1.1 + p.phase) * p.sway
    local segs = 5
    canvas.color = p.color
    local s
    for s = 0, segs - 1 do
      local f1 = s / segs
      local f2 = (s + 1) / segs
      local x1 = p.x + sway * (f1 ^ 1.5)
      local x2 = p.x + sway * (f2 ^ 1.5) + math.sin(elapsed * 1.7 + p.phase + s) * 2
      local y1 = SAND_Y + 12 - p.h * f1
      local y2 = SAND_Y + 12 - p.h * f2
      canvas.line(x1, y1, x2, y2, math.max(2, 5 - s))
    end

    local l
    for l = 1, p.leaves do
      local f = l / (p.leaves + 1)
      local ly = SAND_Y + 12 - p.h * f
      local lx = p.x + sway * (f ^ 1.5)
      local side = 1
      if l % 2 == 0 then side = -1 end
      local len = 14 + (1 - f) * 12
      canvas.color = colors.lime
      canvas.triangle(lx, ly,
                      lx + side * len, ly - len * 0.35,
                      lx + side * len * 0.35, ly - len * 0.8, true)
      canvas.color = p.color
    end
  end
end

local function draw_corals()
  local i
  for i = 1, #corals do
    local c = corals[i]
    local sway = math.sin(elapsed * 0.8 + c.phase) * 4
    canvas.color = c.color
    canvas.line(c.x, SAND_Y + 14, c.x + sway, SAND_Y + 14 - c.h, 6)
    local b
    for b = 1, 4 do
      local f = b / 5
      local y = SAND_Y + 14 - c.h * f
      local x = c.x + sway * f
      local side = 1
      if b % 2 == 0 then side = -1 end
      local branch = 12 + f * 12
      canvas.line(x, y, x + side * branch, y - 9, 3)
      canvas.circle(x + side * branch, y - 10, 3, true)
    end
    canvas.circle(c.x + sway, SAND_Y + 14 - c.h, 5, true)
  end
end

local function draw_sand()
  canvas.color = colors.beige
  local x = 0
  while x < W do
    local top = SAND_Y + math.sin((x + elapsed * 5) * 0.018) * 6
                + math.sin(x * 0.05) * 3
    local iy = math.floor(top)
    canvas.rectangle(x, iy, 11, H - iy, true)
    x = x + 10
  end

  canvas.color = colors.darkbrown
  x = 0
  while x < W do
    local top = H - 26 + math.sin((x + elapsed * 6) * 0.025) * 4
    local iy = math.floor(top)
    canvas.rectangle(x, iy, 11, H - iy, true)
    x = x + 10
  end

  local i
  for i = 1, #pebbles do
    local p = pebbles[i]
    canvas.color = p.color
    canvas.circle(p.x, p.y, p.r, true)
    canvas.color = colors.lightgray
    canvas.circle(p.x - p.r * 0.3, p.y - p.r * 0.3, math.max(1, p.r * 0.3), true)
  end

  -- Air stones: dark little rocks with a bright top, the bubble sources.
  canvas.color = colors.darkgray
  canvas.circle(BUBBLER_X, BUBBLER_Y + 8, 10, true)
  canvas.circle(BUBBLER2_X, BUBBLER_Y + 8, 8, true)
  canvas.color = colors.gray
  canvas.circle(BUBBLER_X - 3, BUBBLER_Y + 4, 4, true)
  canvas.circle(BUBBLER2_X - 2, BUBBLER_Y + 5, 3, true)
end

local function draw_bubbles()
  local i
  for i = 1, #bubbles do
    local b = bubbles[i]
    local ir = math.max(1, math.floor(b.r))
    local x = math.floor(b.x)
    local y = math.floor(b.y)

    canvas.color = colors.aqua
    canvas.alpha = 175
    if ir <= 2 then
      canvas.circle(x, y, ir, true)
    else
      canvas.circle(x, y, ir, false)
    end

    if ir >= 3 then
      canvas.color = colors.white
      canvas.alpha = 220
      canvas.circle(x - math.floor(ir * 0.35), y - math.floor(ir * 0.35),
                    math.max(1, math.floor(ir * 0.28)), true)
    end
  end
  canvas.alpha = 255
end

local function draw_pops()
  local i
  for i = 1, #pops do
    local p = pops[i]
    local t = p.age / 0.4
    local r = p.r + 2 + t * 12
    canvas.color = colors.aqua
    canvas.alpha = math.floor(170 * (1 - t))
    canvas.circle(p.x, p.y, math.floor(r), false)
  end
  canvas.alpha = 255
end

local function draw_hud()
  canvas.color = colors.white
  canvas.alpha = 175
  canvas.text(14, 12, "FISH TANK")
  canvas.alpha = 110
  canvas.text(14, 30, "B bubbles   W water   UP/DOWN strength   ESC quit")
  canvas.alpha = 255
end

function draw()
  canvas.backcolor = colors.darkblue
  canvas.clear()

  draw_water()
  draw_plants()
  draw_corals()
  draw_sand()
  draw_bubbles()
  draw_pops()
  draw_hud()
end

-- ---- update -----------------------------------------------------------
function update(dt)
  if dt <= 0 then dt = 1 / 60 end
  if dt > 0.08 then dt = 0.08 end
  elapsed = elapsed + dt

  if iskeypressed("escape") then exit() end

  if iskeypressed("w") then
    waterOn = not waterOn
    if waterOn then
      shader.load("water.frag")
      shader.value = waterValue
    else
      shader.effect = "none"
    end
  end

  if iskeypressed("b") then
    blow_burst(rnd(40, W - 40), BUBBLER_Y, 12)
  end

  if ismousepressed("left") then
    blow_burst(clamp(mousex(), 16, W - 16),
               clamp(mousey(), 16, H - 16), 7)
  end

  if waterOn then
    if iskeydown("up") then
      waterValue = clamp(waterValue + dt * 0.5, 0.0, 1.0)
      shader.value = waterValue
    elseif iskeydown("down") then
      waterValue = clamp(waterValue - dt * 0.5, 0.0, 1.0)
      shader.value = waterValue
    end
  end

  local i
  for i = 1, #fish do
    update_fish(fish[i], dt)
  end

  update_bubbles(dt)
  update_pops(dt)

  if bubbleSoundCooldown > 0 then
    bubbleSoundCooldown = bubbleSoundCooldown - dt
  end
end
