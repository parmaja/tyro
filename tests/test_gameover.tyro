-- Test game over in mazerogue to verify no nil fields or crashes
local out = openfile("test_gameover_out.txt", "w")

local D = require("mazerogue_data")

-- Simulate the exact explosion insertion and sync
local cam_x = 100
local cam_y = 100
local player = {x = 200, y = 200, hp = 0}
local explosions = {}

-- Insert player death explosion as in mazerogue.tyro
explosions[#explosions + 1] = {
  s = {x = 0, y = 0, visible = true},
  x = player.x,
  y = player.y,
  timer = 0.55,
}

-- Sync explosions
local ok = true
for _, ex in ipairs(explosions) do
  if ex.s and ex.s.visible and ex.x and ex.y then
    ex.s.x = ex.x - cam_x
    ex.s.y = ex.y - cam_y
  else
    ok = false
  end
end

if ok and explosions[1].s.x == 100 and explosions[1].s.y == 100 then
  out:write("PASS game over explosion sync\n")
  print("PASS game over explosion sync")
else
  out:write("FAIL game over explosion sync\n")
  error("FAIL game over explosion sync")
end

out:close()
exit()
exit()
