--======================================================================
--  Zonix Data & Pure Grid Logic for Tyro Game Engine
--======================================================================
--  Exports level configurations, color themes, scoring tables, and
--  pure grid algorithms (flood fill, area claiming, hit testing)
--  so tests/test_zonix_data.tyro can verify them headlessly without
--  booting the graphical engine.
--======================================================================

local M = {}

M.COLS = 88
M.ROWS = 46
M.CELL_SIZE = 10
M.FIELD_X = 40
M.FIELD_Y = 55
M.FIELD_W = M.COLS * M.CELL_SIZE -- 880
M.FIELD_H = M.ROWS * M.CELL_SIZE -- 460

M.STATE_SEA = 0   -- uncaptured void
M.STATE_LAND = 1  -- claimed safe territory
M.STATE_TRAIL = 2 -- active cutting line

-- Inner playable cell count (excluding the 2-cell outer border)
M.INNER_MIN_X = 2
M.INNER_MAX_X = M.COLS - 3
M.INNER_MIN_Y = 2
M.INNER_MAX_Y = M.ROWS - 3
M.INNER_COLS = M.INNER_MAX_X - M.INNER_MIN_X + 1 -- 84
M.INNER_ROWS = M.INNER_MAX_Y - M.INNER_MIN_Y + 1 -- 42
M.TOTAL_INNER_CELLS = M.INNER_COLS * M.INNER_ROWS -- 3528

