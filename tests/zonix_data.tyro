-- Create and initialize an empty grid with initial borders as land
function M.create_grid()
  local g = {}
  for y = 0, M.ROWS - 1 do
    g[y] = {}
    for x = 0, M.COLS - 1 do
      if x < 2 or x >= M.COLS - 2 or y < 2 or y >= M.ROWS - 2 then
        g[y][x] = M.STATE_LAND
      else
        g[y][x] = M.STATE_SEA
      end
    end
  end
  return g
end

-- Convert grid cell coordinates to screen pixel coordinates (top-left of cell)
function M.grid_to_pixel(gx, gy)
  return M.FIELD_X + gx * M.CELL_SIZE, M.FIELD_Y + gy * M.CELL_SIZE
end

-- Convert screen pixel coordinates to grid cell coordinates
function M.pixel_to_grid(px, py)
  local gx = math.floor((px - M.FIELD_X) / M.CELL_SIZE)
  local gy = math.floor((py - M.FIELD_Y) / M.CELL_SIZE)
  return gx, gy
end

-- Count how many inner cells are claimed (STATE_LAND)
function M.count_claimed(grid)
  local count = 0
  for y = M.INNER_MIN_Y, M.INNER_MAX_Y do
    local row = grid[y]
    for x = M.INNER_MIN_X, M.INNER_MAX_X do
      if row[x] == M.STATE_LAND then
        count = count + 1
      end
    end
  end
  return count
end

-- Calculate percentage of claimed inner territory (0.0 .. 100.0)
function M.calc_percentage(grid)
  local count = M.count_claimed(grid)
  return (count / M.TOTAL_INNER_CELLS) * 100.0
end

-- Connected-component flood fill to claim enclosed territory
-- When the player returns to land, all trail cells become land.
-- Then, all connected components of STATE_SEA that DO NOT contain
-- any enemies are converted to STATE_LAND.
-- enemies: list of tables with {x = pixel_x, y = pixel_y}
function M.claim_territory(grid, enemies, trail_list)
  -- 1. Convert all trail cells to land
  if trail_list then
    for _, pt in ipairs(trail_list) do
      if pt.gx >= 0 and pt.gx < M.COLS and pt.gy >= 0 and pt.gy < M.ROWS then
        grid[pt.gy][pt.gx] = M.STATE_LAND
      end
    end
  end

  -- Also sweep any lingering STATE_TRAIL cells
  for y = 0, M.ROWS - 1 do
    for x = 0, M.COLS - 1 do
      if grid[y][x] == M.STATE_TRAIL then
        grid[y][x] = M.STATE_LAND
      end
    end
  end

  -- 2. Build visited table for BFS flood fill
  local visited = {}
  for y = 0, M.ROWS - 1 do
    visited[y] = {}
  end

  -- Queue for BFS
  local qx = {}
  local qy = {}
  local head = 1
  local tail = 0

  local function push(x, y)
    tail = tail + 1
    qx[tail] = x
    qy[tail] = y
    visited[y][x] = true
  end

  -- 3. For every active enemy in the sea, start flood fill from its position
  for _, e in ipairs(enemies) do
    local egx, egy = M.pixel_to_grid(e.x, e.y)
    egx = math.max(0, math.min(M.COLS - 1, egx))
    egy = math.max(0, math.min(M.ROWS - 1, egy))

    -- If enemy is currently inside SEA and unvisited, flood fill that entire region
    if grid[egy][egx] == M.STATE_SEA and not visited[egy][egx] then
      push(egx, egy)
    else
      -- Enemy might be at the edge of a cell; check adjacent 4 neighbors
      for _, off in ipairs({{0, 0}, {1, 0}, {-1, 0}, {0, 1}, {0, -1}}) do
        local nx = egx + off[1]
        local ny = egy + off[2]
        if nx >= 0 and nx < M.COLS and ny >= 0 and ny < M.ROWS then
          if grid[ny][nx] == M.STATE_SEA and not visited[ny][nx] then
            push(nx, ny)
          end
        end
      end
    end
  end

  -- BFS expansion across all reachable sea cells
  while head <= tail do
    local cx = qx[head]
    local cy = qy[head]
    head = head + 1

    -- 4 cardinal neighbors
    if cx + 1 < M.COLS and grid[cy][cx + 1] == M.STATE_SEA and not visited[cy][cx + 1] then
      push(cx + 1, cy)
    end
    if cx - 1 >= 0 and grid[cy][cx - 1] == M.STATE_SEA and not visited[cy][cx - 1] then
      push(cx - 1, cy)
    end
    if cy + 1 < M.ROWS and grid[cy + 1][cx] == M.STATE_SEA and not visited[cy + 1][cx] then
      push(cx, cy + 1)
    end
    if cy - 1 >= 0 and grid[cy - 1][cx] == M.STATE_SEA and not visited[cy - 1][cx] then
      push(cx, cy - 1)
    end
  end

  -- 4. Any STATE_SEA cell that was NOT reached by the flood fill contains no enemies!
  -- Convert all unvisited sea cells to STATE_LAND.
  local newly_claimed = 0
  for y = 0, M.ROWS - 1 do
    local row = grid[y]
    local vrow = visited[y]
    for x = 0, M.COLS - 1 do
      if row[x] == M.STATE_SEA and not vrow[x] then
        row[x] = M.STATE_LAND
        newly_claimed = newly_claimed + 1
      end
    end
  end

  return newly_claimed
end

-- Check if a cell is on the perimeter / border between land and sea
function M.is_border_cell(grid, gx, gy)
  if grid[gy][gx] ~= M.STATE_LAND then
    return false
  end
  -- Check 8 neighbors so corner perimeter cells connect smoothly
  for dy = -1, 1 do
    for dx = -1, 1 do
      if not (dx == 0 and dy == 0) then
        local nx = gx + dx
        local ny = gy + dy
        if nx >= 0 and nx < M.COLS and ny >= 0 and ny < M.ROWS then
          if grid[ny][nx] == M.STATE_SEA then
            return true
          end
        end
      end
    end
  end
  return false
end

-- Find all adjacent border land cells for spark traversal
function M.get_border_neighbors(grid, gx, gy)
  local res = {}
  for _, off in ipairs({{1, 0}, {-1, 0}, {0, 1}, {0, -1}}) do
    local nx = gx + off[1]
    local ny = gy + off[2]
    if nx >= 0 and nx < M.COLS and ny >= 0 and ny < M.ROWS then
      if M.is_border_cell(grid, nx, ny) then
        res[#res + 1] = {gx = nx, gy = ny}
      end
    end
  end
  return res
end

return M
