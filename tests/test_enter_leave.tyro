--======================================================================
--  test_enter_leave.tyro - smoke test for enter() / leave() grouping
--======================================================================
--  Covers:
--    - enter()/leave() run inside a cycle-locked loop without stalling it
--    - a hold kept open across a cycle wait (cycle read as an expression:
--      a bare 'cycle' statement is a Lua syntax error) does not deadlock
--    - nested enters need the same number of leaves
--    - an unbalanced leave() is ignored and does not break the run
--  Writes PASS/FAIL lines plus a final SMOKE-OK / SMOKE-FAILED into
--  test_enter_leave_result.txt next to this script.
--======================================================================

window.show(320, 240)

local out = openfile("test_enter_leave_result.txt", "w")
local fails = 0
local function check(name, cond)
  if cond then
    out:write("PASS ", name, "\n")
  else
    fails = fails + 1
    out:write("FAIL ", name, "\n")
  end
end

local frames = 0
local groups = 0
local held_waits = 0
local ran = false

while cycle do
  frames = frames + 1

  -- group 1: plain enter -> queue -> leave, every frame
  enter()
  canvas.color = colors.red
  canvas.rectangle(10, 10, 100, 50, true)
  canvas.color = colors.green
  canvas.rectangle(10, 70, 100, 50, true)
  canvas.color = colors.blue
  canvas.rectangle(10, 130, 100, 50, true)
  leave()
  groups = groups + 1

  -- group 2: nested enters need two leaves, and the hold stays open across a
  -- cycle wait (assigned to a local: a bare 'cycle' statement cannot parse)
  enter()
  enter()
  canvas.color = colors.yellow
  canvas.rectangle(150, 10, 100, 50, true)
  local ok = cycle
  held_waits = held_waits + 1
  canvas.color = colors.orange
  canvas.rectangle(150, 70, 100, 50, true)
  leave()
  leave()
  groups = groups + 1

  if frames == 20 then
    ran = true
    break
  end
end

check("cycle loop ran 20 frames", ran and frames == 20)
check("40 groups entered (2 per frame)", groups == 40)
check("hold survived 20 cycle waits", held_waits == 20)

-- unbalanced leave(): must be ignored, the next group still works
leave()
enter()
canvas.color = colors.white
canvas.rectangle(150, 130, 100, 50, true)
leave()
check("unbalanced leave ignored", true)

if fails == 0 then
  out:write("SMOKE-OK\n")
else
  out:write("SMOKE-FAILED fails=", fails, "\n")
end
out:close()
