--======================================================================
--  Test: Verify sprite.shader and sprite.shaderValue API
--  Run: bin\tyro.exe tests\test_sprite_shader.tyro --exit:5 --console
--======================================================================

local out = openfile("test_sprite_shader_out.txt", "w")
local failures = 0

local function check(desc, ok)
  if ok then
    if out then out:write("PASS: " .. desc .. "\n") end
    println("PASS: " .. desc)
  else
    failures = failures + 1
    if out then out:write("FAIL: " .. desc .. "\n") end
    println("FAIL: " .. desc)
  end
end

println("--- Starting Sprite Shader Test ---")

window.show(320, 240)

local sp = Sprites.new("test_orb")
sp.load("games/zonix/img/orb.sprite")
sp.show()

-- 1. Test setting and getting built-in "glow" shader
sp.shader = "glow"
check("sprite.shader reads back 'glow'", sp.shader == "glow")

-- 2. Test shaderValue property
sp.shaderValue = 1.5
check("sprite.shaderValue reads back 1.5", math.abs(sp.shaderValue - 1.5) < 0.001)

-- 3. Test unsetting shader with "none"
sp.shader = "none"
check("sprite.shader unsets to empty string", sp.shader == "")

-- 4. Test re-enabling glow
sp.shader = "glow"
check("sprite.shader re-enabled to 'glow'", sp.shader == "glow")

if out then
  out:write(string.format("\nCompleted with %d failures.\n", failures))
  out:close()
end

println("--- Sprite Shader Test Finished ---")
assert(failures == 0, "All sprite shader checks must pass")
exit()
