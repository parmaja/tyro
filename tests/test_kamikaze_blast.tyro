-- Test kamikaze detonation and entity cleanup safety
local out = openfile("test_kamikaze_blast_out.txt", "w")

local D = require("mazerogue_data")

-- Setup mock enemies and props
local enemies = {
  {kind = "kamikaze", x = 100, y = 100, hp = 25, radius = 11, score = 130, damage = 65, explode_radius = 65, dead = false, s = {visible = true}},
  {kind = "scuttler", x = 110, y = 100, hp = 20, radius = 12, score = 100, damage = 14, dead = false, s = {visible = true}},
}
local props = {
  {kind = "barrel", x = 120, y = 100, hp = 10, radius = 12, dead = false, s = {visible = true}},
}
local explosions = {}

-- Simulate kamikaze detonation: mark dead, trigger explosion
local e = enemies[1]
e.dead = true
e.s.visible = false

-- Explode at e.x, e.y
local max_radius = e.explode_radius
local max_dmg = e.damage
for _, other in ipairs(enemies) do
  if not other.dead then
    local d = D.distance(e.x, e.y, other.x, other.y)
    if d < max_radius + other.radius then
      other.hp = other.hp - max_dmg
      if other.hp <= 0 then
        other.dead = true
        other.s.visible = false
      end
    end
  end
end

for _, pr in ipairs(props) do
  if not pr.dead then
    local d = D.distance(e.x, e.y, pr.x, pr.y)
    if d < max_radius + pr.radius then
      pr.hp = pr.hp - max_dmg
      if pr.hp <= 0 then
        pr.dead = true
        pr.s.visible = false
      end
    end
  end
end

-- Safely sweep dead entities
for i = #enemies, 1, -1 do
  if enemies[i].dead then
    table.remove(enemies, i)
  end
end
for i = #props, 1, -1 do
  if props[i].dead then
    table.remove(props, i)
  end
end

if #enemies == 0 and #props == 0 then
  out:write("PASS kamikaze concurrent explosion cleanup\n")
  print("PASS kamikaze concurrent explosion cleanup")
else
  out:write("FAIL kamikaze concurrent explosion cleanup\n")
  error("FAIL kamikaze concurrent explosion cleanup")
end

out:close()
exit()
