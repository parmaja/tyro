--======================================================================
--  Test: Verify Border Spark Movement and Perimeter Pathfinding
--  Run: bin\tyro.exe tests\test_zonix_spark_movement.tyro --exit:5 --console
--======================================================================

local D = require("zonix_data")

local out = openfile("test_zonix_spark_out.txt", "w")
local failures = 0

local function check(desc, ok)
  if ok then
    if out then out:write("PASS: " .. desc .. "\n") end
    println("PASS: " .. desc)
  else
    failures = failures + 1
    if out then out:write("FAIL: " .. desc .. "\n") end
    println("FAIL: " .. desc)
  end
end

println("--- Starting Zonix Spark Movement Test ---")

local grid = D.create_grid()

-- Check border connectivity
check("Corner (1, 1) is border cell", D.is_border_cell(grid, 1, 1))
check("Top edge (2, 1) is border cell", D.is_border_cell(grid, 2, 1))
check("Left edge (1, 2) is border cell", D.is_border_cell(grid, 1, 2))

local nbs = D.get_border_neighbors(grid, 1, 1)
check("Corner (1, 1) has border neighbors", #nbs >= 2)

-- Simulate spark movement for 20 steps
local spk = {
  gx = 1,
  gy = 1,
  target_gx = 2,
  target_gy = 1,
  prev_gx = 1,
  prev_gy = 1,
  progress = 0.0,
  speed = 10.0, -- 10 cells/s
  cw = true,
}

local visited_cells = {}
local dt = 0.1 -- 100ms per frame

for frame = 1, 30 do
  spk.progress = spk.progress + dt * spk.speed
  while spk.progress >= 1.0 do
    spk.progress = spk.progress - 1.0
    local old_gx = spk.gx
    local old_gy = spk.gy
    spk.gx = spk.target_gx
    spk.gy = spk.target_gy
    spk.prev_gx = old_gx
    spk.prev_gy = old_gy

    visited_cells[spk.gx .. "," .. spk.gy] = true

    local c_nbs = D.get_border_neighbors(grid, spk.gx, spk.gy)
    local candidates = {}
    for _, nb in ipairs(c_nbs) do
      if not (nb.gx == old_gx and nb.gy == old_gy) then
        candidates[#candidates + 1] = nb
      end
    end
    if #candidates == 0 then candidates = c_nbs end

    if #candidates > 0 then
      local cdx = spk.gx - old_gx
      local cdy = spk.gy - old_gy
      if cdx == 0 and cdy == 0 then cdx = 1 end

      local chosen = candidates[1]
      if #candidates > 1 then
        local best_score = -999
        for _, cand in ipairs(candidates) do
          local ndx = cand.gx - spk.gx
          local ndy = cand.gy - spk.gy
          local cross = cdx * ndy - cdy * ndx
          local dot = cdx * ndx + cdy * ndy
          local score = dot
          if spk.cw then
            if cross < 0 then score = score + 5
            elseif cross > 0 then score = score - 5 end
          else
            if cross > 0 then score = score + 5
            elseif cross < 0 then score = score - 5 end
          end
          if score > best_score then
            best_score = score
            chosen = cand
          end
        end
      end
      spk.target_gx = chosen.gx
      spk.target_gy = chosen.gy
    end
  end
end

local distinct_count = 0
for _ in pairs(visited_cells) do
  distinct_count = distinct_count + 1
end

println("Distinct cells visited by spark: " .. distinct_count)
check("Spark visited at least 15 distinct border cells", distinct_count >= 15)
check("Spark advanced along X axis", spk.gx > 10)

if out then
  out:write(string.format("\nCompleted with %d failures.\n", failures))
  out:close()
end

println("--- Zonix Spark Movement Test Finished ---")
assert(failures == 0, "All spark tests must pass")
exit()
