--======================================================================
--  test_mazerogue_data.tyro - Pure Rules & Mechanics Verification
--======================================================================
--  Validates maze generation, reachability, gunner recoil knockback,
--  grenade AOE damage falloff, wall collisions, and entity rosters.
--
--  Run: tyro tests/test_mazerogue_data.tyro --exit
--======================================================================

local D = require("mazerogue_data")

failures = 0
out = openfile("test_mazerogue_data_out.txt", "w")

function check(label, ok)
  if ok then
    out:write("PASS  " .. label .. "\n")
  else
    failures = failures + 1
    out:write("FAIL  " .. label .. "\n")
  end
end

check("module loaded successfully", D ~= nil)
if D == nil then
  out:close()
  error("test_mazerogue_data: failed to load module")
end

-- ---- 1. Maze Generation & Reachability --------------------------------
local cols, rows = 35, 35
local maze = D.generate_maze(cols, rows, 42, 6)

check("maze table generated", maze ~= nil)
check("maze dimensions correct", maze.cols == cols and maze.rows == rows)
check("rooms created", #maze.rooms >= 4)
check("start position defined", maze.start_pos ~= nil and maze.start_pos.x > 0 and maze.start_pos.y > 0)
check("exit position defined", maze.exit_pos ~= nil and maze.exit_pos.x > 0 and maze.exit_pos.y > 0)

-- Check that start and exit are on floor tiles
local start_tx = math.floor(maze.start_pos.x / D.TILE_SIZE)
local start_ty = math.floor(maze.start_pos.y / D.TILE_SIZE)
local exit_tx = math.floor(maze.exit_pos.x / D.TILE_SIZE)
local exit_ty = math.floor(maze.exit_pos.y / D.TILE_SIZE)

check("start tile is passable floor", not D.is_solid_tile(maze.grid[start_ty][start_tx]))
check("exit tile is passable floor", not D.is_solid_tile(maze.grid[exit_ty][exit_tx]))

-- Check that a walkable path connects start and exit (BFS reachability)
local connected = D.is_reachable(maze.grid, cols, rows, start_tx, start_ty, exit_tx, exit_ty)
check("path exists from start room to exit room", connected == true)

-- ---- 2. Gunner Shooting & Recoil Knockback --------------------------
-- Recoil must push the gunner backward, directly opposite to the shot direction.
local recoil_force = D.GUN_RECOIL

-- Aiming Right (0 rad): bullet moves +X, player pushed -X
local rx1, ry1 = D.calculate_recoil(0, recoil_force)
check("recoil right: pushes left (vx < 0)", rx1 < -recoil_force * 0.99 and math.abs(ry1) < 0.01)

-- Aiming Left (pi rad): bullet moves -X, player pushed +X
local rx2, ry2 = D.calculate_recoil(math.pi, recoil_force)
check("recoil left: pushes right (vx > 0)", rx2 > recoil_force * 0.99 and math.abs(ry2) < 0.01)

-- Aiming Down (pi/2 rad): bullet moves +Y, player pushed -Y (up)
local rx3, ry3 = D.calculate_recoil(math.pi / 2, recoil_force)
check("recoil down: pushes up (vy < 0)", ry3 < -recoil_force * 0.99 and math.abs(rx3) < 0.01)

-- Aiming Up (-pi/2 rad): bullet moves -Y, player pushed +Y (down)
local rx4, ry4 = D.calculate_recoil(-math.pi / 2, recoil_force)
check("recoil up: pushes down (vy > 0)", ry4 > recoil_force * 0.99 and math.abs(rx4) < 0.01)

-- ---- 3. Grenade Mechanics & AOE Damage -------------------------------
local max_dmg = D.GRENADE_DAMAGE
local radius = D.GRENADE_RADIUS

check("grenade max damage at center", D.calculate_aoe_damage(0, radius, max_dmg) == max_dmg)
check("grenade half damage at midpoint", math.abs(D.calculate_aoe_damage(radius / 2, radius, max_dmg) - (max_dmg / 2)) <= 2)
check("grenade zero damage beyond radius", D.calculate_aoe_damage(radius + 10, radius, max_dmg) == 0)

-- ---- 4. Wall Collision Sliding ---------------------------------------
-- Test a circle in the center of an open floor: should not move
local test_x = maze.start_pos.x
local test_y = maze.start_pos.y
local res_x, res_y = D.resolve_wall_collision(test_x, test_y, 10, maze.grid, cols, rows, D.TILE_SIZE)
check("entity in open space does not drift", math.abs(res_x - test_x) < 0.01 and math.abs(res_y - test_y) < 0.01)

-- Test an entity overlapping a known solid wall (tile 0,0 is solid wall):
local wall_x = D.TILE_SIZE / 2
local wall_y = D.TILE_SIZE / 2
local push_x, push_y = D.resolve_wall_collision(wall_x, wall_y, 12, maze.grid, cols, rows, D.TILE_SIZE)
local final_dist = D.distance(push_x, push_y, wall_x, wall_y)
check("entity inside wall gets pushed out", final_dist > 0.1)

-- ---- 5. Level Spawning & Rosters -------------------------------------
local level_ents = D.spawn_level_entities(maze, 1)
check("enemies spawned on floor 1", #level_ents.enemies >= 4)
check("props (barrels/crates) spawned", #level_ents.props >= 2)
check("pickups spawned", #level_ents.pickups >= 1)

-- Verify enemy stats match roster
local first_enemy = level_ents.enemies[1]
check("enemy has valid hp and speed", first_enemy.hp > 0 and first_enemy.speed > 0)
check("enemy has valid position within maze", first_enemy.x > 0 and first_enemy.x < cols * D.TILE_SIZE)

-- ---- 6. Enemy Line of Sight (LOS) --------------------------------------
-- Within start room: line of sight between center and corner of room is clear
local s_room = maze.start_room
local p1_x = s_room.cx * D.TILE_SIZE + 16
local p1_y = s_room.cy * D.TILE_SIZE + 16
local p2_x = (s_room.x + 1) * D.TILE_SIZE + 16
local p2_y = (s_room.y + 1) * D.TILE_SIZE + 16
local los_clear = D.has_line_of_sight(p1_x, p1_y, p2_x, p2_y, maze.grid, cols, rows, D.TILE_SIZE)
check("line of sight clear within open room", los_clear == true)

-- Behind a solid wall: start room to exit room (separated by walls/corridors)
local los_blocked = D.has_line_of_sight(maze.start_pos.x, maze.start_pos.y, maze.exit_pos.x, maze.exit_pos.y, maze.grid, cols, rows, D.TILE_SIZE)
check("line of sight blocked through walls", los_blocked == false)

-- Test artificial 3x3 grid with wall in middle
local test_grid = {
  [0] = {[0] = D.T_FLOOR_A, [1] = D.T_WALL_TOP, [2] = D.T_FLOOR_A},
  [1] = {[0] = D.T_FLOOR_A, [1] = D.T_WALL_TOP, [2] = D.T_FLOOR_A},
  [2] = {[0] = D.T_FLOOR_A, [1] = D.T_WALL_TOP, [2] = D.T_FLOOR_A},
}
local los_test = D.has_line_of_sight(16, 48, 80, 48, test_grid, 3, 3, 32)
check("LOS blocked by intervening wall tile", los_test == false)

-- ---- 7. Enemy Anti-Overlap Separation ---------------------------------
local test_enemies = {
  {x = 100, y = 100, radius = 12, dead = false},
  {x = 104, y = 100, radius = 12, dead = false},
}
D.separate_enemies(test_enemies)
local sep_dist = D.distance(test_enemies[1].x, test_enemies[1].y, test_enemies[2].x, test_enemies[2].y)
check("overlapping enemies separated to minimum distance", sep_dist >= 23.9)

-- Dead enemies should not be separated or push others
local dead_test = {
  {x = 50, y = 50, radius = 12, dead = true},
  {x = 52, y = 50, radius = 12, dead = false},
}
D.separate_enemies(dead_test)
check("dead enemies are ignored by separation", dead_test[1].x == 50 and dead_test[2].x == 52)

-- ---- 8. Crate Security Key Spawning & Exit Logic ----------------------
local key_crate_count = 0
local total_crates = 0
for _, pr in ipairs(level_ents.props) do
  if pr.kind == "crate" then
    total_crates = total_crates + 1
    if pr.has_key == true then
      key_crate_count = key_crate_count + 1
    end
  end
end
check("at least one crate spawned", total_crates >= 1)
check("exactly one crate hides the security key", key_crate_count == 1)

-- Verify exit level door requirement logic
local can_open_door_without_key = false
local player_has_key = false
if player_has_key then can_open_door_without_key = true end
check("exit door cannot open without key", can_open_door_without_key == false)

local can_open_door_with_key = false
player_has_key = true
if player_has_key then can_open_door_with_key = true end
check("exit door opens when player has key", can_open_door_with_key == true)

-- ---- Summary ---------------------------------------------------------
out:write("\nFailures: " .. failures .. "\n")
out:close()

if failures > 0 then
  error("test_mazerogue_data: " .. failures .. " test(s) failed!")
else
  print("test_mazerogue_data: all tests passed successfully!")
  exit()
end
