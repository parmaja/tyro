--======================================================================
--  test_sprite_actions.tyro - named actions read from a .sprite file
--======================================================================
--  The sprite editor stores named animations (idle, walk, attack, ...) in
--  the .sprite metadata. The engine exposes them to scripts:
--
--    sprite.actions        number of named actions in the file
--    sprite.action()       name of the current action ('' when none)
--    sprite.action(name)   select an action, returns true/false
--    sprite.play(name)     select that action and start it
--    sprite.play(speed)    old behaviour: speed for the current frames
--
--  Sprite methods are called with '.' (the engine passes the sprite table
--  as the first argument itself), the same style as demos\sprites_demo.tyro.
--
--  tests\sprite_actions_sample.sprite has 8 frames and 3 actions:
--    idle   [0,1]     looping
--    walk   [0,1,2,3] looping
--    attack [4,5]     one-shot
--
--  Run:  bin\tyro.exe tests\test_sprite_actions.tyro --exit
--======================================================================

local failures = 0

local function check(name, ok)
  if ok then
    print("PASS: " .. name)
  else
    failures = failures + 1
    print("FAIL: " .. name)
  end
end

local s = Sprites.new("action_test")
s.load("sprite_actions_sample.sprite")

check("all frames are installed", s.frames == 8)
check("file has three named actions", s.actions == 3)
check("no action selected yet", s.action() == "")

check("selecting idle works", s.action("idle"))
check("current action is idle", s.action() == "idle")
check("idle starts on its first frame", s.frame == 0)
check("idle loops", s.looping == true)

check("unknown action is rejected", not s.action("fly"))
check("rejected action keeps idle", s.action() == "idle")

check("selecting attack works", s.action("attack"))
check("attack starts on its own first frame", s.frame == 4)
check("attack is one-shot", s.looping == false)

check("selecting walk works", s.action("walk"))
check("walk loops", s.looping == true)

s.play("attack")
check("play(name) starts the animation", s.playing)
s.stop()
check("stop freezes the animation", not s.playing)

-- A numeric argument keeps the old meaning: a frame rate for the frames.
s.play(12)
check("play(speed) still starts the animation", s.playing)
s.stop()

print(string.format("test_sprite_actions: %d failure(s)", failures))
