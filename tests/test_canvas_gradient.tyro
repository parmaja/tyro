--======================================================================
--  test_canvas_gradient.tyro - canvas.gradient.rectV / canvas.gradient.rectH / canvas.gradient.circle
--======================================================================
--  Covers the gradient fill bindings added to the canvas:
--    canvas.gradient.rectV(x, y, w, h [, startColor, endColor])  top -> bottom
--    canvas.gradient.rectH(x, y, w, h [, startColor, endColor])  left -> right
--    canvas.gradient.circle(x, y, r [, innerColor, outerColor])  radial
--  Colors take the same colors.* values as canvas.color; omitting one keeps
--  the current canvas color for that side.
--  Run:  tyro.exe tests\test_canvas_gradient.tyro --screenshot:1 --exit:3

window.show(320, 240)

local out = openfile("test_canvas_gradient_result.txt", "w")

local function drain()
  while queue.depth > 0 do
    if not cycle then break end
  end
end

local ok = true

canvas.gradient.rectV(10, 10, 100, 60, colors.red, colors.blue)
canvas.gradient.rectH(130, 10, 100, 60, colors.green, colors.yellow)
drain()
out:write("explicit colors queued\n")

canvas.gradient.rectV(10, 90, 100, 40, "white", "black")
drain()
out:write("string colors queued\n")

canvas.color = colors.red
canvas.gradient.rectH(130, 90, 100, 40)
drain()
out:write("default colors queued\n")

canvas.gradient.circle(50, 50, 30, colors.red, colors.yellow)
drain()
out:write("circle gradient queued\n")

out:write("VERDICT => ", ok and "PASS" or "FAIL", "\n")
out:close()

while cycle do
  canvas.color = colors.black
  canvas.rectangle(0, 0, 320, 240, true)
  canvas.color = colors.white
  canvas.text(8, 8, "gradient rectV / rectH / circle")
  canvas.gradient.rectV(10, 30, 90, 80, colors.red, colors.blue)
  canvas.gradient.rectH(110, 30, 90, 80, colors.green, colors.yellow)
  canvas.gradient.rectV(210, 30, 90, 80, colors.white, colors.black)
  canvas.gradient.rectH(10, 130, 290, 80, colors.blue, colors.red)
  canvas.gradient.circle(160, 120, 40, colors.white, colors.black)
end