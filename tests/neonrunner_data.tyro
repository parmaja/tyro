-- High Score File Management
local HI_FILE = "neonrunner.hi"

function M.load_high_score()
  local f = openfile(HI_FILE, "r")
  if not f then return 25000 end
  local line = f:read("l")
  f:close()
  local score = tonumber(line)
  if score and score > 0 then
    return score
  end
  return 25000
end

function M.save_high_score(score)
  local cur = M.load_high_score()
  if score > cur then
    local f = openfile(HI_FILE, "w")
    if f then
      f:write(tostring(score) .. "\n")
      f:close()
    end
    return score
  end
  return cur
end

-- Helper: Clamp
function M.clamp(val, min, max)
  if val < min then return min end
  if val > max then return max end
  return val
end

-- Helper: Smooth Lerp
function M.lerp(a, b, t)
  return a + (b - a) * t
end

-- Helper: Bounding Box AABB Collision Check
function M.check_aabb(x1, y1, w1, h1, x2, y2, w2, h2)
  return x1 < x2 + w2 and
         x1 + w1 > x2 and
         y1 < y2 + h2 and
         y1 + h1 > y2
end

-- Helper: Distance between two points
function M.dist(x1, y1, x2, y2)
  local dx = x2 - x1
  local dy = y2 - y1
  return math.sqrt(dx * dx + dy * dy)
end

return M
