-- Probe 4: replicate slingshot.tyro level, log stability + a scripted launch
window.show(800, 480)
local out = openfile("ab_probe4_out.txt", "w")
if not out then println("no out") exit() end

local GRAVITY = 900
local PIG_R = 18
collision.gravityy = GRAVITY

local boxes = {}
local pigs = {}

local function speed2(ax, ay) return math.sqrt(ax * ax + ay * ay) end
local pigs_alive = 0

local function onPigHit(rec, other, st)
  if rec.popped or st ~= "enter" then return end
  local ps = speed2(rec.s.vx, rec.s.vy)
  local os = 0
  if other ~= nil and other.kind ~= "static" then os = speed2(other.vx, other.vy) end
  if ps + os > 200 then
    rec.popped = true
    rec.s.collide = false
    rec.s.visible = false
    pigs_alive = pigs_alive - 1
    out:write("  POP pig at " .. math.floor(rec.s.x) .. "," .. math.floor(rec.s.y)
      .. " ps=" .. math.floor(ps) .. " os=" .. math.floor(os) .. "\n")
  end
end

local function addBox(tex, x, y, mass)
  local s = Sprites.new()
  s.load(tex)
  s.kind = "dynamic"
  s.collide = true
  s.mass = mass
  s.friction = 0.9
  s.bouncy = 0.05
  s.x = x
  s.y = y
  boxes[#boxes + 1] = {s = s, x = x, y = y}
end

local function addPig(x, y)
  local s = Sprites.new("pig" .. (#pigs + 1))
  s.load("../games/birds/ab_pig.png")
  s.kind = "dynamic"
  s.collide = true
  s.radius = PIG_R
  s.mass = 0.7
  s.friction = 0.7
  s.bouncy = 0.15
  s.x = x
  s.y = y
  local rec = {s = s, x = x, y = y, popped = false}
  s.onCollide = function(other, st) onPigHit(rec, other, st) end
  pigs[#pigs + 1] = rec
end

local ground = Sprites.new("ground")
ground.load("../games/birds/ab_ground.png")
ground.kind = "static"
ground.collide = true
ground.x = 800
ground.y = 440 + 120

addBox("../games/birds/ab_plank.png", 470, 380, 1.0)
addBox("../games/birds/ab_plank.png", 560, 380, 1.0)
addBox("../games/birds/ab_beam.png",  515, 308, 0.8)
addBox("../games/birds/ab_block.png", 515, 276, 1.4)
addBox("../games/birds/ab_plank.png", 650, 380, 1.0)
addBox("../games/birds/ab_plank.png", 750, 380, 1.0)
addBox("../games/birds/ab_beam_long.png", 700, 308, 0.8)

addPig(515, 238)
addPig(515, 422)
addPig(700, 278)

pigs_alive = #pigs

local bird = Sprites.new("bird")
bird.load("../games/birds/ab_bird.png")
bird.kind = "dynamic"
bird.radius = 15
bird.mass = 2.0
bird.friction = 0.6
bird.bouncy = 0.4
bird.collide = false
bird.x = 150
bird.y = 300

local function dump(tag)
  out:write("== " .. tag .. " pigs_alive=" .. pigs_alive .. "\n")
  for i, b in ipairs(boxes) do
    out:write(string.format("  box%d %.0f,%.0f a=%.0f\n", i, b.s.x, b.s.y, b.s.angle))
  end
  for i, p in ipairs(pigs) do
    out:write(string.format("  pig%d %.0f,%.0f popped=%s\n", i, p.s.x, p.s.y, tostring(p.popped)))
  end
end

local frame = 0
local launched = false
while cycle do
  collision.pump()
  if frame == 0 then dump("frame0") end
  if frame == 30 then dump("frame30") end
  if frame == 60 then dump("frame60") end

  -- scripted launch at frame 60: from (70,360) vx=650 vy=-431
  if frame == 60 and not launched then
    launched = true
    bird.collide = true
    bird.x = 70
    bird.y = 360
    bird.vx = 650
    bird.vy = -431
    out:write("  LAUNCH vx=650 vy=-431\n")
  end
  if frame > 60 and frame % 5 == 0 then
    out:write(string.format("  t%d bird %.0f,%.0f v=%.0f\n", frame, bird.x, bird.y,
      speed2(bird.vx, bird.vy)))
  end

  frame = frame + 1
  if frame > 200 then
    dump("frame200")
    out:close()
    exit()
  end
end
