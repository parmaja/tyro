--======================================================================
--  test_queue_lag.tyro - the "black box, then the text" flicker
--======================================================================
--  A "while cycle do" body queues an opaque black header and then some text.
--  The main loop drains the drawing queue on its own thread while the script
--  thread is still building the body. If a frame boundary falls in the middle
--  of a body, the engine draws only what it can see (the black box) and
--  presents it; the text appears a frame later.
--
--  Tyro prevents this by default: automatic per-cycle grouping holds the queue
--  from the moment a 'cycle' body starts until the next yield point (the next
--  'cycle', sleep(), console read()), so the whole body is committed in one
--  drawing cycle. autogroup(false) restores raw streaming for scripts that
--  want progressive drawing.
--
--  Engine counters, read through the 'queue' table:
--    queue.consumed  commands executed since start (grows on every drain)
--    queue.passes    ProcessQueue passes that executed >=1 command
--    queue.deferred  passes stopped at the time budget with more waiting
--    queue.depth     commands waiting right now
--    queue.max       largest backlog seen at the start of a pass
--    queue.holds     open enter() calls
--    queue.group     true while automatic per-cycle grouping is on
--  millis() is the same high-resolution clock the frame budget uses.
--
--  How to catch a split from Lua. A frame boundary can only fall inside the
--  body while the script is busy building it, and at that moment the script is
--  not blocked on 'cycle', so it cannot sample then. It does not need to: right
--  after the body returns, BEFORE the next 'cycle', read queue.consumed again.
--  Any commands the engine executed in between were drained mid-body:
--      before = queue.consumed           (queue is empty here)
--      <queue the body of n commands>
--      mid = queue.consumed - before     (0 < mid < n  ->  a split frame)
--
--  Phase 1 (default): a body that spins 70 ms without yielding spans several
--  frames; automatic grouping keeps it whole, so no split appears.
--  Phase 2: the same body with autogroup(false) - the frame race is back and
--  the black box is drained and drawn alone (mid = 2, the box's two commands).
--  Phase 3: back on by default, wrapped in enter()/leave() for good measure.
--======================================================================

window.show(320, 240)

local out = openfile("test_queue_lag_result.txt", "w")

-- One "radio header" body: an opaque black box, then green text lines. ABusyMS
-- spins without yielding so the body spans a frame boundary (widening the race
-- window deterministically). Returns the number of queued commands.
local function draw_body(aBusyMS)
  local n = 0
  canvas.color = colors.black;  n = n + 1
  canvas.rectangle(0, 0, 320, 120, true); n = n + 1
  if aBusyMS > 0 then
    local t0 = millis()
    while millis() - t0 < aBusyMS do end
  end
  canvas.color = colors.green;  n = n + 1
  for i = 1, 12 do
    canvas.text(8, 8 + (i - 1) * 9, "black-then-text " .. i)
    n = n + 1
  end
  return n
end

-- Wait for the queue to drain completely, so the next body starts from empty.
local function wait_empty()
  while queue.depth > 0 do
    if not cycle then return false end
  end
  return true
end

-- Run ABodies bodies. Returns the number of mid-body splits seen.
local function run_phase(aName, aHold, aBusyMS, aBodies)
  out:write("phase ", aName, " hold=", aHold, " busy=", aBusyMS,
            "ms group=", tostring(queue.group), "\n")
  local splits, nodrain, whole = 0, 0, 0
  local n, maxmid = 0, 0
  for b = 1, aBodies do
    if not wait_empty() then break end
    local before = queue.consumed
    if aHold then enter() end
    n = draw_body(aBusyMS)
    if aHold then leave() end
    -- Sample without waiting: a non-zero delta here was drained mid-body.
    local mid = queue.consumed - before
    if mid > maxmid then maxmid = mid end
    if mid > 0 and mid < n then
      splits = splits + 1
    elseif mid == 0 then
      nodrain = nodrain + 1
    else
      whole = whole + 1
    end
    if not wait_empty() then break end
    out:write("  body ", b, " mid=", mid, " of ", n,
              " depth=", queue.depth, "\n")
  end
  out:write("  summary n=", n, " splits=", splits, " no-drain=", nodrain,
            " whole=", whole, " maxmid=", maxmid, "\n")
  return splits
end

-- 1: automatic grouping on (default). The body is held as one group.
local auto = run_phase("auto-group", false, 70, 10)

-- 2: raw streaming. The frame race splits the body: the box is drawn alone.
autogroup(false)
local raw = run_phase("group-off", false, 70, 10)
autogroup(true)

-- 3: explicit enter()/leave() around the same body (grouping is on again).
local held = run_phase("enter-leave", true, 70, 10)

out:write("engine frames=", queue.frames,
          " deferred=", queue.deferred,
          " maxdepth=", queue.max,
          " holds=", queue.holds,
          " group=", tostring(queue.group),
          " drainms=", queue.drainms, "\n")
out:write("VERDICT splits auto=", auto,
          " group-off=", raw,
          " enter-leave=", held, "\n")
out:close()
exit()
