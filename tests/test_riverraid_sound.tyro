--======================================================================
--  test_riverraid_sound.tyro - sound calls used by games/riverraid
--======================================================================
--  The crash effect is a white-noise burst and the plane engine is a gapless
--  looping drone that is retuned with the throttle:
--    music.noise(ms)          white noise       (crash)
--    music.noise(freq, ms)    pitched noise
--    sound.loopPlay(wave, freq [, volume])      start a gapless loop
--    sound.loopPitch(freq) / sound.loopVolume(v) retune while it plays
--    sound.loopStop()
--  A bad call aborts the script before the result file is written.
--  Run:  tyro.exe tests\test_riverraid_sound.tyro --exit:3
--  Result: tests\test_riverraid_sound_result.txt

window.show(320, 240)

local out = openfile("test_riverraid_sound_result.txt", "w")

-- crash
music.noise(150)
-- one-shot tone and named waveform
music.sound("Saw", 90, 150)
music.sound(440, 120)
-- looping engine drone, retuned and stopped
sound.loopPlay("Engine", 90, 0.30)
sound.loopPitch(120)
sound.loopVolume(0.15)

out:write("noise, sound and loop calls accepted\n")
out:write("VERDICT => PASS\n")
out:close()

-- Let the queued sound commands run, retune the loop over a few frames while
-- it keeps playing (no gap, no phase jump), then stop it.
local t0 = millis()
while millis() - t0 < 600 do
  if not cycle then break end
  sound.loopPitch(90 + (millis() % 200) / 5)
end
sound.loopStop()

while cycle do
  canvas.color = colors.black
  canvas.rectangle(0, 0, 320, 240, true)
  canvas.color = colors.white
  canvas.text(8, 8, "riverraid sound")
end
