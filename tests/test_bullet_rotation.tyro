--======================================================================
--  test_bullet_rotation.tyro - Verify bullet rotation along flight angle
--======================================================================
local out = openfile("test_bullet_rotation_out.txt", "w")

local function check(label, ok)
  if ok then
    out:write("PASS " .. label .. "\n")
  else
    out:write("FAIL " .. label .. "\n")
    error("FAIL " .. label)
  end
end

-- Test angle calculation matching raylib rotation
local function get_bullet_angle(vx, vy)
  return math.deg(math.atan2(vy, vx))
end

-- Shoot Right (vx > 0, vy == 0): 0 deg
local ang_right = get_bullet_angle(500, 0)
check("shoot right: angle is 0", math.abs(ang_right - 0) < 0.01)

-- Shoot Down (vx == 0, vy > 0): 90 deg
local ang_down = get_bullet_angle(0, 500)
check("shoot down: angle is 90", math.abs(ang_down - 90) < 0.01)

-- Shoot Left (vx < 0, vy == 0): 180 deg
local ang_left = get_bullet_angle(-500, 0)
check("shoot left: angle is 180", math.abs(ang_left - 180) < 0.01 or math.abs(ang_left - (-180)) < 0.01)

-- Shoot Up (vx == 0, vy < 0): -90 deg
local ang_up = get_bullet_angle(0, -500)
check("shoot up: angle is -90", math.abs(ang_up - (-90)) < 0.01)

-- Sprite assignment check
window.show(320, 240)
local s = Sprites.new("bullet_rot_test")
s.load("D:/lab/pascal/tyro/games/mazerogue/img/bullet.png")
s.angle = 90
check("sprite reports assigned angle", math.abs(s.angle - 90) < 0.01)

out:write("ALL TESTS PASSED\n")
out:close()
print("test_bullet_rotation: all tests passed successfully!")
exit()
