--======================================================================
--  ZX Spectrum Tape Loader Demo (projects/zx/zx.tyro)
--======================================================================
--  Authentic simulation of the Sinclair ZX Spectrum cassette tape loading
--  mechanism, ROM audio signals, and border stripe effects.
--
--  Technical Specifications Reproduced:
--    * Z80 3.5MHz CPU polling cycle & PAL 50Hz raster beam simulation
--    * Pilot Tone: Red / Cyan alternating horizontal bars (~807 Hz)
--    * Sync Pulses: Microsecond edge detection chirps (~1400-2400 Hz)
--    * Data Blocks: High-frequency Blue / Yellow jitter stripes (~1000-2000 Hz)
--        - Bit '0' pulses (855 T-states, ~3.8 scanlines)
--        - Bit '1' pulses (1710 T-states, ~7.6 scanlines)
--    * Sinclair BASIC boot terminal & "Program: <name>" ROM routines
--    * 3-tier interleaved SCREEN$ memory decoding (6144 pixel bytes + 768 attrs)
--    * Retro Cassette Player Deck HUD with animated spools, tape counter, and VU meter
--
--  Controls:
--    [SPACE] Play / Pause tape
--    [R]     Rewind tape to beginning
--    [F]     Toggle Turbo 4x fast-loading
--    [M]     Mute / Unmute audio screech
--    [UP/DN] Volume adjust (0% - 100%)
--    [B]     Toggle Border Mode (Monitor / Full Screen / Slim)
--    [1-4]   Switch Tape (1: Manic Miner, 2: Jetpac, 3: Chuckie Egg, 4: Knight Lore)
--    [H]     Toggle Help HUD
--    [Q/ESC] Quit
--======================================================================

window.show(800, 600)
-- ---- ZX Spectrum Color Palette (Normal + Bright) ---------------------
local PALETTE = {
  [0] = rgb(0, 0, 0),         -- 0: Black
  [1] = rgb(0, 34, 192),      -- 1: Blue
  [2] = rgb(192, 34, 0),      -- 2: Red
  [3] = rgb(192, 34, 192),    -- 3: Magenta
  [4] = rgb(0, 192, 34),      -- 4: Green
  [5] = rgb(0, 192, 192),     -- 5: Cyan
  [6] = rgb(192, 192, 34),    -- 6: Yellow
  [7] = rgb(205, 205, 205),   -- 7: White
  [8] = rgb(0, 0, 0),         -- 8: Bright Black
  [9] = rgb(0, 48, 255),      -- 9: Bright Blue
  [10]= rgb(255, 48, 0),      -- 10: Bright Red
  [11]= rgb(255, 48, 255),    -- 11: Bright Magenta
  [12]= rgb(0, 255, 48),      -- 12: Bright Green
  [13]= rgb(0, 255, 255),     -- 13: Bright Cyan
  [14]= rgb(255, 255, 48),    -- 14: Bright Yellow
  [15]= rgb(255, 255, 255)    -- 15: Bright White
}

-- ---- Classic Tape Database ------------------------------------------
local TAPES = {
  {
    name = "Manic Miner",
    author = "Matthew Smith (1983)",
    publisher = "Bug-Byte Software",
    headerName = "miner",
    headerBytes = 17,
    dataBytes = 6912,
    leadTime = 3.2,
    screenTheme = "manic"
  },
  {
    name = "Jetpac",
    author = "Tim & Chris Stamper (1983)",
    publisher = "Ultimate Play The Game",
    headerName = "jetpac",
    headerBytes = 17,
    dataBytes = 6912,
    leadTime = 2.8,
    screenTheme = "jetpac"
  },
  {
    name = "Chuckie Egg",
    author = "Nigel Alderton (1983)",
    publisher = "A&F Software",
    headerName = "chuckie",
    headerBytes = 17,
    dataBytes = 6912,
    leadTime = 3.0,
    screenTheme = "chuckie"
  },
  {
    name = "Knight Lore",
    author = "Ultimate Play The Game (1984)",
    publisher = "Sinclair Research / Ultimate",
    headerName = "knightlore",
    headerBytes = 17,
    dataBytes = 6912,
    leadTime = 3.5,
    screenTheme = "knight"
  }
}

local currentTapeIdx = 1
local tape = TAPES[currentTapeIdx]

-- Display Dimensions (ZX Spectrum is 256x192, 2x scale = 512x384)
local SCREEN_W = 512
local SCREEN_H = 384
local SCREEN_X = math.floor((800 - SCREEN_W) / 2) -- 144
local SCREEN_Y = 104                             -- 104 to 488

-- System State
local borderMode = 1     -- 1: Monitor / Surrounded, 2: Full Screen Border, 3: Slim
local isMuted = false
local isPaused = false
local isTurbo = false
local showHelp = true
local volume = 0.18
local audioPlaying = false
local currentAudioFreq = 0
local reelAngle = 0
local vuLevel = 0

-- Simulation Phases (Accurate Sinclair ROM LD-BYTES sequence)
local STATE = {
  PILOT_HEADER = 1,      -- Red/Cyan leader tone ~807 Hz (~3.0s)
  SYNC_HEADER = 2,       -- Sync chirp (~0.04s)
  DATA_HEADER = 3,       -- Blue/Yellow header bytes (~0.45s)
  GAP_HEADER = 4,        -- Inter-block pause / silence (~1.2s)
  PILOT_DATA = 5,        -- Data pilot tone (~1.6s)
  SYNC_DATA = 6,         -- Sync chirp (~0.04s)
  LOADING_DATA = 7,      -- Interleaved SCREEN$ loading (~8.0s)
  LOADED_COMPLETE = 8    -- "0 OK, 0:1" and complete title screen
}

local simState = STATE.PILOT_HEADER
local simTimer = 0
local bytesLoaded = 0
local totalDataBytes = 6912
local stripePhase = 0
local blinkTimer = 0
local tapeCounter = 0

-- Pseudo-random pulse sequence for realistic data stripe jitter (0=short, 1=long)
local DATA_PULSES = {
  4, 8, 4, 4, 8, 8, 4, 8, 8, 4, 4, 8, 4, 8, 4, 8,
  8, 4, 8, 4, 4, 8, 8, 4, 8, 4, 8, 8, 4, 4, 8, 8,
  4, 4, 8, 8, 4, 8, 4, 8, 8, 4, 4, 8, 8, 4, 8, 4,
  8, 8, 4, 8, 4, 4, 8, 8, 4, 8, 8, 4, 4, 8, 4, 8
}

-- In-memory ZX screen buffer (6144 bitmap bytes + 768 attribute bytes)
local zxScreenBytes = {}
local zxAttrs = {}

local function resetScreenBuffer()
  for i = 0, 6143 do zxScreenBytes[i] = 0 end
  for i = 0, 767 do zxAttrs[i] = 56 end -- White paper (7*8), Black ink (0)
end

-- Procedural pixel and attribute generator for iconic ZX Spectrum titles
local function generateGameScreen(theme)
  resetScreenBuffer()

  if theme == "manic" then
    -- Manic Miner: Big bright title, subterranean caverns, Miner Willy sprite
    for x = 0, 31 do
      for y = 0, 3 do zxAttrs[y * 32 + x] = 14 * 8 + 0 end  -- Yellow paper, black ink
      for y = 4, 18 do zxAttrs[y * 32 + x] = 0 * 8 + 14 end -- Black paper, bright yellow ink
      for y = 19, 23 do zxAttrs[y * 32 + x] = 1 * 8 + 15 end-- Blue paper, bright white ink
    end

    for row = 0, 191 do
      local T = math.floor(row / 64)
      local rem = row % 64
      local R = math.floor(rem / 8)
      local L = rem % 8
      for col = 0, 31 do
        local bIdx = T * 2048 + L * 256 + R * 32 + col
        if row >= 16 and row <= 30 and (col >= 4 and col <= 27) then
          if (row + col) % 3 == 0 then zxScreenBytes[bIdx] = 255 end
        elseif row >= 148 and row <= 154 then
          zxScreenBytes[bIdx] = (col % 2 == 0) and 170 or 85
        elseif row >= 180 and row <= 190 then
          zxScreenBytes[bIdx] = 255
        elseif row >= 110 and row <= 144 and col >= 13 and col <= 18 then
          if row < 122 then
            zxScreenBytes[bIdx] = (row % 2 == 0) and 60 or 126
          else
            zxScreenBytes[bIdx] = (row % 3 == 0) and 231 or 129
          end
        end
      end
    end

  elseif theme == "jetpac" then
    -- Jetpac: Deep space starfield, Saturn-V rocket, astronaut with laser
    for x = 0, 31 do
      for y = 0, 22 do zxAttrs[y * 32 + x] = 0 * 8 + 13 end -- Black paper, bright cyan ink
      zxAttrs[23 * 32 + x] = 2 * 8 + 15                     -- Red planetary ground
    end

    for row = 0, 191 do
      local T = math.floor(row / 64)
      local rem = row % 64
      local R = math.floor(rem / 8)
      local L = rem % 8
      for col = 0, 31 do
        local bIdx = T * 2048 + L * 256 + R * 32 + col
        if row < 32 and (col >= 2 and col <= 29) then
          if (row * col) % 5 < 2 then zxScreenBytes[bIdx] = 255 end
        elseif row >= 184 then
          zxScreenBytes[bIdx] = 255
        elseif row >= 76 and row <= 164 and col >= 22 and col <= 25 then
          zxScreenBytes[bIdx] = (col == 22 or col == 25) and 129 or 255
        elseif (row * 37 + col * 91) % 89 == 0 then
          zxScreenBytes[bIdx] = 16
        end
      end
    end

  elseif theme == "chuckie" then
    -- Chuckie Egg: Platform walkways, grain piles, bird cage ladders
    for x = 0, 31 do
      for y = 0, 3 do zxAttrs[y * 32 + x] = 6 * 8 + 0 end   -- Yellow paper, black ink
      for y = 4, 21 do zxAttrs[y * 32 + x] = 1 * 8 + 14 end -- Blue paper, bright yellow ink
      for y = 22, 23 do zxAttrs[y * 32 + x] = 4 * 8 + 15 end-- Green paper, white ink
    end

    for row = 0, 191 do
      local T = math.floor(row / 64)
      local rem = row % 64
      local R = math.floor(rem / 8)
      local L = rem % 8
      for col = 0, 31 do
        local bIdx = T * 2048 + L * 256 + R * 32 + col
        if row >= 12 and row <= 28 and col >= 3 and col <= 28 then
          if (row + col * 2) % 4 == 0 then zxScreenBytes[bIdx] = 255 end
        elseif (row >= 60 and row <= 64) or (row >= 110 and row <= 114) or (row >= 160 and row <= 164) then
          zxScreenBytes[bIdx] = 255
        elseif (col == 8 or col == 24) and row >= 60 and row <= 164 then
          zxScreenBytes[bIdx] = (row % 4 == 0) and 255 or 129
        end
      end
    end

  else -- Knight Lore
    -- Gothic stone battlements & isometric diamond dungeon
    for x = 0, 31 do
      for y = 0, 23 do
        local isBorder = (x == 0 or x == 31 or y == 0 or y == 23)
        zxAttrs[y * 32 + x] = isBorder and (7 * 8 + 0) or (0 * 8 + 15)
      end
    end

    for row = 0, 191 do
      local T = math.floor(row / 64)
      local rem = row % 64
      local R = math.floor(rem / 8)
      local L = rem % 8
      for col = 0, 31 do
        local bIdx = T * 2048 + L * 256 + R * 32 + col
        if row >= 20 and row <= 45 and col >= 4 and col <= 27 then
          if (row + col) % 2 == 0 then zxScreenBytes[bIdx] = 219 end
        elseif (row > 60 and row < 170) then
          local dx = math.abs((col * 8) - 128)
          local dy = math.abs(row - 115)
          if math.abs(dx + dy * 1.5 - 70) < 3 then
            zxScreenBytes[bIdx] = 255
          end
        end
      end
    end
  end
end

-- Initialize first game screen
generateGameScreen(tape.screenTheme)

-- Audio playback helpers
local function setAudioTone(freq)
  if isMuted or isPaused or freq <= 0 then
    if audioPlaying then
      sound.loopStop()
      audioPlaying = false
      currentAudioFreq = 0
      vuLevel = 0
    end
    return
  end

  vuLevel = math.min(1.0, (freq / 2000) * (volume / 0.18))

  if not audioPlaying then
    sound.loopPlay("Square", freq, volume)
    audioPlaying = true
    currentAudioFreq = freq
  elseif math.abs(currentAudioFreq - freq) > 10 then
    sound.loopPitch(freq)
    sound.loopVolume(volume)
    currentAudioFreq = freq
  end
end

local function stopAudio()
  if audioPlaying then
    sound.loopStop()
    audioPlaying = false
    currentAudioFreq = 0
    vuLevel = 0
  end
end

local function startTapeLoad()
  simState = STATE.PILOT_HEADER
  simTimer = 0
  bytesLoaded = 0
  tapeCounter = 0
  setAudioTone(807)
end

startTapeLoad()

-- ---- Frame Update (dt) ----------------------------------------------
function update(dt)
  -- Apply Turbo Multiplier if enabled
  local stepDt = dt * (isTurbo and 4.0 or 1.0)

  -- Keyboard input
  if keyboard.pressed("space") then
    isPaused = not isPaused
    if isPaused then stopAudio() end
  end

  if keyboard.pressed("r") then
    startTapeLoad()
  end

  if keyboard.pressed("f") or keyboard.pressed("t") then
    isTurbo = not isTurbo
  end

  if keyboard.pressed("m") then
    isMuted = not isMuted
    if isMuted then stopAudio() end
  end

  if keyboard.pressed("h") then
    showHelp = not showHelp
  end

  if keyboard.pressed("up") then
    volume = math.min(1.0, volume + 0.05)
    if audioPlaying then sound.loopVolume(volume) end
  end

  if keyboard.pressed("down") then
    volume = math.max(0.0, volume - 0.05)
    if audioPlaying then sound.loopVolume(volume) end
  end

  if keyboard.pressed("b") then
    borderMode = borderMode + 1
    if borderMode > 3 then borderMode = 1 end
  end

  -- Game selector
  for k = 1, 4 do
    if keyboard.pressed(tostring(k)) and currentTapeIdx ~= k then
      currentTapeIdx = k
      tape = TAPES[currentTapeIdx]
      generateGameScreen(tape.screenTheme)
      startTapeLoad()
    end
  end

  if keyboard.pressed("q") or keyboard.pressed("escape") then
    stopAudio()
    exit()
    return
  end

  if isPaused then return end

  -- Timers and animations
  simTimer = simTimer + stepDt
  blinkTimer = (blinkTimer + stepDt * 2) % 1.0
  reelAngle = (reelAngle + stepDt * (isTurbo and 900 or 240)) % 360
  tapeCounter = math.floor(simTimer * 12)

  -- State machine execution
  if simState == STATE.PILOT_HEADER then
    stripePhase = stripePhase + stepDt * 480
    setAudioTone(807)
    if simTimer >= tape.leadTime then
      simState = STATE.SYNC_HEADER
      simTimer = 0
    end

  elseif simState == STATE.SYNC_HEADER then
    stripePhase = stripePhase + stepDt * 960
    setAudioTone(1450)
    if simTimer >= 0.04 then
      simState = STATE.DATA_HEADER
      simTimer = 0
    end

  elseif simState == STATE.DATA_HEADER then
    stripePhase = stripePhase + stepDt * 1800
    local dataFreq = 1600 + math.sin(simTimer * 80) * 450 + (rand(0, 160) - 80)
    setAudioTone(dataFreq)
    if simTimer >= 0.45 then
      simState = STATE.GAP_HEADER
      simTimer = 0
      stopAudio()
    end

  elseif simState == STATE.GAP_HEADER then
    setAudioTone(0)
    if simTimer >= 1.2 then
      simState = STATE.PILOT_DATA
      simTimer = 0
    end

  elseif simState == STATE.PILOT_DATA then
    stripePhase = stripePhase + stepDt * 480
    setAudioTone(807)
    if simTimer >= 1.6 then
      simState = STATE.SYNC_DATA
      simTimer = 0
    end

  elseif simState == STATE.SYNC_DATA then
    stripePhase = stripePhase + stepDt * 960
    setAudioTone(1450)
    if simTimer >= 0.04 then
      simState = STATE.LOADING_DATA
      simTimer = 0
      bytesLoaded = 0
    end

  elseif simState == STATE.LOADING_DATA then
    stripePhase = stripePhase + stepDt * 2100
    local loadRate = 820 -- bytes/second
    bytesLoaded = math.min(totalDataBytes, math.floor(simTimer * loadRate))

    -- Frantic frequency chirping alternating between 0 and 1 bit frequencies
    local chirp = 1350 + (math.sin(simTimer * 140) > 0 and 550 or -350) + rand(0, 100)
    setAudioTone(chirp)

    if bytesLoaded >= totalDataBytes then
      simState = STATE.LOADED_COMPLETE
      simTimer = 0
      stopAudio()
    end

  elseif simState == STATE.LOADED_COMPLETE then
    stopAudio()
  end
end

-- ---- Render Authentic Border Stripes --------------------------------
local function drawPilotStripes(bx, by, bw, bh, color1, color2, stripeH)
  local y = by
  local toggle = (math.floor(stripePhase / stripeH) % 2 == 0)
  while y < by + bh do
    local curH = math.min(stripeH, (by + bh) - y)
    canvas.color = toggle and color1 or color2
    canvas.rectangle(bx, y, bw, curH, true)
    toggle = not toggle
    y = y + curH
  end
end

local function drawDataStripes(bx, by, bw, bh, color1, color2)
  local y = by
  local pIdx = 1
  local pCount = #DATA_PULSES
  local toggle = ((math.floor(stripePhase / 8) % 2) == 0)
  while y < by + bh do
    local curH = DATA_PULSES[pIdx]
    if y + curH > by + bh then curH = (by + bh) - y end
    canvas.color = toggle and color1 or color2
    canvas.rectangle(bx, y, bw, curH, true)
    toggle = not toggle
    y = y + curH
    pIdx = (pIdx % pCount) + 1
  end
end

-- ---- Draw Cassette Spool Wheel --------------------------------------
local function drawSpool(cx, cy, radius, angle, tapeFraction)
  -- Cassette outer rim
  canvas.color = rgb(30, 30, 30)
  canvas.circle(cx, cy, radius + 4, true)
  -- Tape wound around hub
  local tapeRad = 10 + math.floor(tapeFraction * 12)
  canvas.color = rgb(90, 50, 30) -- Brown magnetic tape color
  canvas.circle(cx, cy, tapeRad, true)
  -- White inner hub
  canvas.color = rgb(230, 230, 230)
  canvas.circle(cx, cy, 9, true)
  -- 3 Hub Spokes
  canvas.color = rgb(40, 40, 40)
  for sp = 0, 2 do
    local rad = math.rad(angle + sp * 120)
    local x2 = cx + math.cos(rad) * 8
    local y2 = cy + math.sin(rad) * 8
    canvas.line(cx, cy, x2, y2)
  end
  -- Center spindle hole
  canvas.circle(cx, cy, 3, true)
end

-- ---- Frame Draw () --------------------------------------------------
function draw()
  -- Canvas background clear
  canvas.clear(colors.black)
  canvas.color = colors.white

  -- Border bounds
  local bx = 0
  local by = 50
  local bw = 800
  local bh = 496

  if borderMode == 2 then
    bx = 0; by = 0; bw = 800; bh = 600
  elseif borderMode == 3 then
    bx = 100; by = 74; bw = 600; bh = 444
  end

  -- 1. Draw Border according to current tape state
  local cPilot1 = PALETTE[2]   -- Red
  local cPilot2 = PALETTE[5]   -- Cyan
  local cData1  = PALETTE[1]   -- Blue
  local cData2  = PALETTE[6]   -- Yellow

  if simState == STATE.PILOT_HEADER or simState == STATE.PILOT_DATA then
    drawPilotStripes(bx, by, bw, bh, cPilot1, cPilot2, 14)

  elseif simState == STATE.SYNC_HEADER or simState == STATE.SYNC_DATA then
    drawPilotStripes(bx, by, bw, bh, cPilot1, cPilot2, 6)

  elseif simState == STATE.DATA_HEADER or simState == STATE.LOADING_DATA then
    drawDataStripes(bx, by, bw, bh, cData1, cData2)

  elseif simState == STATE.GAP_HEADER then
    canvas.color = cPilot2
    canvas.rectangle(bx, by, bw, bh, true)

  elseif simState == STATE.LOADED_COMPLETE then
    canvas.color = PALETTE[0]
    canvas.rectangle(bx, by, bw, bh, true)

  else
    canvas.color = PALETTE[7]
    canvas.rectangle(bx, by, bw, bh, true)
  end

  -- 2. Draw ZX Spectrum 256x192 Screen in Center (scaled 2x = 512x384)
  local sx = SCREEN_X
  local sy = SCREEN_Y
  local sw = SCREEN_W
  local sh = SCREEN_H

  if simState < STATE.LOADING_DATA then
    -- Sinclair BASIC Screen
    canvas.color = PALETTE[7]
    canvas.rectangle(sx, sy, sw, sh, true)

    canvas.color = PALETTE[0]
    canvas.text(sx + 16, sy + 16, "1982 Sinclair Research Ltd")
    canvas.text(sx + 16, sy + 40, "Tape: " .. tape.name)

    if simState >= STATE.DATA_HEADER then
      canvas.color = PALETTE[0]
      canvas.text(sx + 16, sy + 80, "Program: " .. tape.headerName)
    end

    if simState >= STATE.GAP_HEADER then
      canvas.text(sx + 16, sy + 104, "Bytes:   " .. tape.headerName)
    end

    -- Blinking inverse cursor
    if blinkTimer < 0.5 then
      canvas.color = PALETTE[0]
      canvas.rectangle(sx + 16, sy + sh - 36, 16, 20, true)
      canvas.color = PALETTE[7]
      canvas.text(sx + 19, sy + sh - 34, "L")
    end

  else
    -- SCREEN$ Active View
    canvas.color = PALETTE[7]
    canvas.rectangle(sx, sy, sw, sh, true)

    local maxBitmapBytes = math.min(bytesLoaded, 6144)

    -- Decoded scanlines in 3-tier interleaved order
    for b = 0, maxBitmapBytes - 1 do
      local byteVal = zxScreenBytes[b]
      if byteVal > 0 then
        local T = math.floor(b / 2048)
        local rem1 = b % 2048
        local L = math.floor(rem1 / 256)
        local rem2 = rem1 % 256
        local R = math.floor(rem2 / 32)
        local C = rem2 % 32

        local rowY = (T * 64 + R * 8 + L)
        local py = sy + rowY * 2
        local px = sx + C * 16

        local charCell = (T * 8 + R) * 32 + C
        local attr = zxAttrs[charCell] or 56
        local inkIdx = attr % 8
        local paperIdx = math.floor(attr / 8) % 8
        local bright = (attr >= 64) and 8 or 0

        if byteVal == 255 then
          canvas.color = PALETTE[inkIdx + bright]
          canvas.rectangle(px, py, 16, 2, true)
        else
          canvas.color = PALETTE[inkIdx + bright]
          for bit = 0, 7 do
            local mask = 2 ^ (7 - bit)
            if (byteVal % (mask * 2)) >= mask then
              canvas.rectangle(px + bit * 2, py, 2, 2, true)
            end
          end
        end
      end
    end

    -- Scanline sweep beam while loading
    if simState == STATE.LOADING_DATA and bytesLoaded < 6144 then
      local curB = bytesLoaded
      local T = math.floor(curB / 2048)
      local rem1 = curB % 2048
      local L = math.floor(rem1 / 256)
      local rem2 = rem1 % 256
      local R = math.floor(rem2 / 32)
      local curY = sy + (T * 64 + R * 8 + L) * 2
      canvas.color = PALETTE[14]
      canvas.rectangle(sx, curY, sw, 2, true)
    end

    -- Flash completion banner
    if simState == STATE.LOADED_COMPLETE and blinkTimer < 0.6 then
      canvas.color = PALETTE[0]
      canvas.rectangle(sx + 16, sy + sh - 28, 160, 20, true)
      canvas.color = PALETTE[7]
      canvas.text(sx + 20, sy + sh - 26, "0 OK, 0:1")
    end
  end

  -- 3. Top Cassette Deck HUD Panel
  canvas.color = rgb(25, 27, 32)
  canvas.rectangle(0, 0, 800, 50, true)
  canvas.color = rgb(60, 65, 75)
  canvas.line(0, 49, 800, 49)

  -- Animated Tape Reels
  local tapeFrac = (simState == STATE.LOADED_COMPLETE and 1.0 or (bytesLoaded / totalDataBytes))
  drawSpool(32, 25, 16, reelAngle, 1.0 - tapeFrac)
  drawSpool(88, 25, 16, reelAngle, tapeFrac)

  -- Tape Deck Transport status
  canvas.color = rgb(220, 220, 220)
  canvas.text(120, 10, "CASSETTE: " .. string.upper(tape.name))

  local stageText = "PILOT TONE (Header)"
  if simState == STATE.PILOT_HEADER then stageText = "PILOT TONE (Red/Cyan ~807 Hz)"
  elseif simState == STATE.SYNC_HEADER then stageText = "SYNC PULSE (Header)"
  elseif simState == STATE.DATA_HEADER then stageText = "HEADER BYTES (Blue/Yellow ~1800 Hz)"
  elseif simState == STATE.GAP_HEADER then stageText = "TAPE GAP (Silence 1.2s)"
  elseif simState == STATE.PILOT_DATA then stageText = "PILOT TONE (Data Block ~807 Hz)"
  elseif simState == STATE.SYNC_DATA then stageText = "SYNC PULSE (Data)"
  elseif simState == STATE.LOADING_DATA then stageText = string.format("LOADING SCREEN$ (%d / 6912 B - %d%%)", bytesLoaded, math.floor(tapeFrac * 100))
  elseif simState == STATE.LOADED_COMPLETE then stageText = "LOADED OK (Tape Stopped)"
  end

  canvas.color = (simState == STATE.LOADED_COMPLETE) and rgb(80, 255, 80) or rgb(255, 210, 0)
  canvas.text(120, 28, stageText)

  -- Mechanical 3-digit Tape Counter
  canvas.color = rgb(15, 15, 18)
  canvas.rectangle(480, 14, 60, 22, true)
  canvas.color = colors.white
  canvas.text(488, 17, string.format("%03d", tapeCounter % 1000))

  -- Audio VU Meter
  canvas.color = rgb(15, 15, 18)
  canvas.rectangle(555, 14, 80, 22, true)
  local vuWidth = math.floor(vuLevel * 76)
  if vuWidth > 0 and not isMuted and not isPaused then
    canvas.color = (vuLevel > 0.7) and rgb(255, 60, 60) or rgb(40, 230, 80)
    canvas.rectangle(557, 16, vuWidth, 18, true)
  end

  -- Mode Badges
  if isTurbo then
    canvas.color = rgb(255, 80, 40)
    canvas.rectangle(645, 14, 64, 22, true)
    canvas.color = colors.white
    canvas.text(652, 17, "TURBO")
  end

  canvas.color = isMuted and rgb(220, 40, 40) or rgb(40, 180, 40)
  canvas.rectangle(715, 14, 72, 22, true)
  canvas.color = colors.white
  canvas.text(722, 17, isMuted and "MUTED" or string.format("VOL %d%%", math.floor(volume * 555)))

  -- 4. Bottom Instructions and Progress Bar
  canvas.color = rgb(20, 22, 26)
  canvas.rectangle(0, 546, 800, 54, true)
  canvas.color = rgb(50, 55, 65)
  canvas.line(0, 546, 800, 546)

  -- Tape Progress Bar
  canvas.color = rgb(35, 38, 45)
  canvas.rectangle(16, 552, 768, 8, true)
  local progW = math.floor(768 * tapeFrac)
  if progW > 0 then
    canvas.color = rgb(0, 190, 240)
    canvas.rectangle(16, 552, progW, 8, true)
  end

  -- Controls Guide
  canvas.color = rgb(190, 190, 190)
  canvas.text(16, 568, "[SPACE] Play/Pause  [R] Rewind  [F] Turbo 4x  [M] Mute  [UP/DN] Volume  [B] Border  [1-4] Tape  [Q] Quit")
end
